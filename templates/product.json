    "custom_liquid_HVBTXD": {
      "type": "custom-liquid",
      "name": "t:names.custom_liquid",
      "settings": {
        "custom_liquid": "{% if product.handle == 'cuno' %}\n<script type=\"application/ld+json\">\n{\n  \"@context\": \"https://schema.org\",\n  \"@type\": \"FAQPage\",\n  \"mainEntity\": [\n    {\n      \"@type\": \"Question\",\n      \"name\": \"What age is CUNO for?\",\n      \"acceptedAnswer\": { \"@type\": \"Answer\", \"text\": \"CUNO is designed for ages 8 and up. Many families play with younger kids too, since the rules are simple and the strategy grows with the player.\" }\n    },\n    {\n      \"@type\": \"Question\",\n      \"name\": \"How many players does CUNO support?\",\n      \"acceptedAnswer\": { \"@type\": \"Answer\", \"text\": \"CUNO is for 2–4 players and plays well at every count, including head-to-head as a two-player game.\" }\n    },\n    {\n      \"@type\": \"Question\",\n      \"name\": \"Can kids and adults play CUNO together?\",\n      \"acceptedAnswer\": { \"@type\": \"Answer\", \"text\": \"Yes. Kids can play by simply matching rings, while adults can plan ahead, block opponents, and set up big scoring plays, so everyone enjoys the same game.\" }\n    },\n    {\n      \"@type\": \"Question\",\n      \"name\": \"Is CUNO like dominoes?\",\n      \"acceptedAnswer\": { \"@type\": \"Answer\", \"text\": \"CUNO will feel familiar to dominoes fans because you match tile edges to connect rings. The difference is that each placement scores points and opens up blocking and combo strategy.\" }\n    },\n    {\n      \"@type\": \"Question\",\n      \"name\": \"Can I make a connection with just a blank side?\",\n      \"acceptedAnswer\": { \"@type\": \"Answer\", \"text\": \"No. All tile placements must create at least one valid ring connection. However, it's allowed to match a blank edge to another blank as long as the tile also makes a complete ring elsewhere on the board.\" }\n    },\n    {\n      \"@type\": \"Question\",\n      \"name\": \"I ran out of point tokens for a ring connection. What should I do?\",\n      \"acceptedAnswer\": { \"@type\": \"Answer\", \"text\": \"If you run out of the correct point tokens, you can stack other tokens that add up to the same value. For example, use a 1 and a 2 token stacked together in place of a 3.\" }\n    },\n    {\n      \"@type\": \"Question\",\n      \"name\": \"Why do I need to remove tiles at the start of the game?\",\n      \"acceptedAnswer\": { \"@type\": \"Answer\", \"text\": \"Removing a number of tiles equal to the number of players minus one ensures that the first player also places the final tile of the game. This balances the number of turns, giving every player an equal chance to make ring matches.\" }\n    }\n  ]\n}\n</script>\n{% endif %}\n\n{% if product.handle == 'going-bananas' %}\n<script type=\"application/ld+json\">\n{\n  \"@context\": \"https://schema.org\",\n  \"@type\": \"FAQPage\",\n  \"mainEntity\": [\n    {\n      \"@type\": \"Question\",\n      \"name\": \"How many people can play Going Bananas!?\",\n      \"acceptedAnswer\": { \"@type\": \"Answer\", \"text\": \"Going Bananas! is for 3–6 players, ages 8 and up. The roles dealt each round change with the player count, and there is always one Monkey.\" }\n    },\n    {\n      \"@type\": \"Question\",\n      \"name\": \"How long does a game of Going Bananas! take?\",\n      \"acceptedAnswer\": { \"@type\": \"Answer\", \"text\": \"Most games take 5–15 minutes. The first player to 5 points (3–4 players) or 3 points (5–6 players) wins, so it's easy to play several games in a row.\" }\n    },\n    {\n      \"@type\": \"Question\",\n      \"name\": \"Is Going Bananas! family-friendly?\",\n      \"acceptedAnswer\": { \"@type\": \"Answer\", \"text\": \"Absolutely! While it features bluffing, the tone is entirely goofy and lighthearted. Rather than teaching kids to lie, it exercises their creativity, acting skills, and deductive reasoning in a fun, safe game night environment.\" }\n    },\n    {\n      \"@type\": \"Question\",\n      \"name\": \"When will my preorder ship?\",\n      \"acceptedAnswer\": { \"@type\": \"Answer\", \"text\": \"Preorders are expected to ship in early December. We'll email you as soon as your order is on its way.\" }\n    },\n    {\n      \"@type\": \"Question\",\n      \"name\": \"What happens if there is a tie at the end of the game?\",\n      \"acceptedAnswer\": { \"@type\": \"Answer\", \"text\": \"All players who are tied at the end of the game will share the victory equally.\" }\n    },\n    {\n      \"@type\": \"Question\",\n      \"name\": \"What can I do to convince the monkey that I am the banana?\",\n      \"acceptedAnswer\": { \"@type\": \"Answer\", \"text\": \"Absolutely anything you can think of, without revealing your card to the monkey of course! Just make sure your act has total a-peel so you don't slip up.\" }\n    }\n  ]\n}\n</script>\n{% endif %}\n\n{% if product.handle == 'mrbls' %}\n<script type=\"application/ld+json\">\n{\n  \"@context\": \"https://schema.org\",\n  \"@type\": \"FAQPage\",\n  \"mainEntity\": [\n    {\n      \"@type\": \"Question\",\n      \"name\": \"How many people can play MRBLS?\",\n      \"acceptedAnswer\": { \"@type\": \"Answer\", \"text\": \"MRBLS is for 1–8 players, ages 8 and up. With 3–5 players, use 7 colors and 4 power-ups. With 6–8 players, use all the cards.\" }\n    },\n    {\n      \"@type\": \"Question\",\n      \"name\": \"How long does a game of MRBLS take?\",\n      \"acceptedAnswer\": { \"@type\": \"Answer\", \"text\": \"A game of MRBLS takes about 20 minutes, and most new players learn the rules in just a few minutes.\" }\n    },\n    {\n      \"@type\": \"Question\",\n      \"name\": \"Is MRBLS cooperative?\",\n      \"acceptedAnswer\": { \"@type\": \"Answer\", \"text\": \"Yes. Everyone plays as one team. You win together by emptying the deck and playing all the cards from your hands, and you lose together if the game row grows past 10 cards at the end of a turn.\" }\n    },\n    {\n      \"@type\": \"Question\",\n      \"name\": \"Can younger kids play MRBLS?\",\n      \"acceptedAnswer\": { \"@type\": \"Answer\", \"text\": \"MRBLS is recommended for ages 8 and up, but many families tell us they've played with kids as young as 5. Start with just 4 colors and no power-ups. Since MRBLS is cooperative and everyone's cards are face up, older players can help younger ones plan their moves without spoiling the fun. Add colors and power-ups as they get the hang of it.\" }\n    },\n    {\n      \"@type\": \"Question\",\n      \"name\": \"What is a triad in MRBLS?\",\n      \"acceptedAnswer\": { \"@type\": \"Answer\", \"text\": \"A triad is 3 matching colors next to each other in the game row. Collecting a triad shrinks the row. If closing the gap creates another triad, that's a combo, and both are removed.\" }\n    },\n    {\n      \"@type\": \"Question\",\n      \"name\": \"What do the power-ups do?\",\n      \"acceptedAnswer\": { \"@type\": \"Answer\", \"text\": \"Lightning and the Magnifying Glass are wild cards that complete a triad with a bonus effect. The Bomb removes two adjacent cards, and the Magnet holds a spot in the row for the next card from the deck.\" }\n    },\n    {\n      \"@type\": \"Question\",\n      \"name\": \"Can I use two wild cards in one triad?\",\n      \"acceptedAnswer\": { \"@type\": \"Answer\", \"text\": \"No. Only one wild card can be used to complete a triad.\" }\n    }\n  ]\n}\n</script>\n{% endif %}\n\n{% if product.handle == 'stack-5' %}\n<script type=\"application/ld+json\">\n{\n  \"@context\": \"https://schema.org\",\n  \"@type\": \"FAQPage\",\n  \"mainEntity\": [\n    {\n      \"@type\": \"Question\",\n      \"name\": \"How many people can play Stack5?\",\n      \"acceptedAnswer\": { \"@type\": \"Answer\", \"text\": \"Stack5 is a two-player game for ages 8 and up. Most games take 10–15 minutes.\" }\n    },\n    {\n      \"@type\": \"Question\",\n      \"name\": \"How do you win Stack5?\",\n      \"acceptedAnswer\": { \"@type\": \"Answer\", \"text\": \"The first player to build a stack of exactly 5 of their own chips wins immediately. Any placement that would make a stack taller than 5 isn't allowed, so timing matters.\" }\n    },\n    {\n      \"@type\": \"Question\",\n      \"name\": \"Is Stack5 like Connect 4?\",\n      \"acceptedAnswer\": { \"@type\": \"Answer\", \"text\": \"Like Connect 4, you only ever place pieces, and it's easy to learn. The difference is that Stack5 is about height, not lines. Each placement automatically merges your nearby stacks and knocks chips off your opponent's, so every move changes the board.\" }\n    },\n    {\n      \"@type\": \"Question\",\n      \"name\": \"Do pieces ever move in Stack5?\",\n      \"acceptedAnswer\": { \"@type\": \"Answer\", \"text\": \"Not by choice. Your only action is placing a chip. When you do, your adjacent stacks move on top of it, and adjacent opponent stacks of 2 or more lose their top chip.\" }\n    },\n    {\n      \"@type\": \"Question\",\n      \"name\": \"Can younger kids play Stack5?\",\n      \"acceptedAnswer\": { \"@type\": \"Answer\", \"text\": \"Stack5 is recommended for ages 8 and up. Because there's only one action per turn, younger kids can often pick it up quickly, especially playing alongside an adult.\" }\n    },\n    {\n      \"@type\": \"Question\",\n      \"name\": \"What comes in the box?\",\n      \"acceptedAnswer\": { \"@type\": \"Answer\", \"text\": \"A 13.75 inch fabric game board with a 6x6 grid, 48 nesting chips (24 for each player), and a rule sheet.\" }\n    },\n    {\n      \"@type\": \"Question\",\n      \"name\": \"When will my preorder ship?\",\n      \"acceptedAnswer\": { \"@type\": \"Answer\", \"text\": \"Preorders are open now. We'll announce the ship date as soon as production is approved. Sign up for our newsletter to get updates.\" }\n    }\n  ]\n}\n</script>\n{% endif %}",
