{%- doc -%}
  Store-wide review score line ("★★★★★ 4.9 from 120 reviews") + optional
  small print. Reads Judge.me's shop totals, falling back to adding up
  product reviews. Pass the section's settings.

  @param {object} s - section.settings with show_rating, rating_text,
    rating_link, rating_override, count_override, small_print
  @param {string} [extra_class]
{%- enddoc -%}
{%- liquid
  assign rating_line = blank
  if s.show_rating
    assign r_avg = s.rating_override | default: shop.metafields.judgeme.all_reviews_rating.value | default: shop.metafields.judgeme.all_reviews_rating
    assign r_count = s.count_override | default: shop.metafields.judgeme.all_reviews_count.value | default: shop.metafields.judgeme.all_reviews_count
    if r_avg == blank or r_count == blank
      assign r_sum = 0.0
      assign r_total = 0
      paginate collections.all.products by 250
        for hp in collections.all.products
          assign r_c = hp.metafields.reviews.rating_count.value | default: 0
          if r_c > 0
            assign r_v = hp.metafields.reviews.rating.value.rating | times: r_c
            assign r_sum = r_sum | plus: r_v
            assign r_total = r_total | plus: r_c
          endif
        endfor
      endpaginate
      if r_total > 0
        assign agg_avg = r_sum | divided_by: r_total
        assign r_count = r_count | default: r_total
        assign r_avg = r_avg | default: agg_avg
      endif
    endif
    if r_avg != blank and r_count != blank
      assign r_avg_num = r_avg | times: 1.0 | round: 1 | append: ''
      assign r_count_fmt = r_count | times: 1 | append: ''
      assign rating_line = s.rating_text | default: '★★★★★ [rating] from [count] reviews' | replace: '[rating]', r_avg_num | replace: '[count]', r_count_fmt
    endif
  endif
-%}
{%- if rating_line != blank or s.small_print != blank -%}
  <p class="sm-hero__small {{ extra_class }}" style="margin: 0; font-weight: 700;">
    {%- if rating_line != blank -%}
      {%- if s.rating_link != blank -%}<a href="{{ s.rating_link }}" style="color: inherit;">{{ rating_line }}</a>{%- else -%}{{ rating_line }}{%- endif -%}
      {%- if s.small_print != blank %} · {% endif -%}
    {%- endif -%}
    {{- s.small_print -}}
  </p>
{%- endif -%}
