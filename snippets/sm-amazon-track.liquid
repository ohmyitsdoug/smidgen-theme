{%- doc -%}
  One click listener for every [data-sm-amazon] link on the page. Sends the
  click to Google Analytics (gtag / GTM dataLayer) and Shopify customer events.
  The event name comes from Theme settings → Smidgen · Amazon.
{%- enddoc -%}
<script>
  (function () {
    if (window.__smAmzTrack) return;
    window.__smAmzTrack = true;
    var EVENT = {{ settings.sm_amazon_event | default: 'amazon_click' | json }};
    document.addEventListener('click', function (e) {
      var el = e.target.closest && e.target.closest('a[data-sm-amazon]');
      if (!el || el.dataset.smAmzBound) return;
      var data = {
        link_url: el.href,
        product_name: el.dataset.product || '',
        product_id: el.dataset.productId || '',
        placement: el.dataset.placement || 'bridge_page'
      };
      try { if (typeof window.gtag === 'function') window.gtag('event', EVENT, data); } catch (err) {}
      try { (window.dataLayer = window.dataLayer || []).push(Object.assign({ event: EVENT }, data)); } catch (err) {}
      try { if (window.Shopify && Shopify.analytics && Shopify.analytics.publish) Shopify.analytics.publish(EVENT, data); } catch (err) {}
    });
  })();
</script>
