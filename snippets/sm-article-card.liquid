{%- doc -%}
  Smidgen item card for blog posts. Same look as the product cards.

  @param {article} article
  @param {string} [image_fit] - 'fit' or 'fill' (default 'fill')
  @param {string} [bg] - background color for the image area
  @param {string} [more_label] - link text, default 'Read more →'
{%- enddoc -%}
{%- liquid
  assign fit = image_fit | default: 'fill'
  assign color = bg | default: '#FFF503'
  assign more = more_label | default: 'Read more →'
  assign excerpt = article.excerpt | default: article.content | strip_html | truncatewords: 22
-%}
<a href="{{ article.url }}" class="sm-card" style="--sm-card-color: {{ color }};">
  <span class="sm-card__media sm-card__media--wide{% if fit == 'fill' %} sm-card__media--fill{% endif %}">
    {%- if article.image -%}
      {{ article.image | image_url: width: 900 | image_tag: alt: '', loading: 'lazy', sizes: '(min-width: 1200px) 360px, (min-width: 600px) 45vw, 90vw', widths: '400, 600, 900' }}
    {%- endif -%}
    {%- if article.tags.first != blank -%}
      <span class="sm-badge">{{ article.tags.first }}</span>
    {%- endif -%}
  </span>
  <span class="sm-card__body">
    <span class="sm-card__title sm-card__title--text">{{ article.title }}</span>
    {%- if excerpt != blank -%}<span class="sm-card__hook">{{ excerpt }}</span>{%- endif -%}
    <span class="sm-card__foot">
      <span style="font-size: 0.875rem;">{{ article.published_at | date: format: 'date' }}</span>
      <span class="sm-card__more" aria-hidden="true">{{ more }}</span>
    </span>
  </span>
</a>
