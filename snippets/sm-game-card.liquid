{%- doc -%}
  Smidgen item card for products (games, merch, bundles). The whole card
  links to the product; no add-to-cart.
  Reads optional product metafields in the `smidgen` namespace:
  card_color, hook, badge, players, play_time, ages, ship_date.
  Tags `preorder` and `coming-soon` change the badge and link label.

  @param {product} product
  @param {string} [image_sizes]
  @param {string} [image_fit] - 'fit' (whole image, default) or 'fill' (crop to fill the card art area)
  @param {string} [bg] - background color for the art area; overrides the game's card_color
  @param {string} [more_label] - link text, default 'View game →'
  @param {string} [soon_label] - link text for coming-soon items, default 'Get notified →'
{%- enddoc -%}
{%- liquid
  assign hide_card = false
  assign ws_only_tag = settings.sm_wholesale_only_tag | default: 'wholesale-only'
  if product.tags contains ws_only_tag
    capture sm_ws
      render 'sm-is-wholesale'
    endcapture
    if sm_ws != 'true'
      assign hide_card = true
    endif
  endif
-%}
{%- unless hide_card -%}
{%- liquid
  assign m = product.metafields.smidgen
  assign mc = product.metafields.custom
  assign f_ages = m.ages.value | default: mc.ages.value
  assign f_players = m.players.value | default: mc.players.value
  assign f_play_time = m.play_time.value | default: mc.play_time.value
  assign f_ship_date = m.ship_date.value | default: mc.ship_date.value
  assign f_card_color = m.card_color.value | default: mc.card_color.value
  assign f_badge = m.badge.value | default: mc.badge.value
  assign f_hook = m.hook.value | default: mc.hook.value
  assign card_color = f_card_color | default: '#753189'
  if bg != blank
    assign card_color = bg
  endif

  capture badge
    render 'sm-status-badge', product: product
  endcapture
  assign badge = badge | strip
  assign more = more_label | default: 'View game →'
  if product.tags contains 'coming-soon'
    assign more = soon_label | default: 'Get notified →'
  endif

  assign hook = f_hook | default: product.metafields.descriptors.subtitle.value
  assign rating = product.metafields.reviews.rating.value
  assign rating_count = product.metafields.reviews.rating_count.value | default: 0
  assign card_alt = product.featured_media.alt
  if card_alt == blank
    assign p_type = product.type | downcase
    if p_type contains 'merch' or p_type contains 'apparel' or p_type contains 'shirt'
      assign card_alt = product.title
    else
      assign card_alt = product.title | append: ' game box'
    endif
  endif
  assign sizes = image_sizes | default: '(min-width: 1200px) 300px, (min-width: 600px) 45vw, 90vw'
-%}
<a href="{{ product.url }}" class="sm-card" style="--sm-card-color: {{ card_color }};">
  <span class="sm-card__media{% if image_fit == 'fill' %} sm-card__media--fill{% endif %}">
    {%- if product.featured_media -%}
      {{
        product.featured_media
        | image_url: width: 800
        | image_tag: alt: card_alt, loading: 'lazy', sizes: sizes, widths: '300, 450, 600, 800'
      }}
    {%- endif -%}
    {%- if badge != blank %}
      <span class="sm-badge" data-status="{{ badge }}">{{ badge }}</span><span class="sm-visually-hidden">: </span>
    {% endif -%}
  </span>
  <span class="sm-card__body">
    <span class="sm-card__title">{{ product.title }}</span>

    {% if hook != blank %}
      <span class="sm-card__hook">{{ hook }}</span>
    {% endif %}
    {% if f_players != blank or f_play_time != blank or f_ages != blank %}
      {%- liquid
        assign spec_sep = false
        assign players_txt = f_players | replace: '-', '–'
        assign players_low = f_players | downcase
        assign time_low = f_play_time | downcase
      -%}
      <span class="sm-chips">
        {%- if f_ages != blank %}
          <span class="sm-chip"><span class="sm-visually-hidden">Ages </span>{{ f_ages }}</span>
          {%- assign spec_sep = true -%}
        {% endif -%}
        {%- if f_players != blank %}
          {% if spec_sep %}<span class="sm-visually-hidden"> · </span>{% endif %}
          <span class="sm-chip">{{ players_txt }}{% unless players_low contains 'player' %}<span class="sm-visually-hidden"> players</span>{% endunless %}</span>
          {%- assign spec_sep = true -%}
        {% endif -%}
        {%- if f_play_time != blank %}
          {% if spec_sep %}<span class="sm-visually-hidden"> · </span>{% endif %}
          <span class="sm-chip">{{ f_play_time }}{% unless time_low contains 'min' or time_low contains 'hour' %}<span class="sm-visually-hidden"> min</span>{% endunless %}</span>
        {% endif -%}
      </span>
    {% endif %}
    {% if rating_count > 0 %}
      <span class="sm-card__rating">
        <span aria-hidden="true">★</span> {{ rating.rating | round: 1 }}<span class="sm-visually-hidden"> out of 5 stars</span>
        · {{ rating_count }}
        {{ rating_count | pluralize: 'review', 'reviews' }}</span
      >
    {% elsif f_ship_date != blank %}
      <span class="sm-card__rating">Ships {{ f_ship_date }}</span>
    {% endif %}
    <span class="sm-card__foot">
      <span class="sm-card__price">
        {%- if product.tags contains 'coming-soon' -%}
          Coming soon
        {%- else -%}
          {{ product.price | money }}
          {%- if product.compare_at_price > product.price -%}
            <s>{{ product.compare_at_price | money }}</s>
          {%- endif -%}
        {%- endif -%}
      </span>
      <span class="sm-card__more" aria-hidden="true">{{ more }}</span>
    </span>
  </span>
</a>
{%- endunless -%}
