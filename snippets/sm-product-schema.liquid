{%- doc -%}
  Product JSON-LD for product pages: name, description, images, brand, SKU,
  GTIN (UPC field), offers for every variant (price, currency, availability,
  URL) and aggregateRating from Judge.me's standard review fields when the
  product has reviews. One block per page (replaces Horizon's structured_data).

  @param {product} product
{%- enddoc -%}
{%- liquid
  assign p = product
  assign brand_name = settings.sm_brand_name | default: 'Smidgen Games'
  assign rating = p.metafields.reviews.rating.value
  assign rating_count = p.metafields.reviews.rating_count.value | default: 0
  assign upc = p.metafields.custom.upc.value | default: p.selected_or_first_available_variant.barcode
  assign desc = p.description | replace: '<br>', ' ' | replace: '</p>', ' ' | replace: '</li>', ' ' | strip_html | replace: '&nbsp;', ' ' | strip_newlines | strip | truncate: 5000
  assign seller = shop.name
  assign valid_until = 'now' | date: '%s' | plus: 31536000 | date: '%Y-%m-%d'
-%}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "Product",
  "@id": {{ request.origin | append: p.url | append: '#product' | json }},
  "name": {{ p.title | json }},
  "url": {{ request.origin | append: p.url | json }},
  {%- if desc != blank %}
  "description": {{ desc | json }},
  {%- endif %}
  {%- capture img_list -%}
    {%- for media in p.media limit: 6 -%}
      {%- if media.preview_image -%}{{ media.preview_image | image_url: width: 1600 | prepend: 'https:' }}|{%- endif -%}
    {%- endfor -%}
  {%- endcapture -%}
  {%- assign imgs = img_list | split: '|' -%}
  {%- if imgs.size > 0 %}
  "image": {{ imgs | json }},
  {%- endif %}
  "brand": { "@type": "Brand", "name": {{ brand_name | json }} },
  {%- if p.selected_or_first_available_variant.sku != blank %}
  "sku": {{ p.selected_or_first_available_variant.sku | json }},
  {%- endif %}
  {%- if upc != blank %}
  "gtin": {{ upc | strip | json }},
  {%- endif %}
  {%- if p.type != blank %}
  "category": {{ p.type | json }},
  {%- endif %}
  {%- if rating != blank and rating_count > 0 %}
  "aggregateRating": {
    "@type": "AggregateRating",
    "ratingValue": {{ rating.rating | json }},
    "bestRating": {{ rating.scale_max | default: 5 | json }},
    "worstRating": {{ rating.scale_min | default: 1 | json }},
    "ratingCount": {{ rating_count | json }},
    "reviewCount": {{ rating_count | json }}
  },
  {%- endif %}
  "offers": [
    {%- for v in p.variants -%}
    {
      "@type": "Offer",
      {%- if v.sku != blank %}"sku": {{ v.sku | json }},{% endif %}
      {%- unless p.has_only_default_variant %}"name": {{ v.title | json }},{% endunless %}
      "url": {{ request.origin | append: v.url | json }},
      "price": {{ v.price | divided_by: 100.0 | json }},
      "priceCurrency": {{ cart.currency.iso_code | json }},
      "priceValidUntil": {{ valid_until | json }},
      "itemCondition": "https://schema.org/NewCondition",
      "availability": "https://schema.org/{% if v.available %}{% if p.tags contains 'preorder' and v.inventory_quantity <= 0 and v.inventory_management == 'shopify' %}PreOrder{% else %}InStock{% endif %}{% else %}OutOfStock{% endif %}",
      "seller": { "@type": "Organization", "name": {{ seller | json }} }
    }{% unless forloop.last %},{% endunless %}
    {%- endfor -%}
  ]
}
</script>
