{%- doc -%}
  Decorative brand shape (from the Smidgen brand squiggles), hidden from
  assistive tech. Accepts the shape numbers (shape-1 … shape-42) and the older
  doodle names, which map to the closest brand shape.

  If the color is too close to the background, a contrasting brand color is
  used instead. Outlines follow Theme settings → Smidgen · Shapes unless
  `outline` is 'on' or 'off'.

  @param {string} shape - shape-N, or squiggle | spiral | zigzag | star | loop-arrow | dot | ring | triangle | plus | tile | none
  @param {string} [color] - fill color
  @param {string} [bg] - background color behind the shape (for the contrast check)
  @param {string} [outline] - 'on' | 'off' | blank (theme default)
  @param {string} [position] - top-left | top-right | bottom-left | bottom-right (ignored when style is set)
  @param {string} [style] - inline style for free placement (used by doodle blocks)
  @param {string} [extra_class] - extra classes
  @param {string} [attrs] - extra attributes, e.g. block.shopify_attributes
{%- enddoc -%}
{%- liquid
  case shape
    when 'squiggle'
      assign sid = 'shape-2'
    when 'spiral'
      assign sid = 'shape-3'
    when 'zigzag'
      assign sid = 'shape-18'
    when 'star'
      assign sid = 'shape-17'
    when 'loop-arrow'
      assign sid = 'shape-16'
    when 'dot'
      assign sid = 'shape-40'
    when 'ring'
      assign sid = 'shape-9'
    when 'triangle'
      assign sid = 'shape-12'
    when 'plus'
      assign sid = 'shape-33'
    when 'tile'
      assign sid = 'shape-37'
    else
      assign sid = shape
  endcase

  assign c = color | default: '#753189'
  if bg != blank
    assign c_b = c | color_brightness
    assign bg_b = bg | color_brightness
    assign diff = c_b | minus: bg_b | abs
    if diff < 40
      comment
        Too close to the background: use the brand color with the most
        contrast, or black/white if no brand color stands out enough.
      endcomment
      assign best = c
      assign best_diff = diff
      assign palette = '#753189,#EA5D00,#20A4F3,#FFF503' | split: ','
      for pc in palette
        assign pd = pc | color_brightness | minus: bg_b | abs
        if pd > best_diff
          assign best = pc
          assign best_diff = pd
        endif
      endfor
      if best_diff < 70
        if bg_b > 128
          assign best = '#000000'
        else
          assign best = '#FFFFFF'
        endif
      endif
      assign c = best
    endif
  endif

  assign show_outline = settings.sm_shape_outline
  if outline == 'on'
    assign show_outline = true
  elsif outline == 'off'
    assign show_outline = false
  endif

  assign pos = position | default: 'top-right'
  if style != blank
    assign cls = 'sm-doodle sm-doodle--free ' | append: extra_class
  else
    assign cls = 'sm-doodle sm-doodle--' | append: pos | append: ' ' | append: extra_class
  endif
-%}
{%- unless shape == blank or shape == 'none' -%}
  {% render 'sm-shape',
    name: sid,
    color: c,
    class: cls,
    style: style,
    attrs: attrs,
    outline: show_outline,
    outline_color: settings.sm_shape_outline_color,
    outline_width: settings.sm_shape_outline_width
  %}
{%- endunless -%}
