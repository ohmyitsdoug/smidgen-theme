{%- doc -%}
  Repeating background made from the Smidgen brand shapes. Sits behind a
  section's content; stays put while the page scrolls unless `scroll` is true.
  In brand-color mode, touching shapes (including across tile edges) never share a color.

  @param {string} bg - section background (used to keep shapes visible)
  @param {string} [mode] - 'single' (one color) or 'brand' (brand colors)
  @param {string} [color] - shape color in single mode (default white)
  @param {number} [opacity] - 0-100, default 35
  @param {number} [size] - tile width in px, default 640
  @param {boolean} [outline] - black outline on the shapes
  @param {boolean} [scroll] - scroll with the page instead of staying fixed
{%- enddoc -%}
{%- liquid
  assign bg_b = bg | default: '#FFFFFF' | color_brightness
  if mode == 'brand'
    assign picked = ''
    assign palette = '#753189,#EA5D00,#20A4F3,#FFF503,#FFFFFF,#000000' | split: ','
    for pc in palette
      assign pd = pc | color_brightness | minus: bg_b | abs
      if pd >= 40
        assign picked = picked | append: pc | append: ','
      endif
    endfor
    assign picked = picked | append: '#000000,#753189,#EA5D00,#20A4F3' | split: ','
    assign c1 = picked[0]
    assign c2 = picked[1]
    assign c3 = picked[2]
    assign c4 = picked[3]
  else
    assign c1 = color | default: '#FFFFFF'
    assign cd = c1 | color_brightness | minus: bg_b | abs
    if cd < 20
      if bg_b > 128
        assign c1 = '#000000'
      else
        assign c1 = '#FFFFFF'
      endif
    endif
    assign c2 = c1
    assign c3 = c1
    assign c4 = c1
  endif
  assign stroke = ''
  if outline
    assign stroke = " stroke='#000' stroke-width='10' stroke-linejoin='round' paint-order='stroke'"
  endif
  assign op = opacity | default: 35 | divided_by: 100.0
  assign tile = size | default: 640
-%}
