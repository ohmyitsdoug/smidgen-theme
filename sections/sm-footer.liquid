{%- liquid
  assign sm_block_count = 0
  for blk in section.blocks
    unless blk.type == 'doodle'
      assign sm_block_count = sm_block_count | plus: 1
    endunless
  endfor
-%}
{%- liquid
  assign s = section.settings
  assign form_id = 'sm-footer-signup-' | append: section.id
-%}
{%- if s.divider_top != 'none' -%}
  {% render 'sm-divider', shape: s.divider_top, from: s.divider_from, to: s.bg %}
{%- endif -%}
<footer class="sm-section sm-footer" style="--sm-bg: {{ s.bg }}; --sm-fg: {{ s.fg }};{% render 'sm-btn-vars', s: s %}">
  {% render 'sm-corner-doodles', section: section %}
  {% render 'sm-doodle-blocks', section: section %}
  <div class="sm-container" style="--sm-pad-top: {{ s.pad_top }}px; --sm-pad-bottom: 28px;">
    <div class="sm-footer__top">
      <div class="sm-footer__brand">
        {%- assign footer_logo = s.logo | default: settings.logo_inverse | default: settings.logo -%}
        {%- if footer_logo != blank -%}
          <a href="{{ routes.root_url }}" aria-label="{{ shop.name }} home">
            {{ footer_logo | image_url: width: 400 | image_tag: alt: shop.name, loading: 'lazy', style: 'width: 100%; max-width: 190px; height: auto;' }}
          </a>
        {%- endif -%}
        {%- if s.blurb != blank -%}<div class="sm-rte" style="font-size: 0.95rem; opacity: 0.9;">{{ s.blurb }}</div>{%- endif -%}

        {%- liquid
  assign show_signup = s.show_signup
  if request.page_type == 'index' and s.hide_signup_home
    assign show_signup = false
  endif
-%}
        {%- if show_signup -%}
          <div style="display: flex; flex-direction: column; gap: 10px;">
            {%- if s.signup_heading != blank -%}
              <h2 class="sm-display" style="font-size: 2rem;">{{ s.signup_heading }}</h2>
            {%- endif -%}
            {%- form 'customer', id: form_id, class: 'sm-inline-form' -%}
              <input type="hidden" name="contact[tags]" value="newsletter">
              <label for="{{ form_id }}-email" class="sm-visually-hidden">Email address</label>
              <input id="{{ form_id }}-email" class="sm-input" type="email" name="contact[email]" autocomplete="email" placeholder="you@email.com" required>
              <button type="submit" class="sm-btn">{{ s.signup_button }}</button>
              {%- if form.posted_successfully? -%}
                <p class="sm-form-message" role="status" style="flex-basis: 100%; margin: 0;">You're in! Watch your inbox.</p>
              {%- endif -%}
            {%- endform -%}
          </div>
        {%- endif -%}

        {%- capture socials -%}
          {%- if s.instagram != blank -%}<a href="{{ s.instagram }}" class="sm-footer__social" rel="me noopener" target="_blank">{% render 'sm-icon', name: 'instagram-logo', size: 22 %}<span class="sm-visually-hidden">Smidgen on Instagram</span></a>{%- endif -%}
          {%- if s.tiktok != blank -%}<a href="{{ s.tiktok }}" class="sm-footer__social" rel="me noopener" target="_blank">{% render 'sm-icon', name: 'tiktok-logo', size: 22 %}<span class="sm-visually-hidden">Smidgen on TikTok</span></a>{%- endif -%}
          {%- if s.youtube != blank -%}<a href="{{ s.youtube }}" class="sm-footer__social" rel="me noopener" target="_blank">{% render 'sm-icon', name: 'youtube-logo', size: 22 %}<span class="sm-visually-hidden">Smidgen on YouTube</span></a>{%- endif -%}
          {%- if s.facebook != blank -%}<a href="{{ s.facebook }}" class="sm-footer__social" rel="me noopener" target="_blank">{% render 'sm-icon', name: 'facebook-logo', size: 22 %}<span class="sm-visually-hidden">Smidgen on Facebook</span></a>{%- endif -%}
          {%- if s.x != blank -%}<a href="{{ s.x }}" class="sm-footer__social" rel="me noopener" target="_blank">{% render 'sm-icon', name: 'x-logo', size: 22 %}<span class="sm-visually-hidden">Smidgen on X</span></a>{%- endif -%}
        {%- endcapture -%}
        {%- if socials != blank -%}
          <div style="display: flex; flex-wrap: wrap; gap: 10px;">{{ socials }}</div>
        {%- endif -%}
      </div>

      {%- if sm_block_count > 0 -%}
        <nav class="sm-footer__card" aria-label="Footer">
          {%- for block in section.blocks -%}{%- if block.type == 'doodle' -%}{%- continue -%}{%- endif -%}
            {%- assign menu = block.settings.menu -%}
            {%- if menu != blank and menu.links.size > 0 -%}
              <div class="sm-footer__col" {{ block.shopify_attributes }}>
                <h2 class="sm-footer__heading">{{ block.settings.heading | default: menu.title }}</h2>
                <ul>
                  {%- for link in menu.links -%}
                    <li><a href="{{ link.url }}" {% if link.current %}aria-current="page"{% endif %}>{{ link.title }}</a></li>
                  {%- endfor -%}
                </ul>
              </div>
            {%- endif -%}
          {%- endfor -%}
        </nav>
      {%- endif -%}
    </div>

    <div class="sm-footer__bottom">
      <span>© {{ 'now' | date: '%Y' }} {{ shop.name }}{% if s.tagline != blank %} · {{ s.tagline }}{% endif %}</span>
      {%- if shop.policies.size > 0 -%}
        <ul class="sm-footer__policies">
          {%- for policy in shop.policies -%}
            <li><a href="{{ policy.url }}">{{ policy.title }}</a></li>
          {%- endfor -%}
        </ul>
      {%- endif -%}
    </div>
  </div>
</footer>

