{%- liquid
  assign s = section.settings
  assign form_id = 'sm-footer-signup-' | append: section.id
-%}
{%- if s.divider_top != 'none' -%}
  {% render 'sm-divider', shape: s.divider_top, from: s.divider_from, to: s.bg %}
{%- endif -%}
<footer class="sm-section sm-footer" style="--sm-bg: {{ s.bg }}; --sm-fg: {{ s.fg }};{% render 'sm-btn-vars', s: s %}">
  <div class="sm-container" style="--sm-pad-top: {{ s.pad_top }}px; --sm-pad-bottom: 28px;">
    <div class="sm-footer__top">
      <div class="sm-footer__brand">
        {%- assign footer_logo = s.logo | default: settings.logo_inverse | default: settings.logo -%}
        {%- if footer_logo != blank -%}
          <a href="{{ routes.root_url }}" aria-label="{{ shop.name }} home">
            {{ footer_logo | image_url: width: 400 | image_tag: alt: shop.name, loading: 'lazy', style: 'width: 100%; max-width: 190px; height: auto;' }}
          </a>
        {%- endif -%}
        {%- if s.blurb != blank -%}<div class="sm-rte" style="font-size: 0.95rem; opacity: 0.9;">{{ s.blurb }}</div>{%- endif -%}

        {%- if s.show_signup -%}
          <div style="display: flex; flex-direction: column; gap: 10px;">
            {%- if s.signup_heading != blank -%}
              <h2 class="sm-display" style="font-size: 2rem;">{{ s.signup_heading }}</h2>
            {%- endif -%}
            {%- form 'customer', id: form_id, class: 'sm-inline-form' -%}
              <input type="hidden" name="contact[tags]" value="newsletter">
              <label for="{{ form_id }}-email" class="sm-visually-hidden">Email address</label>
              <input id="{{ form_id }}-email" class="sm-input" type="email" name="contact[email]" autocomplete="email" placeholder="you@email.com" required>
              <button type="submit" class="sm-btn">{{ s.signup_button }}</button>
              {%- if form.posted_successfully? -%}
                <p class="sm-form-message" role="status" style="flex-basis: 100%; margin: 0;">You're in! Watch your inbox.</p>
              {%- endif -%}
            {%- endform -%}
          </div>
        {%- endif -%}

        {%- capture socials -%}
          {%- if s.instagram != blank -%}<a href="{{ s.instagram }}" aria-label="Instagram" class="sm-footer__social">{% render 'sm-icon', name: 'instagram-logo', size: 22 %}</a>{%- endif -%}
          {%- if s.tiktok != blank -%}<a href="{{ s.tiktok }}" aria-label="TikTok" class="sm-footer__social">{% render 'sm-icon', name: 'tiktok-logo', size: 22 %}</a>{%- endif -%}
          {%- if s.youtube != blank -%}<a href="{{ s.youtube }}" aria-label="YouTube" class="sm-footer__social">{% render 'sm-icon', name: 'youtube-logo', size: 22 %}</a>{%- endif -%}
          {%- if s.facebook != blank -%}<a href="{{ s.facebook }}" aria-label="Facebook" class="sm-footer__social">{% render 'sm-icon', name: 'facebook-logo', size: 22 %}</a>{%- endif -%}
          {%- if s.x != blank -%}<a href="{{ s.x }}" aria-label="X" class="sm-footer__social">{% render 'sm-icon', name: 'x-logo', size: 22 %}</a>{%- endif -%}
        {%- endcapture -%}
        {%- if socials != blank -%}
          <div style="display: flex; flex-wrap: wrap; gap: 10px;">{{ socials }}</div>
        {%- endif -%}
      </div>

      {%- if section.blocks.size > 0 -%}
        <nav class="sm-footer__card" aria-label="Footer">
          {%- for block in section.blocks -%}
            {%- assign menu = block.settings.menu -%}
            {%- if menu != blank and menu.links.size > 0 -%}
              <div class="sm-footer__col" {{ block.shopify_attributes }}>
                <h2 class="sm-footer__heading">{{ block.settings.heading | default: menu.title }}</h2>
                <ul>
                  {%- for link in menu.links -%}
                    <li><a href="{{ link.url }}" {% if link.current %}aria-current="page"{% endif %}>{{ link.title }}</a></li>
                  {%- endfor -%}
                </ul>
              </div>
            {%- endif -%}
          {%- endfor -%}
        </nav>
      {%- endif -%}
    </div>

    <div class="sm-footer__bottom">
      <span>© {{ 'now' | date: '%Y' }} {{ shop.name }}{% if s.tagline != blank %} · {{ s.tagline }}{% endif %}</span>
      {%- if shop.policies.size > 0 -%}
        <ul class="sm-footer__policies">
          {%- for policy in shop.policies -%}
            <li><a href="{{ policy.url }}">{{ policy.title }}</a></li>
          {%- endfor -%}
        </ul>
      {%- endif -%}
    </div>
  </div>
</footer>

{% schema %}
{
  "name": "Smidgen · Footer",
  "tag": "div",
  "class": "sm-footer-section",
  "max_blocks": 4,
  "enabled_on": {
    "groups": [
      "footer"
    ]
  },
  "settings": [
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Logo",
      "info": "Optional. Uses the theme's alternate (white) logo if empty."
    },
    {
      "type": "richtext",
      "id": "blurb",
      "label": "Short description",
      "default": "<p>Award-winning, family-friendly tabletop games that are easy to learn and packed with replayability.</p>"
    },
    {
      "type": "checkbox",
      "id": "show_signup",
      "label": "Show email signup",
      "default": true
    },
    {
      "type": "text",
      "id": "signup_heading",
      "label": "Signup heading",
      "default": "Join the game night crew"
    },
    {
      "type": "text",
      "id": "signup_button",
      "label": "Signup button",
      "default": "Sign up"
    },
    {
      "type": "header",
      "content": "Social links"
    },
    {
      "type": "text",
      "id": "instagram",
      "label": "Instagram",
      "default": "https://instagram.com/playsmidgen"
    },
    {
      "type": "text",
      "id": "tiktok",
      "label": "TikTok",
      "default": "https://www.tiktok.com/@playsmidgen"
    },
    {
      "type": "text",
      "id": "youtube",
      "label": "YouTube",
      "default": "https://www.youtube.com/playsmidgen"
    },
    {
      "type": "text",
      "id": "facebook",
      "label": "Facebook",
      "default": "https://www.facebook.com/playsmidgen"
    },
    {
      "type": "text",
      "id": "x",
      "label": "X",
      "info": "Full web address. Leave empty to hide."
    },
    {
      "type": "text",
      "id": "tagline",
      "label": "Text after copyright",
      "placeholder": "Made just outside Baltimore, MD"
    },
    {
      "type": "header",
      "content": "Buttons"
    },
    {
      "type": "paragraph",
      "content": "Leave empty for the standard purple button and white second button."
    },
    {
      "type": "color",
      "id": "btn_bg",
      "label": "Button color"
    },
    {
      "type": "color",
      "id": "btn_fg",
      "label": "Button text"
    },
    {
      "type": "color",
      "id": "btn2_bg",
      "label": "Second button color"
    },
    {
      "type": "color",
      "id": "btn2_fg",
      "label": "Second button text"
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "bg",
      "label": "Background",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "fg",
      "label": "Text",
      "default": "#FFFFFF"
    },
    {
      "type": "select",
      "id": "divider_top",
      "label": "Divider above",
      "options": [
        {
          "value": "none",
          "label": "None"
        },
        {
          "value": "wave",
          "label": "Wave"
        },
        {
          "value": "zigzag",
          "label": "Zigzag"
        },
        {
          "value": "scallop",
          "label": "Scallop"
        }
      ],
      "default": "none"
    },
    {
      "type": "color",
      "id": "divider_from",
      "label": "Color above the footer",
      "default": "#FFFFFF",
      "visible_if": "{{ section.settings.divider_top != 'none' }}"
    },
    {
      "type": "range",
      "id": "pad_top",
      "label": "Top padding",
      "min": 0,
      "max": 120,
      "step": 8,
      "unit": "px",
      "default": 64
    }
  ],
  "blocks": [
    {
      "type": "menu",
      "name": "Menu column",
      "settings": [
        {
          "type": "link_list",
          "id": "menu",
          "label": "Menu"
        },
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "info": "Leave empty to use the menu's name."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Smidgen · Footer",
      "blocks": [
        {
          "type": "menu",
          "settings": {
            "menu": "footer",
            "heading": "Smidgen"
          }
        },
        {
          "type": "menu",
          "settings": {
            "menu": "main-menu",
            "heading": "Shop"
          }
        }
      ]
    }
  ]
}
{% endschema %}
