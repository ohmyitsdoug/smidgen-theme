{%- assign s = section.settings -%}
{%- if s.heading != blank or s.text != blank -%}
  <section class="sm-section" style="--sm-bg: {{ s.section_bg }}; --sm-fg: #000;">
    <div class="sm-container sm-container--narrow" style="--sm-pad-top: {{ s.pad_top }}px; --sm-pad-bottom: {{ s.pad_bottom }}px;">
      {%- capture inner -%}
        {%- if s.icon_image != blank -%}
          <span style="flex: 0 0 auto; display: flex;" aria-hidden="true">
            {{ s.icon_image | image_url: width: 160 | image_tag: alt: '', width: 64, height: 64, loading: 'lazy', style: 'width: 64px; height: 64px; object-fit: contain;' }}
          </span>
        {%- elsif s.icon_name != blank and s.icon_name != 'none' -%}
          <span style="flex: 0 0 auto; width: 68px; height: 68px; display: flex; align-items: center; justify-content: center; background: {{ s.icon_color }}; color: {{ s.icon_fg }}; border: var(--sm-outline); border-radius: 50%;" aria-hidden="true">
            {% render 'sm-icon', name: s.icon_name, size: 36 %}
          </span>
        {%- elsif s.icon != 'none' -%}
          <span style="flex: 0 0 auto; display: flex;" aria-hidden="true">
            {%- case s.icon -%}
              {%- when 'star' -%}
                <svg width="64" height="64" viewBox="0 0 100 100" focusable="false"><path d="M50 4 L60 36 L94 30 L68 52 L88 82 L56 70 L44 96 L38 64 L6 70 L28 46 L8 20 L40 30 Z" fill="{{ s.icon_color }}" stroke="#000" stroke-width="5" stroke-linejoin="round"/></svg>
              {%- when 'spiral' -%}
                <svg width="64" height="64" viewBox="0 0 110 110" fill="none" focusable="false"><path d="M55 55 m-8 0 a8 8 0 1 1 16 0 a18 18 0 1 1 -36 0 a28 28 0 1 1 56 0" stroke="{{ s.icon_color }}" stroke-width="12" stroke-linecap="round"/></svg>
              {%- when 'circle' -%}
                <svg width="64" height="64" viewBox="0 0 64 64" focusable="false"><circle cx="32" cy="32" r="28" fill="{{ s.icon_color }}" stroke="#000" stroke-width="4"/></svg>
            {%- endcase -%}
          </span>
        {%- endif -%}
        <span style="flex: 1 1 280px; display: flex; flex-direction: column; gap: 4px;">
          {%- if s.heading != blank -%}
            <strong style="font-family: var(--sm-font-display); font-weight: 900; font-size: 1.9rem; line-height: 1.05;">{{ s.heading }}</strong>
          {%- endif -%}
          {%- if s.text != blank -%}
            <span style="font-size: 1rem; line-height: 1.5;">{{ s.text }}</span>
          {%- endif -%}
        </span>
        {%- if s.link_label != blank -%}
          <span style="color: var(--sm-purple); font-weight: 700;">{{ s.link_label }}</span>
        {%- endif -%}
      {%- endcapture -%}

      {%- assign box_style = 'display: flex; flex-wrap: wrap; align-items: center; gap: 18px; background: ' | append: s.box_bg | append: '; color: #000; border: var(--sm-outline); border-radius: var(--sm-radius); padding: 24px; text-decoration: none;' -%}
      {%- if s.link != blank -%}
        <a href="{{ s.link }}" class="sm-card" style="{{ box_style }} flex-direction: row;">{{ inner }}</a>
      {%- else -%}
        <div class="sm-box" style="{{ box_style }}">{{ inner }}</div>
      {%- endif -%}
    </div>
  </section>
{%- endif -%}

