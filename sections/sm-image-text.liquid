{%- liquid
  assign s = section.settings
  assign body = s.text
  if s.use_page_content and page.content != blank
    assign body = page.content
  endif
-%}
{%- if s.heading != blank or body != blank or s.image != blank -%}
  <section
    id="sm-{{ section.id }}"
    class="sm-section{% assign fg_b = s.fg | color_brightness %}{% if fg_b > 150 %} sm-on-dark{% endif %}"
    style="--sm-bg: {{ s.bg }}; --sm-fg: {{ s.fg }};"
    {% if s.heading != blank %}aria-labelledby="sm-{{ section.id }}-title"{% endif %}
  >
    {% render 'sm-doodle', shape: s.doodle, color: s.doodle_color, position: 'top-right' %}
    <div class="sm-container" style="--sm-pad-top: {{ s.pad_top }}px; --sm-pad-bottom: {{ s.pad_bottom }}px;">
      <div class="sm-split" {% if s.image_side == 'right' %}style="flex-direction: row-reverse;"{% endif %}>
        {%- if s.image != blank -%}
          <div style="position: relative; display: flex; justify-content: center;">
            {%- if s.image_style == 'framed' -%}
              {{ s.image | image_url: width: 1000 | image_tag: alt: s.image.alt, loading: 'lazy', sizes: '(min-width: 900px) 520px, 90vw', style: 'width: 100%; max-width: 520px; height: auto; border: var(--sm-outline); border-radius: 30px; box-shadow: var(--sm-shadow-lg); transform: rotate(-2deg);' }}
            {%- else -%}
              {{ s.image | image_url: width: 1000 | image_tag: alt: s.image.alt, loading: 'lazy', sizes: '(min-width: 900px) 440px, 90vw', style: 'width: 100%; max-width: 440px; height: auto; transform: rotate(-2deg);' }}
            {%- endif -%}
            {%- if s.note != blank -%}
              <span class="sm-hero__note" style="left: 0; bottom: 8px;">{{ s.note }}</span>
            {%- endif -%}
          </div>
        {%- endif -%}
        <div style="display: flex; flex-direction: column; align-items: flex-start; gap: 18px;">
          {%- if s.eyebrow != blank -%}<span class="sm-badge">{{ s.eyebrow }}</span>{%- endif -%}
          {%- if s.heading != blank -%}
            <h2 id="sm-{{ section.id }}-title" class="sm-display">{{ s.heading }}</h2>
          {%- endif -%}
          {%- if body != blank -%}
            <div class="sm-rte">{{ body }}</div>
          {%- endif -%}
          {%- if s.button_label != blank -%}
            <a class="sm-btn{% if s.button_style == 'secondary' %} sm-btn--secondary{% endif %}" href="{{ s.button_link | default: '#' }}">{{ s.button_label }}</a>
          {%- endif -%}
        </div>
      </div>
    </div>
  </section>
  {%- if s.divider != 'none' -%}
    {% render 'sm-divider', shape: s.divider, from: s.bg, to: s.divider_to %}
  {%- endif -%}
{%- endif -%}

{% schema %}
{
  "name": "Smidgen · Image + text",
  "tag": "div",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Image" },
    {
      "type": "select", "id": "image_style", "label": "Image style",
      "options": [{ "value": "framed", "label": "Outlined frame" }, { "value": "cutout", "label": "Cut-out (no frame)" }],
      "default": "cutout"
    },
    {
      "type": "select", "id": "image_side", "label": "Image side",
      "options": [{ "value": "left", "label": "Left" }, { "value": "right", "label": "Right" }],
      "default": "left"
    },
    { "type": "text", "id": "note", "label": "Hand-written note on image" },
    { "type": "text", "id": "eyebrow", "label": "Badge" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "How it started" },
    { "type": "checkbox", "id": "use_page_content", "label": "Use the page's own content", "info": "Shows the text you wrote in Online Store → Pages. Falls back to the text below.", "default": false },
    { "type": "richtext", "id": "text", "label": "Text" },
    { "type": "text", "id": "button_label", "label": "Button label" },
    { "type": "url", "id": "button_link", "label": "Button link" },
    {
      "type": "select", "id": "button_style", "label": "Button style",
      "options": [{ "value": "primary", "label": "Purple" }, { "value": "secondary", "label": "White" }],
      "default": "primary"
    },
    {
      "type": "select", "id": "doodle", "label": "Doodle",
      "options": [
        { "value": "none", "label": "None" }, { "value": "squiggle", "label": "Squiggle" },
        { "value": "spiral", "label": "Spiral" }, { "value": "zigzag", "label": "Zigzag" },
        { "value": "star", "label": "Star" }
      ],
      "default": "none"
    },
    { "type": "color", "id": "doodle_color", "label": "Doodle color", "default": "#EA5D00" },
    { "type": "header", "content": "Colors" },
    { "type": "color", "id": "bg", "label": "Background", "default": "#FFFFFF" },
    { "type": "color", "id": "fg", "label": "Text", "default": "#000000" },
    { "type": "header", "content": "Divider below" },
    {
      "type": "select", "id": "divider", "label": "Shape",
      "options": [
        { "value": "none", "label": "None" }, { "value": "wave", "label": "Wave" },
        { "value": "zigzag", "label": "Zigzag" }, { "value": "scallop", "label": "Scallop" },
        { "value": "straight", "label": "Straight line" }
      ],
      "default": "none"
    },
    { "type": "color", "id": "divider_to", "label": "Next section color", "default": "#FFF503", "visible_if": "{{ section.settings.divider != 'none' }}" },
    { "type": "header", "content": "Spacing" },
    { "type": "range", "id": "pad_top", "label": "Top padding", "min": 0, "max": 120, "step": 8, "unit": "px", "default": 48 },
    { "type": "range", "id": "pad_bottom", "label": "Bottom padding", "min": 0, "max": 120, "step": 8, "unit": "px", "default": 88 }
  ],
  "presets": [{ "name": "Smidgen · Image + text" }]
}
{% endschema %}
