{%- liquid
  assign sm_block_count = 0
  for blk in section.blocks
    unless blk.type == 'doodle'
      assign sm_block_count = sm_block_count | plus: 1
    endunless
  endfor
-%}
{%- assign s = section.settings -%}
<section
  id="sm-{{ section.id }}"
  class="sm-section"
  style="--sm-bg: {{ s.bg }}; --sm-fg: {{ s.fg }};"
  aria-labelledby="sm-{{ section.id }}-title"
>
  {% render 'sm-corner-doodles', section: section %}
  {% render 'sm-doodle-blocks', section: section %}
  <div class="sm-container" style="--sm-pad-top: {{ s.pad_top }}px; --sm-pad-bottom: {{ s.pad_bottom }}px;">
    <{{ section.settings.heading_tag | default: 'h1' }} id="sm-{{ section.id }}-title" class="sm-display sm-display--xl">{{ s.heading | default: page.title }}</{{ section.settings.heading_tag | default: 'h1' }}>
    {%- if s.text != blank -%}<div class="sm-lede">{{ s.text }}</div>{%- endif -%}
    {%- if sm_block_count > 0 -%}
      <ul class="sm-grid" style="--sm-min: 220px; margin: 0; padding: 0; list-style: none; gap: 20px;">
        {%- for block in section.blocks -%}{%- if block.type == 'doodle' -%}{%- continue -%}{%- endif -%}
          {%- if block.settings.label != blank -%}
            <li {{ block.shopify_attributes }}>
              <a class="sm-link-card" href="{{ block.settings.link | default: '#' }}">
                <span class="sm-link-card__icon" style="background: {{ block.settings.color }}; color: {{ block.settings.icon_color }};" aria-hidden="true">
                  {%- if block.settings.icon_image != blank -%}
                    {{ block.settings.icon_image | image_url: width: 96 | image_tag: alt: '', width: 30, height: 30, loading: 'lazy', style: 'width: 30px; height: 30px; object-fit: contain;' }}
                  {%- elsif block.settings.icon_name != blank and block.settings.icon_name != 'none' -%}
                    {% render 'sm-icon', name: block.settings.icon_name, size: 28 %}
                  {%- else -%}
                    {{- block.settings.icon -}}
                  {%- endif -%}
                </span>
                {{ block.settings.label }}
              </a>
            </li>
          {%- endif -%}
        {%- endfor -%}
      </ul>
    {%- endif -%}
  </div>
</section>
{%- if s.divider != 'none' -%}
  {% render 'sm-divider', shape: s.divider, from: s.bg, to: s.divider_to %}
{%- endif -%}

