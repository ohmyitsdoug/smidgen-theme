{%- assign s = section.settings -%}
<section
  id="sm-{{ section.id }}"
  class="sm-section"
  style="--sm-bg: {{ s.bg }}; --sm-fg: {{ s.fg }};"
  aria-labelledby="sm-{{ section.id }}-title"
>
  {% render 'sm-doodle', shape: 'spiral', color: '#FFF503', position: 'top-right' %}
  <div class="sm-container" style="--sm-pad-top: {{ s.pad_top }}px; --sm-pad-bottom: {{ s.pad_bottom }}px;">
    <h1 id="sm-{{ section.id }}-title" class="sm-display sm-display--xl">{{ s.heading | default: page.title }}</h1>
    {%- if s.text != blank -%}<div class="sm-lede">{{ s.text }}</div>{%- endif -%}
    {%- if section.blocks.size > 0 -%}
      <ul class="sm-grid" style="--sm-min: 220px; margin: 0; padding: 0; list-style: none; gap: 20px;">
        {%- for block in section.blocks -%}
          {%- if block.settings.label != blank -%}
            <li {{ block.shopify_attributes }}>
              <a class="sm-link-card" href="{{ block.settings.link | default: '#' }}">
                <span class="sm-link-card__icon" style="background: {{ block.settings.color }}; color: {{ block.settings.icon_color }};" aria-hidden="true">
                  {{- block.settings.icon -}}
                </span>
                {{ block.settings.label }}
              </a>
            </li>
          {%- endif -%}
        {%- endfor -%}
      </ul>
    {%- endif -%}
  </div>
</section>
{%- if s.divider != 'none' -%}
  {% render 'sm-divider', shape: s.divider, from: s.bg, to: s.divider_to %}
{%- endif -%}

{% schema %}
{
  "name": "Smidgen · Page header + links",
  "tag": "div",
  "max_blocks": 8,
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "info": "Leave empty to use the page title.", "default": "How can we help?" },
    { "type": "richtext", "id": "text", "label": "Text" },
    { "type": "header", "content": "Colors" },
    { "type": "color", "id": "bg", "label": "Background", "default": "#20A4F3" },
    { "type": "color", "id": "fg", "label": "Text", "default": "#000000" },
    { "type": "header", "content": "Divider below" },
    {
      "type": "select", "id": "divider", "label": "Shape",
      "options": [
        { "value": "none", "label": "None" }, { "value": "wave", "label": "Wave" },
        { "value": "zigzag", "label": "Zigzag" }, { "value": "scallop", "label": "Scallop" }
      ],
      "default": "wave"
    },
    { "type": "color", "id": "divider_to", "label": "Next section color", "default": "#FFFFFF", "visible_if": "{{ section.settings.divider != 'none' }}" },
    { "type": "header", "content": "Spacing" },
    { "type": "range", "id": "pad_top", "label": "Top padding", "min": 0, "max": 120, "step": 8, "unit": "px", "default": 64 },
    { "type": "range", "id": "pad_bottom", "label": "Bottom padding", "min": 0, "max": 120, "step": 8, "unit": "px", "default": 32 }
  ],
  "blocks": [
    {
      "type": "link",
      "name": "Link card",
      "settings": [
        { "type": "text", "id": "label", "label": "Label" },
        { "type": "url", "id": "link", "label": "Link", "info": "Use #faq, #contact or #pitch to jump down this page." },
        { "type": "text", "id": "icon", "label": "Icon text", "info": "A short symbol, e.g. ? or ✉" },
        { "type": "color", "id": "color", "label": "Icon color", "default": "#FFF503" },
        { "type": "color", "id": "icon_color", "label": "Icon text color", "default": "#000000" }
      ]
    }
  ],
  "presets": [{ "name": "Smidgen · Page header + links" }]
}
{% endschema %}
