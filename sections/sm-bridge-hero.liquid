{%- comment -%}
  Bridge page hero: award sticker, game title, tagline, box on a big circle,
  spec tiles, the Amazon button and the review rating (labelled with where the
  reviews come from). Everything defaults to the product's own fields.
{%- endcomment -%}
{%- liquid
  assign s = section.settings
  assign p = product
  assign m = p.metafields.smidgen
  assign mc = p.metafields.custom
  assign award = s.eyebrow | default: m.award.value | default: mc.award.value
  assign title = s.title | default: p.title
  assign tagline = s.tagline | default: m.tagline.value | default: mc.tagline.value | default: mc.subtitle.value
  assign f_ages = m.ages.value | default: mc.ages.value
  assign f_players = m.players.value | default: mc.players.value
  assign f_time = m.play_time.value | default: mc.play_time.value
  capture amz
    render 'sm-amazon-url', product: p, link: s.amazon_link
  endcapture
  assign amz = amz | strip
  assign rating = p.metafields.reviews.rating.value
  assign rating_count = p.metafields.reviews.rating_count.value | default: 0
  assign img_key = s.image_field | default: 'custom.amazon_bridge_image' | strip | split: '.'
  assign img = blank
  if img_key.size == 2
    assign img = p.metafields[img_key[0]][img_key[1]].value
  endif
  assign img = img | default: s.image | default: p.featured_image
  assign has_specs = false
  if f_ages != blank or f_players != blank or f_time != blank
    assign has_specs = true
  endif
  assign btn_label = s.button_label | replace: '[title]', p.title
-%}
<section class="sm-section sm-bhero" style="--sm-bg: {{ s.bg }}; --sm-fg: {{ s.fg }}; --sm-bhero-circle: {{ s.circle_color }}; --sm-bhero-band: {{ s.band_color }};">
  {% render 'sm-corner-doodles', section: section %}
  {% render 'sm-doodle-blocks', section: section %}
  <div class="sm-container sm-bhero__top" style="--sm-pad-top: {{ s.pad_top }}px; --sm-pad-bottom: 0px;">
    {%- if award != blank -%}<span class="sm-sticker">{{ award }}</span>{%- endif -%}
    <{{ s.heading_tag | default: 'h1' }} class="sm-bhero__title">{{ title }}</{{ s.heading_tag | default: 'h1' }}>
    {%- if tagline != blank -%}<p class="sm-bhero__tagline">{{ tagline }}</p>{%- endif -%}
  </div>
  <div class="sm-bhero__stage">
    <div class="sm-bhero__circle" aria-hidden="true"></div>
    {%- if img != blank -%}
      {%- assign img_alt = img.alt | default: p.title | append: ' game box' -%}
      {{ img | image_url: width: 900 | image_tag: alt: img_alt, class: 'sm-bhero__img', loading: 'eager', fetchpriority: 'high', sizes: '(min-width: 750px) 380px, 66vw' }}
    {%- endif -%}
  </div>
</section>
<section class="sm-bhero__band" style="--sm-bhero-band: {{ s.band_color }};">
  <div class="sm-bhero__band-inner">
    {%- if s.show_specs and has_specs -%}
      <dl class="sm-bhero__specs">
        {%- if f_ages != blank -%}<div><dd>{{ f_ages }}</dd><dt>Ages</dt></div>{%- endif -%}
        {%- if f_players != blank -%}<div><dd>{{ f_players }}</dd><dt>Players</dt></div>{%- endif -%}
        {%- if f_time != blank -%}<div><dd>{{ f_time | remove: ' minutes' | remove: 'minutes' | remove: ' mins' | remove: 'mins' | remove: ' min' | remove: 'min' | strip }}</dd><dt>Minutes</dt></div>{%- endif -%}
      </dl>
    {%- endif -%}
    {%- if amz != blank -%}
      <a class="sm-btn sm-bridge-amz" href="{{ amz }}" target="_blank" rel="sponsored noopener" data-sm-amazon data-amazon-cta="hero" data-placement="bridge_hero" data-product="{{ p.title | escape }}" data-product-id="{{ p.id }}" style="--sm-btn-bg: {{ s.button_bg }}; --sm-btn-fg: {{ s.button_fg }};">
        {{ btn_label }}<span class="sm-visually-hidden"> (opens Amazon in a new tab)</span>
      </a>
    {%- elsif request.design_mode -%}
      <p class="sm-bridge-note">Add this product's Amazon link (custom.amazon_link) or set one in this section to show the button.</p>
    {%- endif -%}
    {%- if s.show_rating and rating_count > 0 -%}
      <p class="sm-bhero__rating">
        <span aria-hidden="true">★</span> {{ rating.rating | round: 1 }} · {{ s.rating_text | replace: '[count]', rating_count }}
      </p>
    {%- endif -%}
  </div>
  <svg class="sm-bhero__wave" aria-hidden="true" viewBox="0 0 390 30" preserveAspectRatio="none"><path d="M-6 -6 L396 -6 L396 12 L390 12 C 300 34, 220 2, 150 16 S 40 30, 0 14 L-6 14 Z" fill="var(--sm-bhero-band)"></path><path d="M390 12 C 300 34, 220 2, 150 16 S 40 30, 0 14" fill="none" stroke="#000" stroke-width="3" vector-effect="non-scaling-stroke"></path></svg>
</section>

