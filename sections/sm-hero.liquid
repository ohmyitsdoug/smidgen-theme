{%- liquid
  assign s = section.settings
  assign featured = s.product
  assign heading = s.heading
  if s.highlight != blank
    assign highlight_markup = '<span class="sm-highlight">' | append: s.highlight | append: '</span>'
    assign heading = heading | replace: s.highlight, highlight_markup
  endif
-%}
<section
  id="sm-{{ section.id }}"
  class="sm-section sm-hero"
  style="--sm-bg: {{ s.bg }}; --sm-fg: {{ s.fg }};"
  aria-labelledby="sm-{{ section.id }}-title"
>
  {% render 'sm-doodle', shape: s.doodle, color: s.doodle_color, position: s.doodle_position %}
  {% render 'sm-doodle', shape: s.doodle_2, color: s.doodle_2_color, position: 'top-right' %}
  <div class="sm-container" style="--sm-pad-top: {{ s.pad_top }}px; --sm-pad-bottom: {{ s.pad_bottom }}px;">
    <div class="sm-split">
      <div class="sm-hero__copy">
        {%- if s.eyebrow != blank -%}
          <span class="sm-sticker">{{ s.eyebrow }}</span>
        {%- endif -%}
        <h1 id="sm-{{ section.id }}-title" class="sm-display sm-display--xl">{{ heading }}</h1>
        {%- if s.text != blank -%}
          <div class="sm-lede">{{ s.text }}</div>
        {%- endif -%}
        {%- if s.button_label != blank or s.button_2_label != blank -%}
          <div class="sm-actions">
            {%- if s.button_label != blank -%}
              <a class="sm-btn" href="{{ s.button_link | default: featured.url | default: routes.all_products_collection_url }}">
                {{- s.button_label -}}
              </a>
            {%- endif -%}
            {%- if s.button_2_label != blank -%}
              <a class="sm-btn sm-btn--secondary" href="{{ s.button_2_link | default: routes.all_products_collection_url }}">
                {{- s.button_2_label -}}
              </a>
            {%- endif -%}
          </div>
        {%- endif -%}
        {%- if s.small_print != blank -%}
          <p style="margin: 0; font-weight: 700;">{{ s.small_print }}</p>
        {%- endif -%}
      </div>

      {%- if s.image != blank or featured.featured_media -%}
        <div class="sm-hero__art">
          <div class="sm-hero__circle" style="--sm-circle: {{ s.circle_color }};">
            {%- if s.image != blank -%}
              {{ s.image | image_url: width: 900 | image_tag: alt: s.image.alt, loading: 'eager', fetchpriority: 'high', sizes: '(min-width: 900px) 440px, 80vw' }}
            {%- else -%}
              {{ featured.featured_media | image_url: width: 900 | image_tag: alt: featured.title, loading: 'eager', fetchpriority: 'high', sizes: '(min-width: 900px) 440px, 80vw' }}
            {%- endif -%}
          </div>
          {%- if s.note != blank -%}
            <span class="sm-hero__note">{{ s.note }}</span>
          {%- endif -%}
        </div>
      {%- endif -%}
    </div>
  </div>
</section>
{%- if s.divider != 'none' -%}
  {% render 'sm-divider', shape: s.divider, from: s.bg, to: s.divider_to %}
{%- endif -%}

{% schema %}
{
  "name": "Smidgen · Hero",
  "tag": "div",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Sticker", "default": "Award-winning family games" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Game night just got a Smidgen more fun!" },
    { "type": "text", "id": "highlight", "label": "Word(s) to color purple", "info": "Must match text in the heading exactly.", "default": "Smidgen" },
    { "type": "richtext", "id": "text", "label": "Text", "default": "<p>Small boxes, simple rules, big replay value. Games that set up fast and teach in minutes.</p>" },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Find your game" },
    { "type": "url", "id": "button_link", "label": "Button link" },
    { "type": "text", "id": "button_2_label", "label": "Second button label" },
    { "type": "url", "id": "button_2_link", "label": "Second button link" },
    { "type": "text", "id": "small_print", "label": "Small print", "info": "e.g. your review score" },
    { "type": "header", "content": "Art" },
    { "type": "product", "id": "product", "label": "Featured game", "info": "Uses the game's main image if no image is set." },
    { "type": "image_picker", "id": "image", "label": "Image" },
    { "type": "color", "id": "circle_color", "label": "Circle color", "default": "#753189" },
    { "type": "text", "id": "note", "label": "Hand-written note", "default": "2025 Strategy Game of the Year!" },
    { "type": "header", "content": "Doodles" },
    {
      "type": "select", "id": "doodle", "label": "Doodle",
      "options": [
        { "value": "none", "label": "None" }, { "value": "squiggle", "label": "Squiggle" },
        { "value": "spiral", "label": "Spiral" }, { "value": "zigzag", "label": "Zigzag" },
        { "value": "star", "label": "Star" }, { "value": "loop-arrow", "label": "Loop arrow" }
      ],
      "default": "squiggle"
    },
    { "type": "color", "id": "doodle_color", "label": "Doodle color", "default": "#753189" },
    {
      "type": "select", "id": "doodle_position", "label": "Doodle position",
      "options": [
        { "value": "top-left", "label": "Top left" }, { "value": "top-right", "label": "Top right" },
        { "value": "bottom-left", "label": "Bottom left" }, { "value": "bottom-right", "label": "Bottom right" }
      ],
      "default": "top-left"
    },
    {
      "type": "select", "id": "doodle_2", "label": "Second doodle (top right)",
      "options": [
        { "value": "none", "label": "None" }, { "value": "squiggle", "label": "Squiggle" },
        { "value": "spiral", "label": "Spiral" }, { "value": "zigzag", "label": "Zigzag" },
        { "value": "star", "label": "Star" }, { "value": "loop-arrow", "label": "Loop arrow" }
      ],
      "default": "star"
    },
    { "type": "color", "id": "doodle_2_color", "label": "Second doodle color", "default": "#20A4F3" },
    { "type": "header", "content": "Colors" },
    { "type": "color", "id": "bg", "label": "Background", "default": "#FFF503" },
    { "type": "color", "id": "fg", "label": "Text", "default": "#000000" },
    { "type": "header", "content": "Divider below" },
    {
      "type": "select", "id": "divider", "label": "Shape",
      "options": [
        { "value": "none", "label": "None" }, { "value": "wave", "label": "Wave" },
        { "value": "zigzag", "label": "Zigzag" }, { "value": "scallop", "label": "Scallop" },
        { "value": "straight", "label": "Straight line" }
      ],
      "default": "wave"
    },
    { "type": "color", "id": "divider_to", "label": "Next section color", "default": "#FFFFFF", "visible_if": "{{ section.settings.divider != 'none' }}" },
    { "type": "header", "content": "Spacing" },
    { "type": "range", "id": "pad_top", "label": "Top padding", "min": 0, "max": 120, "step": 8, "unit": "px", "default": 72 },
    { "type": "range", "id": "pad_bottom", "label": "Bottom padding", "min": 0, "max": 120, "step": 8, "unit": "px", "default": 40 }
  ],
  "presets": [{ "name": "Smidgen · Hero" }]
}
{% endschema %}
