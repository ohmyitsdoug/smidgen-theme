{%- liquid
  assign s = section.settings
  assign featured = s.product
  assign heading = s.heading
  if s.highlight != blank
    assign highlight_markup = '<span class="sm-highlight">' | append: s.highlight | append: '</span>'
    assign heading = heading | replace: s.highlight, highlight_markup
  endif
-%}
<section
  id="sm-{{ section.id }}"
  class="sm-section sm-hero"
  style="--sm-bg: {{ s.bg }}; --sm-fg: {{ s.fg }};{% render 'sm-btn-vars', s: s %}"
  aria-labelledby="sm-{{ section.id }}-title"
>
  {% render 'sm-corner-doodles', section: section %}
  {%- for block in section.blocks -%}
    {%- liquid
      assign b = block.settings
      assign scale = b.size | divided_by: 100.0
      assign d_style = 'left: ' | append: b.x | append: '%; top: ' | append: b.y | append: '%; transform: translate(-50%, -50%) rotate(' | append: b.rotate | append: 'deg) scale(' | append: scale | append: ');'
      assign d_class = ''
      if b.hide_mobile
        assign d_class = 'sm-doodle--hide-mobile'
      endif
    -%}
    {% render 'sm-doodle', shape: b.shape, color: b.color, style: d_style, extra_class: d_class, attrs: block.shopify_attributes, bg: section.settings.bg, outline: b.outline %}
  {%- endfor -%}
  <div class="sm-container" style="--sm-pad-top: {{ s.pad_top }}px; --sm-pad-bottom: {{ s.pad_bottom }}px;">
    <div class="sm-split">
      <div class="sm-hero__copy">
        {%- if s.eyebrow != blank -%}
          <span class="sm-sticker">{{ s.eyebrow }}</span>
        {%- endif -%}
        <{{ section.settings.heading_tag | default: 'h1' }} id="sm-{{ section.id }}-title" class="sm-display sm-display--xl">{{ heading }}</{{ section.settings.heading_tag | default: 'h1' }}>
        {%- if s.text != blank -%}
          <div class="sm-lede">{{ s.text }}</div>
        {%- endif -%}
        {%- if s.button_label != blank or s.button_2_label != blank -%}
          <div class="sm-actions">
            {%- if s.button_label != blank -%}
              <a class="sm-btn" href="{{ s.button_link | default: featured.url | default: routes.all_products_collection_url }}">
                {{- s.button_label -}}
              </a>
            {%- endif -%}
            {%- if s.button_2_label != blank -%}
              <a class="sm-btn sm-btn--secondary" href="{{ s.button_2_link | default: routes.all_products_collection_url }}">
                {{- s.button_2_label -}}
              </a>
            {%- endif -%}
          </div>
        {%- endif -%}
        {% render 'sm-store-rating', s: s %}
      </div>

      {%- if s.image != blank or featured.featured_media -%}
        <div class="sm-hero__art">
          <div class="sm-hero__circle" style="--sm-circle: {{ s.circle_color }};">
            {%- if s.image != blank -%}
              {%- assign hero_alt = s.image.alt | default: featured.title | default: s.heading | default: shop.name -%}{{ s.image | image_url: width: 900 | image_tag: alt: hero_alt, loading: 'eager', fetchpriority: 'high', sizes: '(min-width: 900px) 440px, 80vw' }}
            {%- else -%}
              {%- assign feat_alt = featured.featured_media.alt | default: featured.title | append: '' -%}{%- unless featured.featured_media.alt != blank -%}{%- assign feat_alt = featured.title | append: ' game box' -%}{%- endunless -%}
              {{ featured.featured_media | image_url: width: 900 | image_tag: alt: feat_alt, loading: 'eager', fetchpriority: 'high', sizes: '(min-width: 900px) 440px, 80vw' }}
            {%- endif -%}
          </div>
          {%- if s.note != blank -%}
            <span class="sm-hero__note">{{ s.note }}</span>
          {%- endif -%}
          {%- if s.show_badge and s.badge_image != blank -%}
            {%- capture badge_img -%}
              {%- assign badge_alt = s.badge_image.alt | default: 'Award badge' -%}{{ s.badge_image | image_url: width: 480 | image_tag: alt: badge_alt, loading: 'eager', sizes: '240px', style: 'width: 100%; height: auto; display: block;' }}
            {%- endcapture -%}
            {%- if s.badge_link != blank -%}
              <a class="sm-hero__badge" href="{{ s.badge_link }}" style="--sm-badge-w: {{ s.badge_size }}px; --sm-badge-r: {{ s.badge_rotate }}deg;">{{ badge_img }}</a>
            {%- else -%}
              <span class="sm-hero__badge" style="--sm-badge-w: {{ s.badge_size }}px; --sm-badge-r: {{ s.badge_rotate }}deg;">{{ badge_img }}</span>
            {%- endif -%}
          {%- endif -%}
        </div>
      {%- endif -%}
    </div>
  </div>
</section>
{%- if s.divider != 'none' -%}
  {% render 'sm-divider', shape: s.divider, from: s.bg, to: s.divider_to %}
{%- endif -%}

