{%- liquid
  assign s = section.settings
  assign featured = s.product
  assign heading = s.heading
  if s.highlight != blank
    assign highlight_markup = '<span class="sm-highlight">' | append: s.highlight | append: '</span>'
    assign heading = heading | replace: s.highlight, highlight_markup
  endif
-%}
<section
  id="sm-{{ section.id }}"
  class="sm-section sm-hero"
  style="--sm-bg: {{ s.bg }}; --sm-fg: {{ s.fg }};"
  aria-labelledby="sm-{{ section.id }}-title"
>
  {% render 'sm-doodle', shape: s.doodle, color: s.doodle_color, position: s.doodle_position %}
  {% render 'sm-doodle', shape: s.doodle_2, color: s.doodle_2_color, position: 'top-right' %}
  {%- for block in section.blocks -%}
    {%- liquid
      assign b = block.settings
      assign scale = b.size | divided_by: 100.0
      assign d_style = 'left: ' | append: b.x | append: '%; top: ' | append: b.y | append: '%; transform: translate(-50%, -50%) rotate(' | append: b.rotate | append: 'deg) scale(' | append: scale | append: ');'
      assign d_class = ''
      if b.hide_mobile
        assign d_class = 'sm-doodle--hide-mobile'
      endif
    -%}
    {% render 'sm-doodle', shape: b.shape, color: b.color, style: d_style, extra_class: d_class, attrs: block.shopify_attributes %}
  {%- endfor -%}
  <div class="sm-container" style="--sm-pad-top: {{ s.pad_top }}px; --sm-pad-bottom: {{ s.pad_bottom }}px;">
    <div class="sm-split">
      <div class="sm-hero__copy">
        {%- if s.eyebrow != blank -%}
          <span class="sm-sticker">{{ s.eyebrow }}</span>
        {%- endif -%}
        <h1 id="sm-{{ section.id }}-title" class="sm-display sm-display--xl">{{ heading }}</h1>
        {%- if s.text != blank -%}
          <div class="sm-lede">{{ s.text }}</div>
        {%- endif -%}
        {%- if s.button_label != blank or s.button_2_label != blank -%}
          <div class="sm-actions">
            {%- if s.button_label != blank -%}
              <a class="sm-btn" href="{{ s.button_link | default: featured.url | default: routes.all_products_collection_url }}">
                {{- s.button_label -}}
              </a>
            {%- endif -%}
            {%- if s.button_2_label != blank -%}
              <a class="sm-btn sm-btn--secondary" href="{{ s.button_2_link | default: routes.all_products_collection_url }}">
                {{- s.button_2_label -}}
              </a>
            {%- endif -%}
          </div>
        {%- endif -%}
        {%- liquid
          assign rating_line = blank
          if s.show_rating
            assign r_avg = s.rating_override | default: shop.metafields.judgeme.all_reviews_rating.value | default: shop.metafields.judgeme.all_reviews_rating
            assign r_count = s.count_override | default: shop.metafields.judgeme.all_reviews_count.value | default: shop.metafields.judgeme.all_reviews_count
            if r_avg == blank or r_count == blank
              assign r_sum = 0.0
              assign r_total = 0
              paginate collections.all.products by 250
                for hp in collections.all.products
                  assign r_c = hp.metafields.reviews.rating_count.value | default: 0
                  if r_c > 0
                    assign r_v = hp.metafields.reviews.rating.value.rating | times: r_c
                    assign r_sum = r_sum | plus: r_v
                    assign r_total = r_total | plus: r_c
                  endif
                endfor
              endpaginate
              if r_total > 0
                assign agg_avg = r_sum | divided_by: r_total
                assign r_count = r_count | default: r_total
                assign r_avg = r_avg | default: agg_avg
              endif
            endif
            if r_avg != blank and r_count != blank
              assign r_avg_num = r_avg | times: 1.0 | round: 1 | append: ''
              assign r_count_fmt = r_count | times: 1 | append: ''
              assign rating_line = s.rating_text | default: '★★★★★ [rating] from [count] reviews' | replace: '[rating]', r_avg_num | replace: '[count]', r_count_fmt
            endif
          endif
        -%}
        {%- if rating_line != blank or s.small_print != blank -%}
          <p class="sm-hero__small" style="margin: 0; font-weight: 700;">
            {%- if rating_line != blank -%}
              {%- if s.rating_link != blank -%}<a href="{{ s.rating_link }}" style="color: inherit;">{{ rating_line }}</a>{%- else -%}{{ rating_line }}{%- endif -%}
              {%- if s.small_print != blank %} · {% endif -%}
            {%- endif -%}
            {{- s.small_print -}}
          </p>
        {%- endif -%}
      </div>

      {%- if s.image != blank or featured.featured_media -%}
        <div class="sm-hero__art">
          <div class="sm-hero__circle" style="--sm-circle: {{ s.circle_color }};">
            {%- if s.image != blank -%}
              {{ s.image | image_url: width: 900 | image_tag: alt: s.image.alt, loading: 'eager', fetchpriority: 'high', sizes: '(min-width: 900px) 440px, 80vw' }}
            {%- else -%}
              {{ featured.featured_media | image_url: width: 900 | image_tag: alt: featured.title, loading: 'eager', fetchpriority: 'high', sizes: '(min-width: 900px) 440px, 80vw' }}
            {%- endif -%}
          </div>
          {%- if s.note != blank -%}
            <span class="sm-hero__note">{{ s.note }}</span>
          {%- endif -%}
          {%- if s.show_badge and s.badge_image != blank -%}
            {%- capture badge_img -%}
              {{ s.badge_image | image_url: width: 480 | image_tag: alt: s.badge_image.alt, loading: 'eager', sizes: '240px', style: 'width: 100%; height: auto; display: block;' }}
            {%- endcapture -%}
            {%- if s.badge_link != blank -%}
              <a class="sm-hero__badge" href="{{ s.badge_link }}" style="--sm-badge-w: {{ s.badge_size }}px; --sm-badge-r: {{ s.badge_rotate }}deg;">{{ badge_img }}</a>
            {%- else -%}
              <span class="sm-hero__badge" style="--sm-badge-w: {{ s.badge_size }}px; --sm-badge-r: {{ s.badge_rotate }}deg;">{{ badge_img }}</span>
            {%- endif -%}
          {%- endif -%}
        </div>
      {%- endif -%}
    </div>
  </div>
</section>
{%- if s.divider != 'none' -%}
  {% render 'sm-divider', shape: s.divider, from: s.bg, to: s.divider_to %}
{%- endif -%}

{% schema %}
