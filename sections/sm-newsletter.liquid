{%- liquid
  assign s = section.settings
  assign form_id = 'sm-newsletter-' | append: section.id
-%}
<section
  id="sm-{{ section.id }}"
  class="sm-section"
  style="--sm-bg: {{ s.bg }}; --sm-fg: {{ s.fg }};"
  aria-labelledby="sm-{{ section.id }}-title"
>
  {% render 'sm-doodle', shape: 'zigzag', color: '#EA5D00', position: 'bottom-left' %}
  <div class="sm-container sm-container--narrow" style="--sm-pad-top: {{ s.pad_top }}px; --sm-pad-bottom: {{ s.pad_bottom }}px; align-items: center; text-align: center;">
    <h2 id="sm-{{ section.id }}-title" class="sm-display">{{ s.heading }}</h2>
    {%- if s.text != blank -%}<div class="sm-lede">{{ s.text }}</div>{%- endif -%}
    {%- form 'customer', id: form_id, class: 'sm-inline-form' -%}
      <input type="hidden" name="contact[tags]" value="newsletter">
      <label for="sm-email-{{ section.id }}" class="sm-visually-hidden">Email address</label>
      <input
        id="sm-email-{{ section.id }}"
        class="sm-input"
        type="email"
        name="contact[email]"
        autocomplete="email"
        placeholder="{{ s.placeholder }}"
        required
      >
      <button type="submit" class="sm-btn">{{ s.button_label }}</button>
      {%- if form.posted_successfully? -%}
        <p class="sm-form-message" role="status" style="flex-basis: 100%;">{{ s.success }}</p>
      {%- elsif form.errors -%}
        <p class="sm-form-message" role="alert" style="flex-basis: 100%;">{{ form.errors.translated_fields.email | capitalize }} {{ form.errors.messages.email }}</p>
      {%- endif -%}
    {%- endform -%}
  </div>
</section>
{%- if s.divider != 'none' -%}
  {% render 'sm-divider', shape: s.divider, from: s.bg, to: s.divider_to %}
{%- endif -%}

{% schema %}
{
  "name": "Smidgen · Newsletter",
  "tag": "div",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Join the game night crew" },
    { "type": "richtext", "id": "text", "label": "Text", "default": "<p>New games, preorder drops and events near you. No spam, just fun.</p>" },
    { "type": "text", "id": "placeholder", "label": "Placeholder", "default": "you@email.com" },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Sign me up" },
    { "type": "text", "id": "success", "label": "Success message", "default": "You're in! Watch your inbox." },
    { "type": "header", "content": "Colors" },
    { "type": "color", "id": "bg", "label": "Background", "default": "#FFF503" },
    { "type": "color", "id": "fg", "label": "Text", "default": "#000000" },
    { "type": "header", "content": "Divider below" },
    {
      "type": "select", "id": "divider", "label": "Shape",
      "options": [
        { "value": "none", "label": "None" }, { "value": "wave", "label": "Wave" },
        { "value": "zigzag", "label": "Zigzag" }, { "value": "scallop", "label": "Scallop" }
      ],
      "default": "none"
    },
    { "type": "color", "id": "divider_to", "label": "Next section color", "default": "#000000", "visible_if": "{{ section.settings.divider != 'none' }}" },
    { "type": "header", "content": "Spacing" },
    { "type": "range", "id": "pad_top", "label": "Top padding", "min": 0, "max": 120, "step": 8, "unit": "px", "default": 56 },
    { "type": "range", "id": "pad_bottom", "label": "Bottom padding", "min": 0, "max": 120, "step": 8, "unit": "px", "default": 80 }
  ],
  "presets": [{ "name": "Smidgen · Newsletter" }]
}
{% endschema %}
