{%- comment -%}
  FAQ that never shows blank rows.
  Sources, in order:
  1. On a product page: the product's `smidgen.faqs` metafield
     (list of `smidgen_faq` metaobject entries with `question` + `answer`).
  2. Any FAQ blocks added to this section in the theme editor.
  Rows without both a question and an answer are skipped; if nothing is
  left, the whole section (and its dividers) is left out.
  Outputs FAQPage structured data when enabled.
{%- endcomment -%}
{%- liquid
  assign s = section.settings
  assign meta_faqs = blank
  if product and s.use_product
    assign meta_faqs = product.metafields.smidgen.faqs.value
  endif

  assign count = 0
  for entry in meta_faqs
    if entry.question.value != blank and entry.answer.value != blank
      assign count = count | plus: 1
    endif
  endfor
  for block in section.blocks
    if block.settings.question != blank and block.settings.answer != blank
      assign count = count | plus: 1
    endif
  endfor
-%}
{%- if count > 0 -%}
  {%- if s.divider_top != 'none' -%}
    {% render 'sm-divider', shape: s.divider_top, from: s.divider_from, to: s.bg %}
  {%- endif -%}
  <section
    id="{{ s.anchor | default: 'faq' }}"
    class="sm-section"
    style="--sm-bg: {{ s.bg }}; --sm-fg: {{ s.fg }};"
    aria-labelledby="sm-{{ section.id }}-title"
  >
    <div class="sm-container sm-container--narrow" style="--sm-pad-top: {{ s.pad_top }}px; --sm-pad-bottom: {{ s.pad_bottom }}px;">
      <h2 id="sm-{{ section.id }}-title" class="sm-display" style="font-size: clamp(2.2rem, 5vw, 3rem);">
        {{- s.heading -}}
      </h2>
      <div class="sm-faq">
        {%- for entry in meta_faqs -%}
          {%- if entry.question.value != blank and entry.answer.value != blank -%}
            <details {% if forloop.first and s.open_first %}open{% endif %}>
              <summary>{{ entry.question.value }}</summary>
              <div class="sm-faq__answer">{{ entry.answer | metafield_tag }}</div>
            </details>
          {%- endif -%}
        {%- endfor -%}
        {%- for block in section.blocks -%}
          {%- if block.settings.question != blank and block.settings.answer != blank -%}
            <details {{ block.shopify_attributes }}>
              <summary>{{ block.settings.question }}</summary>
              <div class="sm-faq__answer sm-rte">{{ block.settings.answer }}</div>
            </details>
          {%- endif -%}
        {%- endfor -%}
      </div>
    </div>
  </section>
  {%- if s.divider != 'none' -%}
    {% render 'sm-divider', shape: s.divider, from: s.bg, to: s.divider_to %}
  {%- endif -%}

  {%- if s.schema -%}
    {%- capture faq_items -%}
      {%- for entry in meta_faqs -%}
        {%- if entry.question.value != blank and entry.answer.value != blank -%}
          {"@type":"Question","name":{{ entry.question.value | json }},"acceptedAnswer":{"@type":"Answer","text":{{ entry.answer | metafield_text | json }}}},
        {%- endif -%}
      {%- endfor -%}
      {%- for block in section.blocks -%}
        {%- if block.settings.question != blank and block.settings.answer != blank -%}
          {"@type":"Question","name":{{ block.settings.question | json }},"acceptedAnswer":{"@type":"Answer","text":{{ block.settings.answer | strip_html | json }}}},
        {%- endif -%}
      {%- endfor -%}
    {%- endcapture -%}
    {%- assign faq_items = faq_items | strip | remove_last: ',' -%}
    <script type="application/ld+json">
      {"@context":"https://schema.org","@type":"FAQPage","mainEntity":[{{ faq_items }}]}
    </script>
  {%- endif -%}
{%- endif -%}

{% schema %}
{
  "name": "Smidgen · FAQ",
  "tag": "div",
  "settings": [
    { "type": "paragraph", "content": "Empty questions are hidden automatically. On product pages, FAQs come from the product's FAQ field first." },
    { "type": "text", "id": "anchor", "label": "Link anchor", "default": "faq" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Good questions" },
    { "type": "checkbox", "id": "use_product", "label": "Use product FAQs on product pages", "default": true },
    { "type": "checkbox", "id": "open_first", "label": "Open the first question", "default": false },
    { "type": "checkbox", "id": "schema", "label": "Add FAQ structured data for search", "default": true },
    { "type": "header", "content": "Colors" },
    { "type": "color", "id": "bg", "label": "Background", "default": "#FFFFFF" },
    { "type": "color", "id": "fg", "label": "Text", "default": "#000000" },
    { "type": "header", "content": "Divider above" },
    {
      "type": "select", "id": "divider_top", "label": "Shape",
      "options": [
        { "value": "none", "label": "None" }, { "value": "wave", "label": "Wave" },
        { "value": "zigzag", "label": "Zigzag" }, { "value": "scallop", "label": "Scallop" }
      ],
      "default": "none"
    },
    { "type": "color", "id": "divider_from", "label": "Previous section color", "default": "#FFFFFF", "visible_if": "{{ section.settings.divider_top != 'none' }}" },
    { "type": "header", "content": "Divider below" },
    {
      "type": "select", "id": "divider", "label": "Shape",
      "options": [
        { "value": "none", "label": "None" }, { "value": "wave", "label": "Wave" },
        { "value": "zigzag", "label": "Zigzag" }, { "value": "scallop", "label": "Scallop" }
      ],
      "default": "none"
    },
    { "type": "color", "id": "divider_to", "label": "Next section color", "default": "#FFFFFF", "visible_if": "{{ section.settings.divider != 'none' }}" },
    { "type": "header", "content": "Spacing" },
    { "type": "range", "id": "pad_top", "label": "Top padding", "min": 0, "max": 120, "step": 8, "unit": "px", "default": 48 },
    { "type": "range", "id": "pad_bottom", "label": "Bottom padding", "min": 0, "max": 120, "step": 8, "unit": "px", "default": 72 }
  ],
  "blocks": [
    {
      "type": "question",
      "name": "Question",
      "settings": [
        { "type": "text", "id": "question", "label": "Question" },
        { "type": "richtext", "id": "answer", "label": "Answer" }
      ]
    }
  ],
  "presets": [{ "name": "Smidgen · FAQ", "blocks": [{ "type": "question" }, { "type": "question" }, { "type": "question" }] }]
}
{% endschema %}
