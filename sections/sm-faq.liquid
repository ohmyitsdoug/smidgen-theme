{%- comment -%}
  FAQ that never shows blank rows.
  Sources, in order:
  1. On a product page: the product's `smidgen.faqs` metafield
     (list of `smidgen_faq` metaobject entries with `question` + `answer`).
  2. Any FAQ blocks added to this section in the theme editor.
  Rows without both a question and an answer are skipped; if nothing is
  left, the whole section (and its dividers) is left out.
  Outputs FAQPage structured data when enabled.
{%- endcomment -%}
{%- liquid
  assign s = section.settings
  assign meta_faqs = blank
  if product and s.use_product
    assign meta_faqs = product.metafields.smidgen.faqs.value | default: product.metafields.custom.faqs.value
  endif

  assign box_items = blank
  assign box_count = 0
  if product and s.show_box
    assign cf = s.components_field | default: 'custom.components' | strip | split: '.'
    assign box_field = product.metafields[cf[0]][cf[1]]
    if box_field.type contains 'list.'
      assign box_items = box_field.value
    else
      assign box_items = box_field.value | newline_to_br | split: '<br />'
    endif
    for item in box_items
      assign item_text = item | strip
      if item_text != blank
        assign box_count = box_count | plus: 1
      endif
    endfor
  endif

  assign count = 0
  for entry in meta_faqs
    if entry.question.value != blank and entry.answer.value != blank
      assign count = count | plus: 1
    endif
  endfor
  for block in section.blocks
    if block.type == 'doodle'
      continue
    endif
    if block.settings.question != blank and block.settings.answer != blank
      assign count = count | plus: 1
    endif
  endfor
  assign total = count | plus: box_count
-%}
{%- if total > 0 -%}
  {%- if s.divider_top != 'none' -%}
    {% render 'sm-divider', shape: s.divider_top, from: s.divider_from, to: s.bg %}
  {%- endif -%}
  <section
    id="{{ s.anchor | default: 'faq' }}"
    class="sm-section"
    style="--sm-bg: {{ s.bg }}; --sm-fg: {{ s.fg }};"
    aria-labelledby="sm-{{ section.id }}-title"
  >
    {% render 'sm-doodle-blocks', section: section %}
    <div class="sm-container{% if box_count == 0 or count == 0 %} sm-container--narrow{% endif %}" style="--sm-pad-top: {{ s.pad_top }}px; --sm-pad-bottom: {{ s.pad_bottom }}px;">
     <div class="sm-faq-split{% if box_count > 0 and count > 0 %} sm-faq-split--two{% endif %}">
      {%- if box_count > 0 -%}
        <div id="in-the-box" class="sm-faq-split__box">
          <h2 class="sm-display" style="font-size: clamp(2.2rem, 5vw, 3rem);">{{ s.box_heading }}</h2>
          <ul class="sm-checklist sm-box" style="box-shadow: var(--sm-shadow);">
            {%- for item in box_items -%}
              {%- assign item_text = item | strip -%}
              {%- if item_text != blank -%}<li>{{ item_text }}</li>{%- endif -%}
            {%- endfor -%}
          </ul>
        </div>
      {%- endif -%}
      {%- if count > 0 -%}
      <div class="sm-faq-split__faq">
      <h2 id="sm-{{ section.id }}-title" class="sm-display" style="font-size: clamp(2.2rem, 5vw, 3rem);">
        {{- s.heading -}}
      </h2>
      <div class="sm-faq">
        {%- for entry in meta_faqs -%}
          {%- if entry.question.value != blank and entry.answer.value != blank -%}
            <details {% if forloop.first and s.open_first %}open{% endif %}>
              <summary>{{ entry.question.value }}</summary>
              <div class="sm-faq__answer">{{ entry.answer | metafield_tag }}</div>
            </details>
          {%- endif -%}
        {%- endfor -%}
        {%- for block in section.blocks -%}{%- if block.type == 'doodle' -%}{%- continue -%}{%- endif -%}
          {%- if block.type == 'group' and block.settings.title != blank -%}
            <h3 class="sm-faq__group" {% if block.settings.anchor != blank %}id="{{ block.settings.anchor | handle }}"{% endif %} {{ block.shopify_attributes }}>{{ block.settings.title }}</h3>
            {%- continue -%}
          {%- endif -%}
          {%- if block.settings.question != blank and block.settings.answer != blank -%}
            <details {{ block.shopify_attributes }}>
              <summary>{{ block.settings.question }}</summary>
              <div class="sm-faq__answer sm-rte">{{ block.settings.answer }}</div>
            </details>
          {%- endif -%}
        {%- endfor -%}
      </div>
      </div>
      {%- endif -%}
     </div>
    </div>
  </section>
  {%- if s.divider != 'none' -%}
    {% render 'sm-divider', shape: s.divider, from: s.bg, to: s.divider_to %}
  {%- endif -%}

  {%- if s.schema and count > 0 -%}
    {%- capture faq_items -%}
      {%- for entry in meta_faqs -%}
        {%- if entry.question.value != blank and entry.answer.value != blank -%}
          {"@type":"Question","name":{{ entry.question.value | strip | json }},"acceptedAnswer":{"@type":"Answer","text":{{ entry.answer | metafield_text | strip | strip_newlines | json }}}},
        {%- endif -%}
      {%- endfor -%}
      {%- for block in section.blocks -%}{%- if block.type == 'doodle' -%}{%- continue -%}{%- endif -%}
        {%- if block.settings.question != blank and block.settings.answer != blank -%}
          {%- assign a_txt = block.settings.answer | replace: '<br>', ' ' | replace: '<br/>', ' ' | replace: '<br />', ' ' | replace: '&nbsp;', ' ' | strip_html | strip | strip_newlines -%}
          {"@type":"Question","name":{{ block.settings.question | strip | json }},"acceptedAnswer":{"@type":"Answer","text":{{ a_txt | json }}}},
        {%- endif -%}
      {%- endfor -%}
    {%- endcapture -%}
    {%- assign faq_items = faq_items | strip | remove_last: ',' -%}
    <script type="application/ld+json">
      {"@context":"https://schema.org","@type":"FAQPage","mainEntity":[{{ faq_items }}]}
    </script>
  {%- endif -%}
{%- endif -%}

{% schema %}
