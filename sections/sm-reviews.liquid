{%- comment -%}
  Reviews for product pages, powered by Judge.me.
  - Summary box: Shopify's standard review fields (reviews.rating,
    reviews.rating_count), which Judge.me keeps updated.
  - Review cards: a scrollable row. Cards come from "Featured review" blocks
    (written in the editor) plus the reviews Judge.me loads on the page,
    restyled into Smidgen cards.
  - App blocks (Judge.me Review widget, Medals / badges) sit in the left
    column. When cards are built, Judge.me's own list is hidden and only its
    "Write a review" button and form stay visible.
{%- endcomment -%}
{%- liquid
  assign s = section.settings
  assign rating = product.metafields.reviews.rating.value
  assign rating_count = product.metafields.reviews.rating_count.value | default: 0
  assign featured_count = 0
  for block in section.blocks
    if block.type == 'review' and block.settings.text != blank
      assign featured_count = featured_count | plus: 1
    endif
  endfor
  assign show = true
  if s.hide_empty and rating_count == 0 and featured_count == 0 and request.design_mode == false
    assign show = false
  endif
-%}
{%- if show -%}
  {%- if s.divider_top != 'none' -%}
    {% render 'sm-divider', shape: s.divider_top, from: s.divider_from, to: s.bg %}
  {%- endif -%}
  <section
    id="reviews"
    class="sm-section sm-reviews"
    style="--sm-bg: {{ s.bg }}; --sm-fg: {{ s.fg }};{% render 'sm-btn-vars', s: s %} --sm-review-bg: {{ s.card_bg }};"
    aria-labelledby="sm-{{ section.id }}-title"
    data-sm-reviews
    data-max="{{ s.max_reviews }}"
  >
    <div class="sm-container" style="--sm-pad-top: {{ s.pad_top }}px; --sm-pad-bottom: {{ s.pad_bottom }}px;">
      <div class="sm-reviews__layout">
        <div class="sm-reviews__side">
          <h2 id="sm-{{ section.id }}-title" class="sm-display" style="font-size: clamp(2.2rem, 5vw, 3rem);">
            {{- s.heading -}}
          </h2>
          {%- if rating_count > 0 -%}
            <div class="sm-rating-box">
              <span class="sm-rating-box__num">{{ rating.rating | round: 1 }}</span>
              <span style="display: flex; flex-direction: column; gap: 4px;">
                {%- assign full_stars = rating.rating | round -%}
                <span class="sm-stars" aria-hidden="true">
                  {%- for i in (1..5) -%}
                    {%- if i <= full_stars -%}★{%- else -%}☆{%- endif -%}
                  {%- endfor -%}
                </span>
                <span>
                  out of {{ rating.scale_max }} ·
                  {{ rating_count }}
                  {{ rating_count | pluralize: 'review', 'reviews' -}}
                </span>
              </span>
            </div>
          {%- elsif request.design_mode -%}
            <p style="margin: 0;">This game has no reviews yet, so this section is hidden on the live store (unless you add featured reviews).</p>
          {%- endif -%}

          {%- comment -%} App blocks: badges/medals go here, the review widget goes in the panel below. {%- endcomment -%}
          {%- capture app_side -%}{%- endcapture -%}
          {%- capture app_panel -%}{%- endcapture -%}
          {%- for block in section.blocks -%}
            {%- if block.type == '@app' -%}
              {%- capture one_app -%}{% render block %}{%- endcapture -%}
              {%- liquid
                assign probe = one_app | downcase
                assign is_widget = false
                if block.settings.review_data != blank or block.settings.empty_state != blank
                  assign is_widget = true
                elsif probe contains 'review-widget' or probe contains 'review_widget' or probe contains 'jdgm-rev-widg' or probe contains 'reviewwidget'
                  assign is_widget = true
                endif
                assign app_len = one_app | size
                if app_len > 6000
                  assign is_widget = true
                endif
                assign is_side = false
                if is_widget == false and probe contains 'medal'
                  assign is_side = true
                endif
              -%}
              {%- if is_side -%}
                {%- capture app_side -%}{{ app_side }}{{ one_app }}{%- endcapture -%}
              {%- else -%}
                {%- capture app_panel -%}{{ app_panel }}{{ one_app }}{%- endcapture -%}
              {%- endif -%}
            {%- endif -%}
          {%- endfor -%}
          {%- if app_side != blank -%}<div class="sm-reviews__apps">{{ app_side }}</div>{%- endif -%}
          {%- if app_panel != blank -%}
            <a href="#sm-reviews-all-{{ section.id }}" class="sm-btn" data-sm-reviews-open style="align-self: flex-start;">{{ s.write_label }}</a>
          {%- endif -%}

          {%- if request.design_mode and app_panel == blank -%}
            <p style="margin: 0; padding: 14px; border: 3px dashed #000; border-radius: 16px; font-size: 0.9rem; background: #fff; color: #000;">
              <strong>Only you see this:</strong> add block → Apps → <em>Judge.me Review widget</em> for the full review list and "Write a review" form.
            </p>
          {%- endif -%}
        </div>

        <div class="sm-reviews__main">
          <div class="sm-reviews__track" data-sm-reviews-track tabindex="0" aria-label="Customer reviews">
            {%- for block in section.blocks -%}
              {%- if block.type == 'review' and block.settings.text != blank -%}
                <figure class="sm-review-card" {{ block.shopify_attributes }}>
                  <span class="sm-review-card__stars" aria-label="{{ block.settings.stars }} out of 5 stars">
                    {%- for i in (1..5) -%}{%- if i <= block.settings.stars -%}★{%- else -%}☆{%- endif -%}{%- endfor -%}
                  </span>
                  {%- if block.settings.title != blank -%}<strong class="sm-review-card__title">{{ block.settings.title }}</strong>{%- endif -%}
                  <blockquote class="sm-review-card__text">{{ block.settings.text }}</blockquote>
                  <figcaption class="sm-review-card__who">
                    {{ block.settings.name | default: 'Verified buyer' }}
                    {%- if block.settings.verified %} · Verified buyer{% endif -%}
                  </figcaption>
                </figure>
              {%- endif -%}
            {%- endfor -%}
          </div>
          <div class="sm-reviews__nav" data-sm-reviews-nav hidden>
            <button type="button" class="sm-reviews__arrow" data-dir="-1" aria-label="Previous reviews"><svg width="22" height="22" viewBox="0 0 256 256" fill="currentColor" aria-hidden="true" focusable="false"><path d="M168.49,199.51a12,12,0,0,1-17,17l-80-80a12,12,0,0,1,0-17l80-80a12,12,0,0,1,17,17L97,128Z"/></svg></button>
            <button type="button" class="sm-reviews__arrow" data-dir="1" aria-label="Next reviews"><svg width="22" height="22" viewBox="0 0 256 256" fill="currentColor" aria-hidden="true" focusable="false"><path d="M184.49,136.49l-80,80a12,12,0,0,1-17-17L159,128,87.51,56.49a12,12,0,1,1,17-17l80,80A12,12,0,0,1,184.49,136.49Z"/></svg></button>
          </div>
          <p class="sm-reviews__empty" data-sm-reviews-empty hidden>{{ s.empty_text }}</p>
        </div>
      </div>

      {%- if app_panel != blank -%}
        <div class="sm-reviews__panel{% unless s.show_all_toggle %} sm-reviews__panel--quiet{% endunless %}" id="sm-reviews-all-{{ section.id }}" data-sm-reviews-panel>
          <button type="button" class="sm-reviews__panel-toggle" data-sm-reviews-toggle aria-expanded="false">{{ s.all_label }}</button>
          <div class="sm-reviews__panel-body">{{ app_panel }}</div>
        </div>
      {%- endif -%}

      {%- assign legacy = product.metafields.judgeme.widget.value | default: product.metafields.judgeme.widget -%}
      {%- if legacy != blank -%}
        <template data-sm-reviews-source>{{ legacy }}</template>
      {%- endif -%}
    </div>
  </section>
  {%- if s.divider != 'none' -%}
    {% render 'sm-divider', shape: s.divider, from: s.bg, to: s.divider_to %}
  {%- endif -%}

  <script>
    (function () {
      var root = document.getElementById('shopify-section-{{ section.id }}');
      if (!root) return;
      var section = root.querySelector('[data-sm-reviews]');
      var track = root.querySelector('[data-sm-reviews-track]');
      var nav = root.querySelector('[data-sm-reviews-nav]');
      var panel = root.querySelector('[data-sm-reviews-panel]');
      var empty = root.querySelector('[data-sm-reviews-empty]');
      var max = parseInt(section.getAttribute('data-max'), 10) || 12;
      var seen = {};

      function txt(el, sel) {
        var n = el.querySelector(sel);
        return n ? n.textContent.replace(/\s+/g, ' ').trim() : '';
      }
      function starStr(n) {
        var out = '';
        for (var i = 1; i <= 5; i++) out += i <= n ? '\u2605' : '\u2606';
        return out;
      }
      function updateNav() {
        nav.hidden = !(track.scrollWidth > track.clientWidth + 4);
      }
      function addCard(score, title, body, author, verified) {
        if (track.children.length >= max || !body) return;
        var key = author + '|' + body.slice(0, 50);
        if (seen[key]) return;
        seen[key] = true;
        var fig = document.createElement('figure');
        fig.className = 'sm-review-card';
        var st = document.createElement('span');
        st.className = 'sm-review-card__stars';
        st.setAttribute('aria-label', score + ' out of 5 stars');
        st.textContent = starStr(score);
        fig.appendChild(st);
        if (title) {
          var t = document.createElement('strong');
          t.className = 'sm-review-card__title';
          t.textContent = title;
          fig.appendChild(t);
        }
        var q = document.createElement('blockquote');
        q.className = 'sm-review-card__text';
        q.textContent = body;
        fig.appendChild(q);
        var c = document.createElement('figcaption');
        c.className = 'sm-review-card__who';
        c.textContent = (author || 'Customer') + (verified ? ' \u00b7 Verified buyer' : '');
        fig.appendChild(c);
        track.appendChild(fig);
      }
      function harvest(scope) {
        scope.querySelectorAll('.jdgm-rev').forEach(function (rev) {
          var scoreEl = rev.querySelector('[data-score]');
          var score = scoreEl ? Math.round(parseFloat(scoreEl.getAttribute('data-score'))) || 5 : 5;
          addCard(
            score,
            txt(rev, '.jdgm-rev__title'),
            txt(rev, '.jdgm-rev__body'),
            txt(rev, '.jdgm-rev__author'),
            !!rev.querySelector('.jdgm-rev__buyer-badge, .jdgm--verified, [data-verified-buyer="true"]')
          );
        });
      }
      function refresh() {
        var has = track.children.length > 0;
        track.hidden = !has;
        if (empty) empty.hidden = has || !panel;
        updateNav();
        return has;
      }

      // 1. Judge.me's saved review HTML (server-rendered)
      var tpl = root.querySelector('template[data-sm-reviews-source]');
      if (tpl) harvest(tpl.content);
      // 2. Classic Judge.me widget markup on the page, if any
      harvest(root);
      refresh();

      if (!track.children.length) {
        var mo = new MutationObserver(function () { harvest(root); if (refresh()) mo.disconnect(); });
        mo.observe(root, { childList: true, subtree: true });
        setTimeout(function () {
          mo.disconnect();
          if (!refresh() && panel) panel.classList.add('sm-reviews__panel--needs-toggle');
        }, 4000);
      }

      function setOpen(on) {
        if (!panel) return;
        panel.classList.toggle('is-open', on);
        var tg = panel.querySelector('[data-sm-reviews-toggle]');
        if (tg) tg.setAttribute('aria-expanded', on ? 'true' : 'false');
      }
      var toggle = root.querySelector('[data-sm-reviews-toggle]');
      if (toggle) toggle.addEventListener('click', function () { setOpen(!panel.classList.contains('is-open')); });

      var openBtn = root.querySelector('[data-sm-reviews-open]');
      if (openBtn && panel) {
        openBtn.addEventListener('click', function (e) {
          e.preventDefault();
          // 1. Find Judge.me's own "Write a review" control (plain DOM or open shadow roots).
          function findWrite(scope) {
            var els = scope.querySelectorAll('button, a, [role="button"]');
            for (var i = 0; i < els.length; i++) {
              if (/write\s+a\s+review/i.test(els[i].textContent || els[i].getAttribute('aria-label') || '')) return els[i];
            }
            var hosts = scope.querySelectorAll('*');
            for (var j = 0; j < hosts.length; j++) {
              if (hosts[j].shadowRoot) { var f = findWrite(hosts[j].shadowRoot); if (f) return f; }
            }
            return null;
          }
          function visibleDialog() {
            var cands = document.querySelectorAll('dialog[open], [role="dialog"], [aria-modal="true"], [class*="modal"], [class*="popup"]');
            for (var i = 0; i < cands.length; i++) {
              var c = cands[i];
              if (panel.contains(c) && !panel.classList.contains('is-open')) continue;
              var r = c.getBoundingClientRect();
              var cs = getComputedStyle(c);
              if (r.width > 200 && r.height > 150 && cs.visibility !== 'hidden' && cs.display !== 'none' && parseFloat(cs.opacity) > 0.1) return c;
            }
            return null;
          }
          var w = panel ? findWrite(panel) : null;
          if (w) {
            // 2. Open Judge.me's review form directly. Most versions show it as a pop-up over the page.
            w.click();
            setTimeout(function () {
              if (visibleDialog()) return;
              // 3. This widget shows the form inline: reveal the panel and jump straight to the form.
              setOpen(true);
              setTimeout(function () {
                var form = panel.querySelector('form, .jdgm-form-wrapper, [class*="review-form"], [class*="ReviewForm"]') || w;
                form.scrollIntoView({ behavior: 'smooth', block: 'center' });
                var first = form.querySelector && form.querySelector('input, textarea, [role="radio"]');
                if (first && first.focus) first.focus({ preventScroll: true });
              }, 120);
            }, 450);
          } else if (panel) {
            setOpen(true);
            panel.scrollIntoView({ behavior: 'smooth', block: 'start' });
          }
        });
      }

      nav.addEventListener('click', function (e) {
        var btn = e.target.closest('button[data-dir]');
        if (!btn) return;
        var card = track.querySelector('.sm-review-card');
        var step = card ? card.getBoundingClientRect().width + 24 : track.clientWidth * 0.8;
        track.scrollBy({ left: step * parseInt(btn.getAttribute('data-dir'), 10), behavior: 'smooth' });
      });
      window.addEventListener('resize', updateNav);
    })();
  </script>
{%- endif -%}

{% schema %}
{
  "name": "Smidgen · Reviews",
  "tag": "div",
  "enabled_on": {
    "templates": [
      "product"
    ]
  },
  "settings": [
    {
      "type": "paragraph",
      "content": "Review cards come from Judge.me's saved reviews plus any Featured review blocks. Add the Judge.me Review widget app block for the full list and review form (shown in a See all reviews panel). Judge.me Medals blocks show under the rating."
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Reviews"
    },
    {
      "type": "text",
      "id": "write_label",
      "label": "Write review button",
      "default": "Write a review"
    },
    {
      "type": "checkbox",
      "id": "show_all_toggle",
      "label": "Show 'See all reviews' toggle",
      "default": false,
      "info": "Off: Judge.me's full widget stays hidden and only opens when someone clicks Write a review."
    },
    {
      "type": "text",
      "id": "all_label",
      "label": "All reviews toggle",
      "default": "See all reviews"
    },
    {
      "type": "text",
      "id": "empty_text",
      "label": "Text when no cards load",
      "default": "Read what players are saying below."
    },
    {
      "type": "range",
      "id": "max_reviews",
      "label": "Max review cards",
      "min": 3,
      "max": 30,
      "step": 1,
      "default": 12
    },
    {
      "type": "checkbox",
      "id": "hide_empty",
      "label": "Hide when a game has no reviews",
      "default": true
    },
    {
      "type": "header",
      "content": "Buttons"
    },
    {
      "type": "paragraph",
      "content": "Leave empty for the standard purple button and white second button."
    },
    {
      "type": "color",
      "id": "btn_bg",
      "label": "Button color"
    },
    {
      "type": "color",
      "id": "btn_fg",
      "label": "Button text"
    },
    {
      "type": "color",
      "id": "btn2_bg",
      "label": "Second button color"
    },
    {
      "type": "color",
      "id": "btn2_fg",
      "label": "Second button text"
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "bg",
      "label": "Background",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "fg",
      "label": "Text",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "card_bg",
      "label": "Card background",
      "default": "#FFFFFF"
    },
    {
      "type": "header",
      "content": "Divider above"
    },
    {
      "type": "select",
      "id": "divider_top",
      "label": "Shape",
      "options": [
        {
          "value": "none",
          "label": "None"
        },
        {
          "value": "wave",
          "label": "Wave"
        },
        {
          "value": "zigzag",
          "label": "Zigzag"
        },
        {
          "value": "scallop",
          "label": "Scallop"
        }
      ],
      "default": "none"
    },
    {
      "type": "color",
      "id": "divider_from",
      "label": "Previous section color",
      "default": "#FFFFFF",
      "visible_if": "{{ section.settings.divider_top != 'none' }}"
    },
    {
      "type": "header",
      "content": "Divider below"
    },
    {
      "type": "select",
      "id": "divider",
      "label": "Shape",
      "options": [
        {
          "value": "none",
          "label": "None"
        },
        {
          "value": "wave",
          "label": "Wave"
        },
        {
          "value": "zigzag",
          "label": "Zigzag"
        },
        {
          "value": "scallop",
          "label": "Scallop"
        }
      ],
      "default": "none"
    },
    {
      "type": "color",
      "id": "divider_to",
      "label": "Next section color",
      "default": "#20A4F3",
      "visible_if": "{{ section.settings.divider != 'none' }}"
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "pad_top",
      "label": "Top padding",
      "min": 0,
      "max": 120,
      "step": 8,
      "unit": "px",
      "default": 24
    },
    {
      "type": "range",
      "id": "pad_bottom",
      "label": "Bottom padding",
      "min": 0,
      "max": 120,
      "step": 8,
      "unit": "px",
      "default": 80
    }
  ],
  "blocks": [
    {
      "type": "@app"
    },
    {
      "type": "review",
      "name": "Featured review",
      "settings": [
        {
          "type": "range",
          "id": "stars",
          "label": "Stars",
          "min": 1,
          "max": 5,
          "step": 1,
          "default": 5
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Review"
        },
        {
          "type": "text",
          "id": "name",
          "label": "Name"
        },
        {
          "type": "checkbox",
          "id": "verified",
          "label": "Verified buyer",
          "default": true
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Smidgen · Reviews"
    }
  ]
}
{% endschema %}
