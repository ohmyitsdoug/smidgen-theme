{%- comment -%}
  Reviews for product pages, powered by Judge.me.
  - The summary box reads Shopify's standard review fields
    (reviews.rating, reviews.rating_count), which Judge.me keeps updated.
  - Add the Judge.me "Review widget" app block inside this section for the
    review list and "Write a review" form.
  - When a game has no reviews yet and "Hide when empty" is on, the whole
    section is skipped (good for preorders).
{%- endcomment -%}
{%- liquid
  assign s = section.settings
  assign rating = product.metafields.reviews.rating.value
  assign rating_count = product.metafields.reviews.rating_count.value | default: 0
  assign show = true
  if s.hide_empty and rating_count == 0 and request.design_mode == false
    assign show = false
  endif
-%}
{%- if show -%}
  <section
    id="reviews"
    class="sm-section"
    style="--sm-bg: {{ s.bg }}; --sm-fg: {{ s.fg }};"
    aria-labelledby="sm-{{ section.id }}-title"
  >
    <div class="sm-container" style="--sm-pad-top: {{ s.pad_top }}px; --sm-pad-bottom: {{ s.pad_bottom }}px;">
      <div style="display: flex; flex-wrap: wrap; gap: 40px; align-items: flex-start;">
        <div style="flex: 1 1 280px; display: flex; flex-direction: column; gap: 16px;">
          <h2 id="sm-{{ section.id }}-title" class="sm-display" style="font-size: clamp(2.2rem, 5vw, 3rem);">
            {{- s.heading -}}
          </h2>
          {%- if rating_count > 0 -%}
            <div class="sm-rating-box">
              <span class="sm-rating-box__num">{{ rating.rating | round: 1 }}</span>
              <span style="display: flex; flex-direction: column; gap: 4px;">
                {%- assign full_stars = rating.rating | round -%}
                <span class="sm-stars" aria-hidden="true">
                  {%- for i in (1..5) -%}
                    {%- if i <= full_stars -%}★{%- else -%}☆{%- endif -%}
                  {%- endfor -%}
                </span>
                <span>
                  out of {{ rating.scale_max }} ·
                  {{ rating_count }}
                  {{ rating_count | pluralize: 'review', 'reviews' -}}
                </span>
              </span>
            </div>
          {%- elsif request.design_mode -%}
            <p style="margin: 0;">This game has no reviews yet, so this section is hidden on the live store.</p>
          {%- endif -%}
        </div>
        <div style="flex: 2 1 520px; min-width: 0;">
          {%- for block in section.blocks -%}
            {% render block %}
          {%- endfor -%}
        </div>
      </div>
    </div>
  </section>
{%- endif -%}

{% schema %}
{
  "name": "Smidgen · Reviews",
  "tag": "div",
  "enabled_on": { "templates": ["product"] },
  "settings": [
    { "type": "paragraph", "content": "Add the Judge.me Review widget as an app block in this section." },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Reviews" },
    { "type": "checkbox", "id": "hide_empty", "label": "Hide when a game has no reviews", "default": true },
    { "type": "color", "id": "bg", "label": "Background", "default": "#FFFFFF" },
    { "type": "color", "id": "fg", "label": "Text", "default": "#000000" },
    { "type": "range", "id": "pad_top", "label": "Top padding", "min": 0, "max": 120, "step": 8, "unit": "px", "default": 24 },
    { "type": "range", "id": "pad_bottom", "label": "Bottom padding", "min": 0, "max": 120, "step": 8, "unit": "px", "default": 80 }
  ],
  "blocks": [{ "type": "@app" }],
  "presets": [{ "name": "Smidgen · Reviews" }]
}
{% endschema %}
