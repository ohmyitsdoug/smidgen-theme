{%- liquid
  assign card_bg = blank
  if section.settings.card_bg_mode == 'custom'
    assign card_bg = section.settings.card_bg
  endif
-%}
{%- liquid
  assign s = section.settings
  if s.products != blank
    assign items = s.products
  elsif s.collection != blank
    assign items = s.collection.products
  else
    assign items = collections.all.products
  endif
  assign default_link = routes.all_products_collection_url
  if s.source == 'blog' and s.blog != blank
    assign default_link = s.blog.url
  endif
-%}
<section
  id="sm-{{ section.id }}"
  class="sm-section"
  style="--sm-bg: {{ s.bg }}; --sm-fg: {{ s.fg }};"
  {% if s.heading != blank %}aria-labelledby="sm-{{ section.id }}-title"{% endif %}
>
  {% render 'sm-doodle', shape: s.doodle, color: s.doodle_color, position: 'top-right', bg: section.settings.bg %}
  <div class="sm-container" style="--sm-pad-top: {{ s.pad_top }}px; --sm-pad-bottom: {{ s.pad_bottom }}px;">
    {%- if s.heading != blank or s.link_label != blank -%}
      <div style="display: flex; flex-wrap: wrap; align-items: flex-end; justify-content: space-between; gap: 16px;">
        {%- if s.heading != blank -%}
          <div>
            <h2 id="sm-{{ section.id }}-title" class="sm-display">{{ s.heading }}</h2>
            <svg width="220" height="22" viewBox="0 0 240 24" fill="none" aria-hidden="true" focusable="false"><path d="M6 14 C 30 2, 50 22, 78 12 S 128 2, 156 12 S 206 22, 234 10" stroke="#EA5D00" stroke-width="8" stroke-linecap="round"/></svg>
          </div>
        {%- endif -%}
        {%- if s.link_label != blank -%}
          <a class="sm-link" href="{{ s.link | default: default_link }}">{{ s.link_label }}</a>
        {%- endif -%}
      </div>
    {%- endif -%}

    <div class="sm-grid sm-grid--cards" style="--sm-min: {{ s.card_min }}px; --sm-max: {{ s.card_max }}px;">
      {%- if s.source == 'blog' -%}
        {%- for article in s.blog.articles limit: s.limit -%}
          {% render 'sm-article-card', article: article, image_fit: s.image_fit, bg: card_bg, more_label: s.article_label, show_date: s.show_date %}
        {%- else -%}
          <p>Pick a blog for this section in the theme editor.</p>
        {%- endfor -%}
      {%- else -%}
        {%- for product in items limit: s.limit -%}
          {% render 'sm-game-card', product: product, image_fit: s.image_fit, bg: card_bg, more_label: s.more_label, soon_label: s.soon_label %}
        {%- else -%}
          <p>Pick a collection or products for this section in the theme editor.</p>
        {%- endfor -%}
      {%- endif -%}
    </div>
  </div>
</section>
{%- if s.divider != 'none' -%}
  {% render 'sm-divider', shape: s.divider, from: s.bg, to: s.divider_to %}
{%- endif -%}

{% schema %}
