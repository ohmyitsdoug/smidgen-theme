{%- comment -%}
  "Play these next": related games as Smidgen game cards.
  Uses Shopify's product recommendations (loaded after the page renders).
  Until those arrive, or if Shopify has none, it shows games from the
  fallback collection, never including the current game.
{%- endcomment -%}
{%- liquid
  assign s = section.settings
  assign card_bg = blank
  if s.card_bg_mode == 'custom'
    assign card_bg = s.card_bg
  endif
  assign fallback = s.fallback.products | default: collections.all.products
  assign rec_url = routes.product_recommendations_url | append: '?section_id=' | append: section.id | append: '&product_id=' | append: product.id | append: '&limit=' | append: s.limit | append: '&intent=' | append: s.intent
-%}

{%- capture cards -%}
  {%- if recommendations.performed? -%}
    {%- for rec in recommendations.products -%}
      {% render 'sm-game-card', product: rec, image_fit: s.image_fit, bg: card_bg, more_label: s.more_label, soon_label: s.soon_label %}
    {%- endfor -%}
  {%- else -%}
    {%- assign shown = 0 -%}
    {%- for p in fallback -%}
      {%- if p.id == product.id or shown >= s.limit -%}{%- continue -%}{%- endif -%}
      {%- assign shown = shown | plus: 1 -%}
      {% render 'sm-game-card', product: p, image_fit: s.image_fit, bg: card_bg, more_label: s.more_label, soon_label: s.soon_label %}
    {%- endfor -%}
  {%- endif -%}
{%- endcapture -%}

{%- if cards != blank -%}
  {%- if s.divider_top != 'none' -%}
    {% render 'sm-divider', shape: s.divider_top, from: s.divider_from, to: s.bg %}
  {%- endif -%}
  <section
    id="sm-{{ section.id }}"
    class="sm-section"
    style="--sm-bg: {{ s.bg }}; --sm-fg: {{ s.fg }};"
    aria-labelledby="sm-{{ section.id }}-title"
  >
    {% render 'sm-corner-doodles', section: section %}
    {% render 'sm-doodle-blocks', section: section %}
    <div class="sm-container" style="--sm-pad-top: {{ s.pad_top }}px; --sm-pad-bottom: {{ s.pad_bottom }}px;">
      <h2 id="sm-{{ section.id }}-title" class="sm-display" style="font-size: clamp(2.2rem, 5vw, 3.2rem);">{{ s.heading }}</h2>
      <div class="sm-grid sm-grid--cards" style="--sm-min: 240px; --sm-max: {{ section.settings.card_max }}px;" data-sm-related data-url="{{ rec_url }}">
        {{ cards }}
      </div>
    </div>
  </section>

  {%- unless recommendations.performed? -%}
    <script>
      (function () {
        var grid = document.querySelector('#sm-{{ section.id }} [data-sm-related]');
        if (!grid || !window.fetch) return;
        fetch(grid.dataset.url)
          .then(function (r) { return r.text(); })
          .then(function (html) {
            var doc = new DOMParser().parseFromString(html, 'text/html');
            var fresh = doc.querySelector('[data-sm-related]');
            if (fresh && fresh.querySelector('.sm-card')) grid.innerHTML = fresh.innerHTML;
          })
          .catch(function () {});
      })();
    </script>
  {%- endunless -%}
{%- endif -%}

