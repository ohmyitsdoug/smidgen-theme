{%- comment -%}
  Blog landing page: a tilted "featured" card for the newest post, then
  Smidgen cards for the rest, with optional tag pills and pagination.
{%- endcomment -%}
{%- liquid
  assign s = section.settings
  assign card_bg = blank
  if s.card_bg_mode == 'custom'
    assign card_bg = s.card_bg
  endif
-%}
<section class="sm-section sm-blog" style="--sm-bg: {{ s.bg }}; --sm-fg: {{ s.fg }};{% render 'sm-btn-vars', s: s %}">
  {%- if s.show_pattern -%}{% render 'sm-pattern-bg', bg: s.bg, mode: s.pattern_mode, color: s.pattern_color, opacity: s.pattern_opacity, size: s.pattern_size, outline: s.pattern_outline, scroll: s.pattern_scroll %}{%- endif -%}
  {%- unless s.show_pattern -%}
  {% render 'sm-doodle', shape: section.settings.doodle, color: section.settings.doodle_color, position: 'top-right', bg: section.settings.bg %}
  {% render 'sm-doodle', shape: section.settings.doodle_2, color: section.settings.doodle_2_color, position: 'bottom-left', bg: section.settings.bg %}
  {%- endunless -%}
  {% render 'sm-doodle-blocks', section: section %}
  <div class="sm-container" style="--sm-pad-top: {{ s.pad_top }}px; --sm-pad-bottom: {{ s.pad_bottom }}px;">
    {%- if s.show_tags and blog.all_tags.size > 0 -%}
      <nav aria-label="Blog topics">
        <ul class="sm-pills">
          <li><a class="sm-pill" href="{{ blog.url }}" {% if current_tags == blank %}aria-current="page"{% endif %}>{{ s.all_label }}</a></li>
          {%- for tag in blog.all_tags -%}
            <li><a class="sm-pill" href="{{ blog.url }}/tagged/{{ tag | handle }}" {% if current_tags contains tag %}aria-current="page"{% endif %}>{{ tag }}</a></li>
          {%- endfor -%}
        </ul>
      </nav>
    {%- endif -%}

    {%- paginate blog.articles by s.per_page -%}
      {%- assign show_feature = false -%}
      {%- if s.feature_first and paginate.current_page == 1 and current_tags == blank and blog.articles.size > 0 -%}
        {%- assign show_feature = true -%}
      {%- endif -%}

      {%- if show_feature -%}
        {%- assign f = blog.articles.first -%}
        {%- assign f_excerpt = f.excerpt | default: f.content | strip_html | truncatewords: 40 -%}
        {%- assign f_alt = f.image.alt | default: f.title -%}
        <a href="{{ f.url }}" class="sm-blog__feature" style="--sm-tilt: {{ s.tilt }}deg; --sm-feature-color: {{ s.feature_color }};">
          <span class="sm-blog__feature-media">
            {%- if f.image -%}
              {{ f.image | image_url: width: 1400 | image_tag: alt: f_alt, loading: 'eager', fetchpriority: 'high', sizes: '(min-width: 990px) 640px, 92vw', widths: '600, 900, 1200, 1400' }}
            {%- endif -%}
          </span>
          <span class="sm-blog__feature-body">
            <span class="sm-sticker">{{ s.feature_label }}</span>
            <span class="sm-blog__feature-title">{{ f.title }}</span>
            {%- if f_excerpt != blank -%}<span class="sm-blog__feature-excerpt">{{ f_excerpt }}</span>{%- endif -%}
            {%- if s.show_date -%}<span class="sm-blog__date">{{ f.published_at | date: format: 'date' }}</span>{%- endif -%}
            <span class="sm-btn">{{ s.read_label }}</span>
          </span>
        </a>
      {%- endif -%}

      <div class="sm-grid sm-grid--cards" style="--sm-min: 260px; --sm-max: {{ s.card_max }}px;">
        {%- for article in blog.articles -%}
          {%- if show_feature and forloop.first -%}{%- continue -%}{%- endif -%}
          {% render 'sm-article-card', article: article, image_fit: s.image_fit, bg: card_bg, more_label: s.more_label, show_date: s.show_date %}
        {%- else -%}
          <p style="grid-column: 1 / -1; padding: 40px; text-align: center; border: 3px dashed #000; border-radius: 26px;">{{ s.empty_text }}</p>
        {%- endfor -%}
      </div>

      {%- if paginate.pages > 1 -%}
        <nav class="sm-pagination" aria-label="Pages">
          {%- if paginate.previous -%}<a href="{{ paginate.previous.url }}" aria-label="Previous page">←</a>{%- endif -%}
          {%- for part in paginate.parts -%}
            {%- if part.is_link -%}
              <a href="{{ part.url }}">{{ part.title }}</a>
            {%- else -%}
              <span {% if part.title == paginate.current_page %}class="is-current" aria-current="page"{% endif %}>{{ part.title }}</span>
            {%- endif -%}
          {%- endfor -%}
          {%- if paginate.next -%}<a href="{{ paginate.next.url }}" aria-label="Next page">→</a>{%- endif -%}
        </nav>
      {%- endif -%}
    {%- endpaginate -%}
  </div>
</section>

