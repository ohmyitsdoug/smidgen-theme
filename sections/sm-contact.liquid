{%- liquid
  assign s = section.settings
  assign form_id = 'sm-contact-' | append: section.id
  assign topics = s.topics | newline_to_br | split: '<br />'
-%}
{%- if s.divider_top != 'none' -%}
  {% render 'sm-divider', shape: s.divider_top, from: s.divider_from, to: s.bg %}
{%- endif -%}
<section
  id="{{ s.anchor | default: 'contact' }}"
  class="sm-section{% assign fg_b = s.fg | color_brightness %}{% if fg_b > 150 %} sm-on-dark{% endif %}"
  style="--sm-bg: {{ s.bg }}; --sm-fg: {{ s.fg }};{% render 'sm-btn-vars', s: s %}"
  aria-labelledby="sm-{{ section.id }}-title"
>
  <div class="sm-container" style="--sm-pad-top: {{ s.pad_top }}px; --sm-pad-bottom: {{ s.pad_bottom }}px;">
    <div style="display: flex; flex-wrap: wrap; gap: 48px;">
      <div style="flex: 1 1 320px; display: flex; flex-direction: column; gap: 16px;">
        <h2 id="sm-{{ section.id }}-title" class="sm-display">{{ s.heading }}</h2>
        {%- if s.text != blank -%}<div class="sm-rte">{{ s.text }}</div>{%- endif -%}
        {%- if s.email != blank -%}
          <p style="margin: 0; line-height: 1.7;">
            <strong>Email</strong><br>
            <a href="mailto:{{ s.email }}" style="color: {{ s.link_color }}; font-weight: 700;">{{ s.email }}</a>
          </p>
        {%- endif -%}
        {%- if s.extra != blank -%}<div class="sm-rte" style="font-size: 1rem;">{{ s.extra }}</div>{%- endif -%}
      </div>

      <div class="sm-box" style="flex: 1 1 520px; min-width: 0; box-shadow: var(--sm-shadow-lg); padding: clamp(20px, 4vw, 32px);">
        {%- form 'contact', id: form_id, class: 'sm-form' -%}
          {%- if form.posted_successfully? -%}
            <p class="sm-form-message" role="status">{{ s.success }}</p>
          {%- elsif form.errors -%}
            <div class="sm-form-message" role="alert">{{ form.errors | default_errors }}</div>
          {%- endif -%}
          <div class="sm-form__row">
            <label class="sm-field">
              <span class="sm-field__label">Name</span>
              <input type="text" name="contact[name]" autocomplete="name" placeholder="{{ s.ph_name }}" value="{{ form.name }}">
            </label>
            <label class="sm-field">
              <span class="sm-field__label">Email</span>
              <input type="email" name="contact[email]" autocomplete="email" placeholder="{{ s.ph_email }}" value="{{ form.email }}" required>
            </label>
          </div>
          <div class="sm-form__row">
            {%- if s.topics != blank -%}
              <label class="sm-field">
                <span class="sm-field__label">Topic</span>
                <select name="contact[topic]">
                  {%- for t in topics -%}
                    {%- assign topic = t | strip -%}
                    {%- if topic != blank -%}<option>{{ topic }}</option>{%- endif -%}
                  {%- endfor -%}
                </select>
              </label>
            {%- endif -%}
            {%- if s.show_order -%}
              <label class="sm-field">
                <span class="sm-field__label">Order # <small>(optional)</small></span>
                <input type="text" name="contact[order_number]" placeholder="{{ s.ph_order }}">
              </label>
            {%- endif -%}
          </div>
          <label class="sm-field">
            <span class="sm-field__label">Message</span>
            <textarea name="contact[body]" rows="7" placeholder="{{ s.ph_message }}" required>{{ form.body }}</textarea>
          </label>
          <button type="submit" class="sm-btn" style="align-self: flex-start;">{{ s.button_label }}</button>
        {%- endform -%}
      </div>
    </div>
  </div>
</section>
{%- if s.divider != 'none' -%}
  {% render 'sm-divider', shape: s.divider, from: s.bg, to: s.divider_to %}
{%- endif -%}

{% schema %}
{
  "name": "Smidgen · Contact form",
  "tag": "div",
  "settings": [
    {
      "type": "text",
      "id": "anchor",
      "label": "Link anchor",
      "default": "contact"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Contact us"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text",
      "default": "<p>We read every message and do our best to reply to everyone. We're a small team, so please give us a little time.</p><p>Game designer? <a href=\"#pitch\">See how to pitch us ↓</a></p>"
    },
    {
      "type": "text",
      "id": "email",
      "label": "Email address"
    },
    {
      "type": "richtext",
      "id": "extra",
      "label": "Extra info",
      "default": "<p><strong>Social</strong><br>@playsmidgen on Instagram, TikTok &amp; YouTube</p>"
    },
    {
      "type": "header",
      "content": "Form"
    },
    {
      "type": "textarea",
      "id": "topics",
      "label": "Topics (one per line)",
      "default": "An order\nRules question\nMissing piece\nWholesale\nPress or events\nSomething else"
    },
    {
      "type": "checkbox",
      "id": "show_order",
      "label": "Show order number field",
      "default": true
    },
    {
      "type": "text",
      "id": "ph_name",
      "label": "Name placeholder",
      "default": "Shawn Spencer"
    },
    {
      "type": "text",
      "id": "ph_email",
      "label": "Email placeholder",
      "default": "shawn@psych-santabarbara.example"
    },
    {
      "type": "text",
      "id": "ph_order",
      "label": "Order # placeholder",
      "default": "#1042"
    },
    {
      "type": "textarea",
      "id": "ph_message",
      "label": "Message placeholder",
      "default": "Hey! My dad, a very hard man to impress, absolutely loved CUNO at game night. Where can I grab a copy for my best friend, Ghee Buttersnaps (a.k.a. Gus)? He'd be all over it.\n\nPineapple-ly yours,\nShawn Spencer, Head Psychic"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Send message"
    },
    {
      "type": "text",
      "id": "success",
      "label": "Success message",
      "default": "Thanks! Your message is on its way. We'll get back to you as soon as we can."
    },
    {
      "type": "header",
      "content": "Buttons"
    },
    {
      "type": "paragraph",
      "content": "Leave empty for the standard purple button and white second button."
    },
    {
      "type": "color",
      "id": "btn_bg",
      "label": "Button color"
    },
    {
      "type": "color",
      "id": "btn_fg",
      "label": "Button text"
    },
    {
      "type": "color",
      "id": "btn2_bg",
      "label": "Second button color"
    },
    {
      "type": "color",
      "id": "btn2_fg",
      "label": "Second button text"
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "bg",
      "label": "Background",
      "default": "#753189"
    },
    {
      "type": "color",
      "id": "fg",
      "label": "Text",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "link_color",
      "label": "Link color",
      "default": "#FFF503"
    },
    {
      "type": "header",
      "content": "Divider above"
    },
    {
      "type": "select",
      "id": "divider_top",
      "label": "Shape",
      "options": [
        {
          "value": "none",
          "label": "None"
        },
        {
          "value": "wave",
          "label": "Wave"
        },
        {
          "value": "zigzag",
          "label": "Zigzag"
        },
        {
          "value": "scallop",
          "label": "Scallop"
        }
      ],
      "default": "zigzag"
    },
    {
      "type": "color",
      "id": "divider_from",
      "label": "Previous section color",
      "default": "#FFFFFF",
      "visible_if": "{{ section.settings.divider_top != 'none' }}"
    },
    {
      "type": "header",
      "content": "Divider below"
    },
    {
      "type": "select",
      "id": "divider",
      "label": "Shape",
      "options": [
        {
          "value": "none",
          "label": "None"
        },
        {
          "value": "wave",
          "label": "Wave"
        },
        {
          "value": "zigzag",
          "label": "Zigzag"
        },
        {
          "value": "scallop",
          "label": "Scallop"
        }
      ],
      "default": "wave"
    },
    {
      "type": "color",
      "id": "divider_to",
      "label": "Next section color",
      "default": "#FFF503",
      "visible_if": "{{ section.settings.divider != 'none' }}"
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "pad_top",
      "label": "Top padding",
      "min": 0,
      "max": 120,
      "step": 8,
      "unit": "px",
      "default": 48
    },
    {
      "type": "range",
      "id": "pad_bottom",
      "label": "Bottom padding",
      "min": 0,
      "max": 120,
      "step": 8,
      "unit": "px",
      "default": 72
    }
  ],
  "presets": [
    {
      "name": "Smidgen · Contact form"
    }
  ]
}
{% endschema %}
