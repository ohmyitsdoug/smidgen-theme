{%- liquid
  assign s = section.settings
  assign heading = s.heading | escape | newline_to_br
  if s.highlight != blank
    assign hl = s.highlight | escape
    assign highlight_markup = '<span class="sm-hl">' | append: hl | append: '</span>'
    assign heading = heading | replace: hl, highlight_markup
  endif
-%}
{%- liquid
  assign yt_id = blank
  if s.video_url != blank
    assign v = s.video_url | append: ''
    if v contains 'youtu.be/'
      assign yt_id = v | split: 'youtu.be/' | last | split: '?' | first
    elsif v contains 'v='
      assign yt_id = v | split: 'v=' | last | split: '&' | first
    elsif v contains '/shorts/'
      assign yt_id = v | split: '/shorts/' | last | split: '?' | first
    elsif v contains '/embed/'
      assign yt_id = v | split: '/embed/' | last | split: '?' | first
    endif
  endif
-%}
{%- assign poster_alt = s.poster.alt | default: s.heading | default: shop.name -%}
{%- assign bubble_alt = s.bubble_image.alt | default: 'Smidgen game box' -%}
<section
  id="sm-{{ section.id }}"
  class="sm-section sm-vhero"
  style="--sm-bg: {{ s.bg }}; --sm-fg: {{ s.fg }};{% render 'sm-btn-vars', s: s %} --vh-bubble: {{ s.bubble_color }}; --vh-tilt: {{ s.tilt }}deg;"
  aria-labelledby="sm-{{ section.id }}-title"
>
  {%- for block in section.blocks -%}
    {%- liquid
      assign b = block.settings
      assign scale = b.size | divided_by: 100.0
      assign d_style = 'left: ' | append: b.x | append: '%; top: ' | append: b.y | append: '%; transform: translate(-50%, -50%) rotate(' | append: b.rotate | append: 'deg) scale(' | append: scale | append: ');'
      assign d_class = ''
      if b.hide_mobile
        assign d_class = 'sm-doodle--hide-mobile'
      endif
    -%}
    {% render 'sm-doodle', shape: b.shape, color: b.color, style: d_style, extra_class: d_class, attrs: block.shopify_attributes, bg: section.settings.bg, outline: b.outline %}
  {%- endfor -%}
  <div class="sm-container" style="--sm-pad-top: {{ s.pad_top }}px; --sm-pad-bottom: {{ s.pad_bottom }}px;">
    <div class="sm-vhero__grid">
      <div class="sm-vhero__copy">
        {%- if s.eyebrow != blank -%}
          <span class="sm-sticker">{{ s.eyebrow }}</span>
        {%- endif -%}
        <{{ section.settings.heading_tag | default: 'h1' }} id="sm-{{ section.id }}-title" class="sm-display sm-display--xl" style="--sm-hl: {{ s.highlight_color }};">{{ heading }}</{{ section.settings.heading_tag | default: 'h1' }}>
        {%- if s.text != blank -%}
          <div class="sm-lede">{{ s.text }}</div>
        {%- endif -%}
        {%- if s.button_label != blank -%}
          <div class="sm-actions">
            <a class="sm-btn sm-btn--yellow" href="{{ s.button_link | default: routes.all_products_collection_url }}">{{ s.button_label }}</a>
          </div>
        {%- endif -%}
        {% render 'sm-store-rating', s: s %}
      </div>
      <div class="sm-vhero__stage">
        <div class="sm-vhero__screen" data-sm-vhero>
          {%- if s.video != blank -%}
            {{ s.video | video_tag: autoplay: true, loop: true, muted: true, playsinline: true, controls: false, preload: 'metadata', image_size: '1200x', class: 'sm-vhero__media' }}
            <button type="button" class="sm-vhero__play" data-sm-vhero-sound aria-label="Play with sound"><svg width="40" height="40" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M8 5v14l11-7z" fill="currentColor"/></svg></button>
          {%- elsif yt_id != blank -%}
            {%- if s.poster != blank -%}
              {{ s.poster | image_url: width: 1400 | image_tag: alt: '', loading: 'eager', class: 'sm-vhero__media', sizes: '(min-width: 990px) 700px, 92vw' }}
            {%- else -%}
              <img class="sm-vhero__media" src="https://i.ytimg.com/vi/{{ yt_id }}/hqdefault.jpg" alt="" loading="eager" width="480" height="360">
            {%- endif -%}
            <button type="button" class="sm-vhero__play" data-sm-vhero-yt="{{ yt_id }}" aria-label="Play video"><svg width="40" height="40" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M8 5v14l11-7z" fill="currentColor"/></svg></button>
          {%- elsif s.poster != blank -%}
            {{ s.poster | image_url: width: 1400 | image_tag: alt: poster_alt, loading: 'eager', class: 'sm-vhero__media', sizes: '(min-width: 990px) 700px, 92vw' }}
          {%- elsif request.design_mode -%}
            <span class="sm-vhero__hint">Add a Shopify video or a YouTube link in this section's settings.</span>
          {%- endif -%}
        </div>
        {%- if s.bubble_image != blank -%}
          {%- if s.bubble_link != blank -%}<a href="{{ s.bubble_link }}" class="sm-vhero__bubble">{%- else -%}<span class="sm-vhero__bubble">{%- endif -%}
            {%- assign b_focal = s.bubble_image.presentation.focal_point | default: '50% 50%' -%}
            {%- assign b_style = 'object-position: ' | append: b_focal -%}
            {{ s.bubble_image | image_url: width: 800 | image_tag: alt: bubble_alt, loading: 'eager', sizes: '(min-width: 750px) 240px, 34vw', style: b_style }}
          {%- if s.bubble_link != blank -%}</a>{%- else -%}</span>{%- endif -%}
          {%- if s.show_arrow -%}
            <svg class="sm-vhero__arrow" viewBox="0 0 190 90" fill="none" aria-hidden="true" focusable="false"><path d="M10 70 C 30 30, 60 18, 82 34 C 98 46, 84 64, 70 56 C 56 48, 74 22, 108 24 C 140 26, 160 42, 176 64" stroke="currentColor" stroke-width="6" stroke-linecap="round"/><path d="M156 62 L178 68 L174 46" stroke="currentColor" stroke-width="6" stroke-linecap="round" stroke-linejoin="round"/></svg>
          {%- endif -%}
        {%- endif -%}
        {%- if s.tag != blank -%}
          <span class="sm-vhero__tag">{{ s.tag }}</span>
        {%- endif -%}
      </div>
    </div>
  </div>
  <script>
    (function () {
      var root = document.getElementById('sm-{{ section.id }}');
      if (!root) return;
      var yt = root.querySelector('[data-sm-vhero-yt]');
      if (yt) yt.addEventListener('click', function () {
        var screen = yt.closest('[data-sm-vhero]');
        var f = document.createElement('iframe');
        f.src = 'https://www.youtube-nocookie.com/embed/' + yt.getAttribute('data-sm-vhero-yt') + '?autoplay=1&rel=0&playsinline=1';
        f.title = 'Video';
        f.allow = 'autoplay; encrypted-media; picture-in-picture; fullscreen';
        f.allowFullscreen = true;
        f.className = 'sm-vhero__media';
        screen.innerHTML = '';
        screen.appendChild(f);
      });
      var snd = root.querySelector('[data-sm-vhero-sound]');
      if (snd) snd.addEventListener('click', function () {
        var vid = root.querySelector('video');
        if (!vid) return;
        vid.muted = false; vid.controls = true; vid.currentTime = 0; vid.play();
        snd.remove();
      });
    })();
  </script>
</section>
{%- if s.divider != 'none' -%}
  {% render 'sm-divider', shape: s.divider, from: s.bg, to: s.divider_to %}
{%- endif -%}

