{%- comment -%}
  "What's in the box" for product pages. Reads `smidgen.components`
  (list of single-line text). Hidden when the list is empty.
{%- endcomment -%}
{%- liquid
  assign s = section.settings
  assign items = product.metafields.smidgen.components.value
  assign count = 0
  for item in items
    if item != blank
      assign count = count | plus: 1
    endif
  endfor
-%}
{%- if count > 0 -%}
  <section
    id="in-the-box"
    class="sm-section"
    style="--sm-bg: {{ s.bg }}; --sm-fg: {{ s.fg }};"
    aria-labelledby="sm-{{ section.id }}-title"
  >
    <div class="sm-container sm-container--narrow" style="--sm-pad-top: {{ s.pad_top }}px; --sm-pad-bottom: {{ s.pad_bottom }}px;">
      <h2 id="sm-{{ section.id }}-title" class="sm-display" style="font-size: clamp(2.2rem, 5vw, 3rem);">
        {{- s.heading -}}
      </h2>
      <ul class="sm-checklist sm-box" style="box-shadow: 6px 6px 0 var(--sm-blue);">
        {%- for item in items -%}
          {%- if item != blank -%}<li>{{ item }}</li>{%- endif -%}
        {%- endfor -%}
      </ul>
    </div>
  </section>
{%- endif -%}

{% schema %}
{
  "name": "Smidgen · What's in the box",
  "tag": "div",
  "enabled_on": { "templates": ["product"] },
  "settings": [
    { "type": "paragraph", "content": "Uses each game's components field. Hidden on games without one." },
    { "type": "text", "id": "heading", "label": "Heading", "default": "What's in the box" },
    { "type": "color", "id": "bg", "label": "Background", "default": "#FFFFFF" },
    { "type": "color", "id": "fg", "label": "Text", "default": "#000000" },
    { "type": "range", "id": "pad_top", "label": "Top padding", "min": 0, "max": 120, "step": 8, "unit": "px", "default": 48 },
    { "type": "range", "id": "pad_bottom", "label": "Bottom padding", "min": 0, "max": 120, "step": 8, "unit": "px", "default": 24 }
  ],
  "presets": [{ "name": "Smidgen · What's in the box" }]
}
{% endschema %}
