{%- comment -%}
  "What's in the box" for product pages. Reads `smidgen.components`
  (list of single-line text). Hidden when the list is empty.
{%- endcomment -%}
{%- liquid
  assign s = section.settings
  assign cf = s.components_field | default: 'smidgen.components' | strip | split: '.'
  assign field = product.metafields[cf[0]][cf[1]]
  if field.type contains 'list.'
    assign items = field.value
  else
    assign items = field.value | newline_to_br | split: '<br />'
  endif
  assign count = 0
  for item in items
    assign item_text = item | strip
    if item_text != blank
      assign count = count | plus: 1
    endif
  endfor
-%}
{%- if count > 0 -%}
  <section
    id="in-the-box"
    class="sm-section"
    style="--sm-bg: {{ s.bg }}; --sm-fg: {{ s.fg }};"
    aria-labelledby="sm-{{ section.id }}-title"
  >
    <div class="sm-container sm-container--narrow" style="--sm-pad-top: {{ s.pad_top }}px; --sm-pad-bottom: {{ s.pad_bottom }}px;">
      <h2 id="sm-{{ section.id }}-title" class="sm-display" style="font-size: clamp(2.2rem, 5vw, 3rem);">
        {{- s.heading -}}
      </h2>
      <ul class="sm-checklist sm-box" style="box-shadow: 6px 6px 0 var(--sm-blue);">
        {%- for item in items -%}
          {%- assign item_text = item | strip -%}
          {%- if item_text != blank -%}<li>{{ item_text }}</li>{%- endif -%}
        {%- endfor -%}
      </ul>
    </div>
  </section>
{%- elsif request.design_mode -%}
  <div class="sm-container sm-container--narrow" style="--sm-pad-top: 24px; --sm-pad-bottom: 24px;">
    <p style="margin: 0; padding: 20px; border: 3px dashed #000; border-radius: 20px; font-family: var(--sm-font-body);">
      <strong>What's in the box is hidden on this product</strong> (only you can see this note).
      Fill in the product field {{ s.components_field | default: 'smidgen.components' }}: a list of text, or one item per line.
    </p>
  </div>
{%- endif -%}

{% schema %}
{
  "name": "Smidgen · In the box",
  "tag": "div",
  "enabled_on": {
    "templates": [
      "product"
    ]
  },
  "settings": [
    {
      "type": "paragraph",
      "content": "Uses each game's components field. Hidden on games without one."
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "What's in the box"
    },
    {
      "type": "text",
      "id": "components_field",
      "label": "Components field",
      "default": "smidgen.components",
      "info": "Type the field's key (e.g. custom.components), not the items. namespace.key of a product field: a text list, or multi-line text with one item per line"
    },
    {
      "type": "color",
      "id": "bg",
      "label": "Background",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "fg",
      "label": "Text",
      "default": "#000000"
    },
    {
      "type": "range",
      "id": "pad_top",
      "label": "Top padding",
      "min": 0,
      "max": 120,
      "step": 8,
      "unit": "px",
      "default": 48
    },
    {
      "type": "range",
      "id": "pad_bottom",
      "label": "Bottom padding",
      "min": 0,
      "max": 120,
      "step": 8,
      "unit": "px",
      "default": 24
    }
  ],
  "presets": [
    {
      "name": "Smidgen · In the box"
    }
  ]
}
{% endschema %}
