{%- comment -%}
  "What's in the box" for product pages. Reads `smidgen.components`
  (list of single-line text). Hidden when the list is empty.
{%- endcomment -%}
{%- liquid
  assign s = section.settings
  assign cf = s.components_field | default: 'smidgen.components' | strip | split: '.'
  assign field = product.metafields[cf[0]][cf[1]]
  if field.type contains 'list.'
    assign items = field.value
  else
    assign items = field.value | newline_to_br | split: '<br />'
  endif
  assign count = 0
  for item in items
    assign item_text = item | strip
    if item_text != blank
      assign count = count | plus: 1
    endif
  endfor
-%}
{%- if count > 0 -%}
  <section
    id="in-the-box"
    class="sm-section"
    style="--sm-bg: {{ s.bg }}; --sm-fg: {{ s.fg }};"
    aria-labelledby="sm-{{ section.id }}-title"
  >
    {% render 'sm-doodle-blocks', section: section %}
    <div class="sm-container sm-container--narrow" style="--sm-pad-top: {{ s.pad_top }}px; --sm-pad-bottom: {{ s.pad_bottom }}px;">
      <h2 id="sm-{{ section.id }}-title" class="sm-display" style="font-size: clamp(2.2rem, 5vw, 3rem);">
        {{- s.heading -}}
      </h2>
      <ul class="sm-checklist sm-box" style="box-shadow: var(--sm-shadow);">
        {%- for item in items -%}
          {%- assign item_text = item | strip -%}
          {%- if item_text != blank -%}<li>{{ item_text }}</li>{%- endif -%}
        {%- endfor -%}
      </ul>
    </div>
  </section>
{%- elsif request.design_mode -%}
  <div class="sm-container sm-container--narrow" style="--sm-pad-top: 24px; --sm-pad-bottom: 24px;">
    <p style="margin: 0; padding: 20px; border: 3px dashed #000; border-radius: 20px; font-family: var(--sm-font-body);">
      <strong>What's in the box is hidden on this product</strong> (only you can see this note).
      Fill in the product field {{ s.components_field | default: 'smidgen.components' }}: a list of text, or one item per line.
    </p>
  </div>
{%- endif -%}

