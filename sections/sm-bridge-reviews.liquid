{%- comment -%}
  Bridge page reviews: the product's rating from your own site (Judge.me),
  clearly labelled with where it comes from, an optional separate Amazon
  rating, and a stack of hand-picked review quotes, each tagged with its source.
{%- endcomment -%}
{%- liquid
  assign s = section.settings
  assign p = product
  assign rating = p.metafields.reviews.rating.value
  assign rating_count = p.metafields.reviews.rating_count.value | default: 0
  assign quote_count = 0
  for block in section.blocks
    if block.type == 'quote' and block.settings.quote != blank
      assign quote_count = quote_count | plus: 1
    endif
  endfor
  assign show = true
  if rating_count == 0 and quote_count == 0
    assign show = false
  endif
-%}
{%- if show or request.design_mode -%}
<section class="sm-section sm-breviews" style="--sm-bg: {{ s.bg }}; --sm-fg: {{ s.fg }};" aria-labelledby="sm-{{ section.id }}-title">
  {% render 'sm-corner-doodles', section: section %}
  {% render 'sm-doodle-blocks', section: section %}
  <div class="sm-container sm-container--narrow" style="--sm-pad-top: {{ s.pad_top }}px; --sm-pad-bottom: {{ s.pad_bottom }}px; align-items: center;">
    <h2 id="sm-{{ section.id }}-title" class="sm-display" style="font-size: clamp(2.2rem, 6vw, 3rem); text-align: center;">{{ s.heading }}</h2>

    {%- if rating_count > 0 -%}
      <div class="sm-breviews__summary">
        <p class="sm-breviews__score">{{ rating.rating | round: 1 }}</p>
        {%- assign full = rating.rating | round -%}
        <p class="sm-breviews__stars" aria-label="{{ rating.rating | round: 1 }} out of 5 stars">
          {%- for i in (1..5) -%}<span aria-hidden="true"{% if i > full %} class="is-off"{% endif %}>★</span>{%- endfor -%}
        </p>
        <p class="sm-breviews__source">{{ s.site_text | replace: '[count]', rating_count }}</p>
        {%- if s.amazon_rating != blank and s.amazon_count != blank -%}
          <p class="sm-breviews__amazon">{{ s.amazon_text | replace: '[rating]', s.amazon_rating | replace: '[count]', s.amazon_count }}</p>
        {%- endif -%}
      </div>
    {%- endif -%}

    {%- if quote_count > 0 -%}
      <div class="sm-breviews__stack">
        {%- assign n = 0 -%}
        {%- for block in section.blocks -%}
          {%- if block.type != 'quote' or block.settings.quote == blank -%}{%- continue -%}{%- endif -%}
          {%- assign n = n | plus: 1 -%}
          {%- assign b = block.settings -%}
          <figure class="sm-breviews__card sm-breviews__card--{{ n | modulo: 3 }}" {{ block.shopify_attributes }}>
            <p class="sm-breviews__card-stars" aria-label="{{ b.stars }} out of 5 stars">
              {%- for i in (1..5) -%}<span aria-hidden="true"{% if i > b.stars %} class="is-off"{% endif %}>★</span>{%- endfor -%}
            </p>
            <blockquote>“{{ b.quote }}”</blockquote>
            <figcaption>
              {%- if b.name != blank -%}<strong>{{ b.name }}</strong>{%- endif -%}
              {%- case b.source -%}
                {%- when 'site' -%}<span>Verified buyer · playsmidgen.com</span>
                {%- when 'amazon' -%}<span>Amazon review</span>
                {%- else -%}{%- if b.source_text != blank -%}<span>{{ b.source_text }}</span>{%- endif -%}
              {%- endcase -%}
            </figcaption>
          </figure>
        {%- endfor -%}
      </div>
    {%- elsif request.design_mode -%}
      <p class="sm-bridge-note">Add Review quote blocks: paste real reviews and pick where each one is from.</p>
    {%- endif -%}

    {%- if s.show_all_link and rating_count > 0 -%}
      <a href="{{ p.url }}#reviews" style="font-weight: 700;">Read all {{ rating_count }} reviews</a>
    {%- endif -%}
  </div>
</section>
{%- endif -%}

