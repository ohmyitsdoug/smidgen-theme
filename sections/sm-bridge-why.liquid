{%- comment -%}
  "Why Amazon?" strip for bridge pages: a heading and up to six icon + label items.
{%- endcomment -%}
{%- assign s = section.settings -%}
<section class="sm-section sm-bwhy" style="--sm-bg: {{ s.bg }}; --sm-fg: {{ s.fg }};{% if s.border %} border-top: 3px solid #000; border-bottom: 3px solid #000;{% endif %}">
  {% render 'sm-corner-doodles', section: section %}
  {% render 'sm-doodle-blocks', section: section %}
  <div class="sm-container" style="--sm-pad-top: {{ s.pad_top }}px; --sm-pad-bottom: {{ s.pad_bottom }}px; align-items: center;">
    {%- if s.heading != blank -%}<h2 class="sm-display" style="font-size: clamp(2rem, 5vw, 2.6rem); text-align: center;">{{ s.heading }}</h2>{%- endif -%}
    <ul class="sm-bwhy__list">
      {%- for block in section.blocks -%}
        {%- if block.type != 'item' or block.settings.label == blank -%}{%- continue -%}{%- endif -%}
        <li {{ block.shopify_attributes }}>
          <span class="sm-bwhy__icon" style="background: {{ block.settings.color }};">{% render 'sm-icon', name: block.settings.icon_name, size: 28 %}</span>
          <span class="sm-bwhy__label">{{ block.settings.label }}</span>
        </li>
      {%- endfor -%}
    </ul>
  </div>
</section>

