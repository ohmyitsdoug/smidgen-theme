{%- liquid
  assign s = section.settings
  assign p = s.product
  assign title = s.title | default: p.title
  assign text = s.text
  if text == blank and p != blank
    assign text = p.metafields.smidgen.hook.value | default: p.metafields.custom.hook.value | default: p.metafields.descriptors.subtitle.value
  endif
-%}
<section
  id="sm-{{ section.id }}"
  class="sm-section"
  style="--sm-bg: {{ s.bg }}; --sm-fg: {{ s.fg }};"
  aria-labelledby="sm-{{ section.id }}-title"
>
  <div class="sm-container" style="--sm-pad-top: {{ s.pad_top }}px; --sm-pad-bottom: {{ s.pad_bottom }}px;">
    <div class="sm-split" {% if s.image_side == 'right' %}style="flex-direction: row-reverse;"{% endif %}>
      <div style="display: flex; justify-content: center;">
        {%- if s.image != blank -%}
          {{ s.image | image_url: width: 1000 | image_tag: alt: s.image.alt, loading: 'lazy', sizes: '(min-width: 900px) 520px, 90vw', style: 'width: 100%; max-width: 520px; height: auto; border: var(--sm-outline); border-radius: 32px; box-shadow: var(--sm-shadow-lg); transform: rotate(-2deg);' }}
        {%- elsif p.featured_media -%}
          {{ p.featured_media | image_url: width: 900 | image_tag: alt: p.title, loading: 'lazy', sizes: '(min-width: 900px) 440px, 80vw', style: 'width: 80%; max-width: 440px; height: auto; transform: rotate(-4deg); filter: drop-shadow(10px 12px 0 #000);' }}
        {%- endif -%}
      </div>
      <div style="display: flex; flex-direction: column; align-items: flex-start; gap: 18px;">
        {%- if s.eyebrow != blank -%}
          <span class="sm-badge">{{ s.eyebrow }}</span>
        {%- endif -%}
        <h2
          id="sm-{{ section.id }}-title"
          class="sm-game-title{% if s.outlined %} sm-game-title--outlined{% endif %}"
        >
          {{ title }}
        </h2>
        {%- if text != blank -%}
          <p class="sm-lede" style="font-weight: 500;">{{ text }}</p>
        {%- endif -%}
        {%- if s.button_label != blank -%}
          <a class="sm-btn" href="{{ s.button_link | default: p.url }}">{{ s.button_label }}</a>
        {%- endif -%}
      </div>
    </div>
  </div>
</section>
{%- if s.divider != 'none' -%}
  {% render 'sm-divider', shape: s.divider, from: s.bg, to: s.divider_to %}
{%- endif -%}

{% schema %}
{
  "name": "Smidgen · Game spotlight",
  "tag": "div",
  "settings": [
    { "type": "product", "id": "product", "label": "Game" },
    { "type": "text", "id": "eyebrow", "label": "Badge", "default": "Now on preorder" },
    { "type": "text", "id": "title", "label": "Title", "info": "Leave empty to use the game name." },
    { "type": "checkbox", "id": "outlined", "label": "Outlined title", "default": true },
    { "type": "text", "id": "text", "label": "Text", "info": "Leave empty to use the game's hook field." },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "See the game" },
    { "type": "url", "id": "button_link", "label": "Button link" },
    { "type": "image_picker", "id": "image", "label": "Lifestyle image", "info": "Optional. Falls back to the game's main image." },
    {
      "type": "select", "id": "image_side", "label": "Image side",
      "options": [{ "value": "left", "label": "Left" }, { "value": "right", "label": "Right" }],
      "default": "left"
    },
    { "type": "header", "content": "Colors" },
    { "type": "color", "id": "bg", "label": "Background", "default": "#EA5D00" },
    { "type": "color", "id": "fg", "label": "Text", "default": "#000000" },
    { "type": "header", "content": "Divider below" },
    {
      "type": "select", "id": "divider", "label": "Shape",
      "options": [
        { "value": "none", "label": "None" }, { "value": "wave", "label": "Wave" },
        { "value": "zigzag", "label": "Zigzag" }, { "value": "scallop", "label": "Scallop" },
        { "value": "straight", "label": "Straight line" }
      ],
      "default": "scallop"
    },
    { "type": "color", "id": "divider_to", "label": "Next section color", "default": "#FFFFFF", "visible_if": "{{ section.settings.divider != 'none' }}" },
    { "type": "header", "content": "Spacing" },
    { "type": "range", "id": "pad_top", "label": "Top padding", "min": 0, "max": 120, "step": 8, "unit": "px", "default": 56 },
    { "type": "range", "id": "pad_bottom", "label": "Bottom padding", "min": 0, "max": 120, "step": 8, "unit": "px", "default": 88 }
  ],
  "presets": [{ "name": "Smidgen · Game spotlight" }]
}
{% endschema %}
