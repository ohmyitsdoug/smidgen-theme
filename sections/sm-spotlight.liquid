{%- liquid
  assign s = section.settings
  assign p = s.product
  assign title = s.title | default: p.title
  assign text = s.text
  if text == blank and p != blank
    assign text = p.metafields.smidgen.hook.value | default: p.metafields.custom.hook.value | default: p.metafields.descriptors.subtitle.value
  endif
-%}
<section
  id="sm-{{ section.id }}"
  class="sm-section"
  style="--sm-bg: {{ s.bg }}; --sm-fg: {{ s.fg }};{% render 'sm-btn-vars', s: s %}"
  aria-labelledby="sm-{{ section.id }}-title"
>
  {% render 'sm-doodle-blocks', section: section %}
  <div class="sm-container" style="--sm-pad-top: {{ s.pad_top }}px; --sm-pad-bottom: {{ s.pad_bottom }}px;">
    <div class="sm-split" {% if s.image_side == 'right' %}style="flex-direction: row-reverse;"{% endif %}>
      <div style="display: flex; justify-content: center;">
        {%- assign img_alt = s.image.alt | default: title | default: shop.name -%}{%- if s.image != blank -%}
          {{ s.image | image_url: width: 1000 | image_tag: alt: img_alt, loading: 'lazy', sizes: '(min-width: 900px) 520px, 90vw', style: 'width: 100%; max-width: 520px; height: auto; border: var(--sm-outline); border-radius: 32px; box-shadow: var(--sm-shadow-lg); transform: rotate(-2deg);' }}
        {%- elsif p.featured_media -%}
          {{ p.featured_media | image_url: width: 900 | image_tag: alt: p.title, loading: 'lazy', sizes: '(min-width: 900px) 440px, 80vw', style: 'width: 80%; max-width: 440px; height: auto; transform: rotate(-4deg); filter: drop-shadow(10px 12px 0 #000);' }}
        {%- endif -%}
      </div>
      <div style="display: flex; flex-direction: column; align-items: flex-start; gap: 18px;">
        {%- if s.eyebrow != blank -%}
          <span class="sm-badge">{{ s.eyebrow }}</span>
        {%- endif -%}
        <h2
          id="sm-{{ section.id }}-title"
          class="sm-game-title{% if s.outlined %} sm-game-title--outlined{% endif %}"
        >
          {{ title }}
        </h2>
        {%- if text != blank -%}
          <p class="sm-lede" style="font-weight: 500;">{{ text }}</p>
        {%- endif -%}
        {%- if s.button_label != blank -%}
          <a class="sm-btn" href="{{ s.button_link | default: p.url }}">{{ s.button_label }}</a>
        {%- endif -%}
      </div>
    </div>
  </div>
</section>
{%- if s.divider != 'none' -%}
  {% render 'sm-divider', shape: s.divider, from: s.bg, to: s.divider_to %}
{%- endif -%}

{% schema %}
