      </div>

        {%- if s.image_2 != blank -%}
          <span class="sm-sun__side sm-sun__side--left{% if s.side_style == 'card' %} sm-sun__side--card{% endif %}">{{ s.image_2 | image_url: width: 600 | image_tag: alt: s.image_2.alt, loading: 'eager', sizes: '240px' }}</span>
        {%- endif -%}
        {%- if s.image_1 != blank -%}
          <span class="sm-sun__main">{{ s.image_1 | image_url: width: 900 | image_tag: alt: s.image_1.alt, loading: 'eager', fetchpriority: 'high', sizes: '(min-width: 750px) 360px, 45vw' }}</span>
        {%- endif -%}
        {%- if s.image_3 != blank -%}
          <span class="sm-sun__side sm-sun__side--right{% if s.side_style == 'card' %} sm-sun__side--card{% endif %}">{{ s.image_3 | image_url: width: 600 | image_tag: alt: s.image_3.alt, loading: 'eager', sizes: '240px' }}</span>
        {%- endif -%}
      {%- if s.image_1 == blank and s.image_2 == blank and s.image_3 == blank and request.design_mode -%}
        <p class="sm-sun__hint">Add up to three images in this section's settings (center + two sides).</p>
      {%- endif -%}
    </div>
  </div>
  {%- if s.show_sticker and s.sticker_big != blank -%}
    {%- if s.sticker_link != blank -%}<a href="{{ s.sticker_link }}" class="sm-sun__sticker" style="--st-bg: {{ s.sticker_color }};">{%- else -%}<span class="sm-sun__sticker" style="--st-bg: {{ s.sticker_color }};">{%- endif -%}
      {%- if s.sticker_small != blank -%}<span class="sm-sun__sticker-small">{{ s.sticker_small }}</span>{%- endif -%}
      <span class="sm-sun__sticker-big">{{ s.sticker_big }}</span>
    {%- if s.sticker_link != blank -%}</a>{%- else -%}</span>{%- endif -%}
  {%- endif -%}
</section>
{%- if s.divider != 'none' -%}
  {% render 'sm-divider', shape: s.divider, from: s.bg, to: s.divider_to %}
{%- endif -%}

{% schema %}
{
  "name": "Smidgen · Hero Rising Sun",
  "tag": "div",
  "class": "sm-hero-sun-section",
  "settings": [
    {
      "type": "header",
      "content": "Text"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Sticker",
      "default": "Holiday promo"
    },
    {
      "type": "textarea",
      "id": "heading",
      "label": "Heading",
      "default": "Three games. One bundle. Save 20%."
    },
    {
      "type": "text",
      "id": "highlight",
      "label": "Highlighted words",
      "default": "Save 20%.",
      "info": "Words from the heading to color"
    },
    {
      "type": "color",
      "id": "highlight_color",
      "label": "Highlight color",
      "default": "#EA5D00"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text",
      "default": "<p>A game for every mood: strategy, bluffing and teamwork.</p>"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button",
      "default": "Get the bundle"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    },
    {
      "type": "header",
      "content": "Review score"
    },
    {
      "type": "checkbox",
      "id": "show_rating",
      "label": "Show store review score",
      "default": true,
      "info": "Judge.me total for the whole store"
    },
    {
      "type": "text",
      "id": "rating_text",
      "label": "Review score text",
      "default": "★★★★★ [rating] from [count] reviews",
      "info": "[rating] and [count] fill in automatically."
    },
    {
      "type": "url",
      "id": "rating_link",
      "label": "Review score link"
    },
    {
      "type": "text",
      "id": "rating_override",
      "label": "Rating override",
      "info": "Optional, e.g. 4.9"
    },
    {
      "type": "text",
      "id": "count_override",
      "label": "Review count override",
      "info": "Optional, e.g. 120"
    },
    {
      "type": "text",
      "id": "small_print",
      "label": "Small print",
      "info": "Extra text after the review score"
    },
    {
      "type": "header",
      "content": "Images"
    },
    {
      "type": "image_picker",
      "id": "image_1",
      "label": "Center image",
      "info": "Biggest. A transparent PNG of a game box works best."
    },
    {
      "type": "image_picker",
      "id": "image_2",
      "label": "Left image"
    },
    {
      "type": "image_picker",
      "id": "image_3",
      "label": "Right image"
    },
    {
      "type": "select",
      "id": "side_style",
      "label": "Side images",
      "options": [
        {
          "value": "cutout",
          "label": "Cutout (no frame)"
        },
        {
          "value": "card",
          "label": "White card with outline"
        }
      ],
      "default": "cutout"
    },
    {
      "type": "header",
      "content": "Sticker"
    },
    {
      "type": "checkbox",
      "id": "show_sticker",
      "label": "Show sticker",
      "default": true
    },
    {
      "type": "text",
      "id": "sticker_small",
      "label": "Small text",
      "default": "save"
    },
    {
      "type": "text",
      "id": "sticker_big",
      "label": "Big text",
      "default": "20%"
    },
    {
      "type": "color",
      "id": "sticker_color",
      "label": "Sticker color",
      "default": "#EA5D00"
    },
    {
      "type": "url",
      "id": "sticker_link",
      "label": "Sticker link"
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "bg",
      "label": "Background",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "fg",
      "label": "Text",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "sun_color",
      "label": "Half circle",
      "default": "#753189"
    },
    {
      "type": "color",
      "id": "ring_color",
      "label": "Wobbly ring",
      "default": "#FFF503"
    },
    {
      "type": "range",
      "id": "sun_offset",
      "label": "Circle top (from images)",
      "min": -100,
      "max": 200,
      "step": 10,
      "unit": "px",
      "default": 60,
      "info": "Higher = the circle and ring start lower, away from the text."
    },
    {
      "type": "range",
      "id": "pad_top",
      "label": "Top padding",
      "min": 0,
      "max": 120,
      "step": 8,
      "default": 64,
      "unit": "px"
    },
    {
      "type": "header",
      "content": "Divider below"
    },
    {
      "type": "select",
      "id": "divider",
      "label": "Shape",
      "options": [
        {
          "value": "none",
          "label": "None"
        },
        {
          "value": "wave",
          "label": "Wave"
        },
        {
          "value": "zigzag",
          "label": "Zigzag"
        },
        {
          "value": "scallop",
          "label": "Scallop"
        },
        {
          "value": "straight",
          "label": "Straight line"
        }
      ],
      "default": "none"
    },
    {
      "type": "color",
      "id": "divider_to",
      "label": "Next section color",
      "default": "#FFFFFF",
      "visible_if": "{{ section.settings.divider != 'none' }}"
    }
  ],
  "presets": [
    {
      "name": "Smidgen · Hero Rising Sun",
      "blocks": [
        {
          "type": "doodle",
          "settings": {
            "shape": "ring",
            "color": "#20A4F3",
            "x": 9,
            "y": 20,
            "size": 100,
            "rotate": 0
          }
        },
        {
          "type": "doodle",
          "settings": {
            "shape": "squiggle",
            "color": "#EA5D00",
            "x": 90,
            "y": 14,
            "size": 100,
            "rotate": 0
          }
        }
      ]
    }
  ],
  "blocks": [
    {
      "type": "doodle",
      "name": "Doodle",
      "settings": [
        {
          "type": "select",
          "id": "shape",
          "label": "Shape",
          "options": [
            {
              "value": "squiggle",
              "label": "Squiggle"
            },
            {
              "value": "spiral",
              "label": "Spiral"
            },
            {
              "value": "zigzag",
              "label": "Zigzag"
            },
            {
              "value": "star",
              "label": "Star"
            },
            {
              "value": "loop-arrow",
              "label": "Loop arrow"
            },
            {
              "value": "dot",
              "label": "Dot"
            },
            {
              "value": "ring",
              "label": "Ring"
            },
            {
              "value": "triangle",
              "label": "Triangle"
            },
            {
              "value": "plus",
              "label": "Plus"
            },
            {
              "value": "tile",
              "label": "Tile"
            }
          ],
          "default": "star"
        },
        {
          "type": "color",
          "id": "color",
          "label": "Color",
          "default": "#20A4F3"
        },
        {
          "type": "range",
          "id": "x",
          "label": "Left to right",
          "min": 0,
          "max": 100,
          "step": 1,
          "unit": "%",
          "default": 50
        },
        {
          "type": "range",
          "id": "y",
          "label": "Top to bottom",
          "min": 0,
          "max": 100,
          "step": 1,
          "unit": "%",
          "default": 20
        },
        {
          "type": "range",
          "id": "size",
          "label": "Size",
          "min": 30,
          "max": 250,
          "step": 10,
          "unit": "%",
          "default": 100
        },
        {
          "type": "range",
          "id": "rotate",
          "label": "Rotation",
          "min": -180,
          "max": 180,
          "step": 5,
          "unit": "deg",
          "default": 0
        },
        {
          "type": "checkbox",
          "id": "hide_mobile",
          "label": "Hide on phones",
          "default": false
        }
      ]
    }
  ],
  "max_blocks": 12
}
{% endschema %}
