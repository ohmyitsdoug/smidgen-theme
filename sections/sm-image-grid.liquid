{%- comment -%}
  Image grid: a big "lab notebook" featured photo (thick frame, hard shadow,
  tape strip, slight tilt) with up to three smaller framed photos below.
  Images come from a product's media (the page's product, or one picked here),
  or from the image pickers. Stacks on phones.
{%- endcomment -%}
{%- liquid
  assign s = section.settings
  assign p = s.product | default: product
  assign images = ''
  assign count = 0

  if s.source == 'product' and p != blank
    assign start = s.featured_index | minus: 1
    assign rest_start = s.rest_index | minus: 1
    assign img_media = p.media | where: 'media_type', 'image'
    assign featured = img_media[start].preview_image
    assign r1 = img_media[rest_start].preview_image
    assign i2 = rest_start | plus: 1
    assign i3 = rest_start | plus: 2
    assign r2 = img_media[i2].preview_image
    assign r3 = img_media[i3].preview_image
    assign alt_base = p.title
  else
    assign featured = s.image_1
    assign r1 = s.image_2
    assign r2 = s.image_3
    assign r3 = s.image_4
    assign alt_base = s.heading | strip_html
  endif

  assign featured = featured | default: s.image_1
  assign has_rest = false
  if r1 != blank or r2 != blank or r3 != blank
    assign has_rest = true
  endif
  assign tape_colors = '#FFF503,#20A4F3,#EA5D00,#FFF503' | split: ','
-%}
{%- if s.divider_top != blank and s.divider_top != 'none' -%}{% render 'sm-divider', shape: s.divider_top, from: s.divider_top_from, to: s.bg %}{%- endif -%}
<section class="sm-section sm-igrid{% if s.paper %} sm-igrid--paper{% endif %}" style="--sm-bg: {{ s.bg }}; --sm-fg: {{ s.fg }}; --sm-igrid-tape: {{ s.tape_color }};"{% if s.heading != blank %} aria-labelledby="sm-{{ section.id }}-title"{% endif %}>
  {% render 'sm-corner-doodles', section: section %}
  {% render 'sm-doodle-blocks', section: section %}
  <div class="sm-container" style="--sm-pad-top: {{ s.pad_top }}px; --sm-pad-bottom: {{ s.pad_bottom }}px;">
    {%- if s.heading != blank or s.subcopy != blank -%}
      <div class="sm-igrid__head sm-igrid__head--{{ s.align }}">
        {%- if s.eyebrow != blank -%}<span class="sm-sticker">{{ s.eyebrow }}</span>{%- endif -%}
        {%- if s.heading != blank -%}<h2 id="sm-{{ section.id }}-title" class="sm-display">{{ s.heading }}</h2>{%- endif -%}
        {%- if s.subcopy != blank -%}<div class="sm-rte sm-igrid__sub">{{ s.subcopy }}</div>{%- endif -%}
      </div>
    {%- endif -%}

    {%- if featured != blank -%}
      <figure class="sm-igrid__feature{% if s.tilt %} is-tilted{% endif %}">
        {%- if s.tape -%}<span class="sm-igrid__tape" aria-hidden="true"></span>{%- endif -%}
        {%- assign f_alt = featured.alt | default: alt_base -%}
        {{ featured | image_url: width: 1800 | image_tag: alt: f_alt, loading: 'lazy', sizes: '(min-width: 1100px) 1000px, 92vw', widths: '600, 900, 1200, 1500, 1800', class: 'sm-igrid__img' }}
        {%- if s.show_captions and featured.alt != blank -%}<figcaption>{{ featured.alt }}</figcaption>{%- endif -%}
      </figure>
    {%- endif -%}

    {%- if has_rest -%}
      <div class="sm-igrid__row">
        {%- for img in (1..3) -%}
          {%- case img -%}
            {%- when 1 -%}{%- assign cur = r1 -%}
            {%- when 2 -%}{%- assign cur = r2 -%}
            {%- else -%}{%- assign cur = r3 -%}
          {%- endcase -%}
          {%- if cur == blank -%}{%- continue -%}{%- endif -%}
          {%- assign c_alt = cur.alt | default: alt_base -%}
          <figure class="sm-igrid__item sm-igrid__item--{{ img }}{% if s.tilt %} is-tilted{% endif %}">
            {%- if s.tape -%}<span class="sm-igrid__tape" aria-hidden="true" style="background: {{ tape_colors[img] }};"></span>{%- endif -%}
            {{ cur | image_url: width: 900 | image_tag: alt: c_alt, loading: 'lazy', sizes: '(min-width: 750px) 32vw, 92vw', widths: '400, 600, 900', class: 'sm-igrid__img' }}
            {%- if s.show_captions and cur.alt != blank -%}<figcaption>{{ cur.alt }}</figcaption>{%- endif -%}
          </figure>
        {%- endfor -%}
      </div>
    {%- endif -%}

    {%- if featured == blank and has_rest == false and request.design_mode -%}
      <p class="sm-bridge-note">No images yet. On a product page this uses the product's photos; elsewhere pick a product in this section or choose images below.</p>
    {%- endif -%}
  </div>
</section>
{%- if s.divider_bottom != blank and s.divider_bottom != 'none' -%}{% render 'sm-divider', shape: s.divider_bottom, from: s.bg, to: s.divider_bottom_to %}{%- endif -%}

