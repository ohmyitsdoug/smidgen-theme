{%- comment -%}
  Bridge page close: box with an optional price sticker, closing line, the
  Amazon button, a small "buy direct" link, policy links, and an optional
  sticky Amazon bar that hides while this section is on screen.
{%- endcomment -%}
{%- liquid
  assign s = section.settings
  assign p = product
  capture amz
    render 'sm-amazon-url', product: p, link: s.amazon_link
  endcapture
  assign amz = amz | strip
  assign img = s.image | default: p.featured_image
  assign btn_label = s.button_label | replace: '[title]', p.title
  assign bar_label = s.bar_button | replace: '[title]', p.title
  assign rating = p.metafields.reviews.rating.value
  assign rating_count = p.metafields.reviews.rating_count.value | default: 0
  assign award = p.metafields.smidgen.award.value | default: p.metafields.custom.award.value
-%}
<section id="sm-{{ section.id }}" class="sm-section sm-bclose" style="--sm-bg: {{ s.bg }}; --sm-fg: {{ s.fg }};" data-sm-bclose>
  {% render 'sm-corner-doodles', section: section %}
  {% render 'sm-doodle-blocks', section: section %}
  <div class="sm-container sm-container--narrow" style="--sm-pad-top: {{ s.pad_top }}px; --sm-pad-bottom: {{ s.pad_bottom }}px; align-items: center; text-align: center;">
    {%- if img != blank -%}
      <div class="sm-bclose__media">
        {{ img | image_url: width: 600 | image_tag: alt: '', class: 'sm-bclose__img', loading: 'lazy', sizes: '220px' }}
        {%- if s.price_text != blank -%}<span class="sm-bclose__price" style="background: {{ s.sticker_color }};">{{ s.price_text }}</span>{%- endif -%}
      </div>
    {%- endif -%}
    {%- if s.heading != blank -%}<h2 class="sm-display" style="font-size: clamp(2.2rem, 7vw, 3rem);">{{ s.heading }}</h2>{%- endif -%}
    {%- if amz != blank -%}
      <a class="sm-btn sm-bridge-amz" href="{{ amz }}" target="_blank" rel="sponsored noopener" data-sm-amazon data-placement="bridge_closing" data-product="{{ p.title | escape }}" data-product-id="{{ p.id }}" style="--sm-btn-bg: {{ s.button_bg }}; --sm-btn-fg: {{ s.button_fg }};">
        {{ btn_label }}<span class="sm-visually-hidden"> (opens Amazon in a new tab)</span>
      </a>
    {%- endif -%}
    {%- if s.direct_label != blank -%}
      <a class="sm-bclose__direct" href="{{ p.url }}">{{ s.direct_label }}</a>
    {%- endif -%}
    {%- if s.show_policies -%}
      <nav class="sm-bclose__policies" aria-label="Policies">
        {%- for policy in shop.policies -%}<a href="{{ policy.url }}">{{ policy.title }}</a>{%- endfor -%}
      </nav>
    {%- endif -%}
  </div>
</section>

{%- if s.sticky_bar and amz != blank -%}
  <div class="sm-bbar" data-sm-bbar style="--sm-bbar-bg: {{ s.bar_bg }};">
    <div class="sm-bbar__text">
      <span class="sm-bbar__title">{{ p.title }}</span>
      {%- if rating_count > 0 or award != blank -%}
        <span class="sm-bbar__meta">
          {%- if rating_count > 0 -%}★ {{ rating.rating | round: 1 }}{%- endif -%}
          {%- if rating_count > 0 and award != blank %} · {% endif -%}
          {%- if award != blank and s.bar_award -%}Award winner{%- endif -%}
        </span>
      {%- endif -%}
    </div>
    <a class="sm-btn sm-bridge-amz" href="{{ amz }}" target="_blank" rel="sponsored noopener" data-sm-amazon data-placement="bridge_sticky_bar" data-product="{{ p.title | escape }}" data-product-id="{{ p.id }}" style="--sm-btn-bg: {{ s.button_bg }}; --sm-btn-fg: {{ s.button_fg }};">
      {{ bar_label }}<span class="sm-visually-hidden"> (opens Amazon in a new tab)</span>
    </a>
  </div>
  <script>
    (function () {
      var bar = document.querySelector('[data-sm-bbar]');
      var close = document.querySelector('[data-sm-bclose]');
      if (!bar || !close || !('IntersectionObserver' in window)) return;
      new IntersectionObserver(function (entries) {
        bar.classList.toggle('is-hidden', entries[0].isIntersecting);
      }).observe(close);
    })();
  </script>
{%- endif -%}

