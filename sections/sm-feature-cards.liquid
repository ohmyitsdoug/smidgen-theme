{%- assign s = section.settings -%}
<section
  id="sm-{{ section.id }}"
  class="sm-section"
  style="--sm-bg: {{ s.bg }}; --sm-fg: {{ s.fg }};"
  {% if s.heading != blank %}aria-labelledby="sm-{{ section.id }}-title"{% endif %}
>
  {% render 'sm-doodle', shape: s.doodle, color: s.doodle_color, position: 'top-right' %}
  <div class="sm-container" style="--sm-pad-top: {{ s.pad_top }}px; --sm-pad-bottom: {{ s.pad_bottom }}px;">
    {%- if s.heading != blank -%}
      <h2 id="sm-{{ section.id }}-title" class="sm-display">{{ s.heading }}</h2>
    {%- endif -%}
    <div class="sm-grid" style="--sm-min: 250px;">
      {%- for block in section.blocks -%}
        {%- if block.settings.title != blank or block.settings.text != blank -%}
          <div class="sm-box" style="display: flex; flex-direction: column; gap: 14px;" {{ block.shopify_attributes }}>
            {%- if block.settings.label != blank -%}
              <span
                style="width: 64px; height: 64px; display: flex; align-items: center; justify-content: center; background: {{ block.settings.color }}; color: {{ block.settings.label_color }}; border: var(--sm-outline); border-radius: 18px; font-family: var(--sm-font-display); font-weight: 900; font-size: 1.6rem;"
                aria-hidden="true"
              >
                {{- block.settings.label -}}
              </span>
            {%- endif -%}
            {%- if block.settings.title != blank -%}
              <h3 class="sm-step__title" style="margin: 0;">{{ block.settings.title }}</h3>
            {%- endif -%}
            {%- if block.settings.text != blank -%}
              <div class="sm-rte" style="font-size: 1.05rem;">{{ block.settings.text }}</div>
            {%- endif -%}
          </div>
        {%- endif -%}
      {%- endfor -%}
    </div>
  </div>
</section>
{%- if s.divider != 'none' -%}
  {% render 'sm-divider', shape: s.divider, from: s.bg, to: s.divider_to %}
{%- endif -%}

{% schema %}
{
  "name": "Smidgen · Feature cards",
  "tag": "div",
  "max_blocks": 6,
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Big fun, tiny rulebook." },
    {
      "type": "select", "id": "doodle", "label": "Doodle",
      "options": [
        { "value": "none", "label": "None" }, { "value": "squiggle", "label": "Squiggle" },
        { "value": "spiral", "label": "Spiral" }, { "value": "zigzag", "label": "Zigzag" },
        { "value": "star", "label": "Star" }
      ],
      "default": "spiral"
    },
    { "type": "color", "id": "doodle_color", "label": "Doodle color", "default": "#FFF503" },
    { "type": "header", "content": "Colors" },
    { "type": "color", "id": "bg", "label": "Background", "default": "#20A4F3" },
    { "type": "color", "id": "fg", "label": "Text", "default": "#000000" },
    { "type": "header", "content": "Divider below" },
    {
      "type": "select", "id": "divider", "label": "Shape",
      "options": [
        { "value": "none", "label": "None" }, { "value": "wave", "label": "Wave" },
        { "value": "zigzag", "label": "Zigzag" }, { "value": "scallop", "label": "Scallop" },
        { "value": "straight", "label": "Straight line" }
      ],
      "default": "wave"
    },
    { "type": "color", "id": "divider_to", "label": "Next section color", "default": "#FFFFFF", "visible_if": "{{ section.settings.divider != 'none' }}" },
    { "type": "header", "content": "Spacing" },
    { "type": "range", "id": "pad_top", "label": "Top padding", "min": 0, "max": 120, "step": 8, "unit": "px", "default": 64 },
    { "type": "range", "id": "pad_bottom", "label": "Bottom padding", "min": 0, "max": 120, "step": 8, "unit": "px", "default": 88 }
  ],
  "blocks": [
    {
      "type": "card",
      "name": "Card",
      "settings": [
        { "type": "text", "id": "label", "label": "Icon text", "info": "A number or short symbol, e.g. 01 or ★" },
        { "type": "color", "id": "color", "label": "Icon color", "default": "#FFF503" },
        { "type": "color", "id": "label_color", "label": "Icon text color", "default": "#000000" },
        { "type": "text", "id": "title", "label": "Title" },
        { "type": "richtext", "id": "text", "label": "Text" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Smidgen · Feature cards",
      "blocks": [
        { "type": "card", "settings": { "label": "01", "color": "#FFF503", "title": "Sets up fast", "text": "<p>Open the box and you're basically playing.</p>" } },
        { "type": "card", "settings": { "label": "02", "color": "#EA5D00", "label_color": "#FFFFFF", "title": "Teaches easy", "text": "<p>Rules you can explain while someone grabs snacks.</p>" } },
        { "type": "card", "settings": { "label": "03", "color": "#753189", "label_color": "#FFFFFF", "title": "Replays forever", "text": "<p>Simple rules, real decisions. \"One more round.\"</p>" } }
      ]
    }
  ]
}
{% endschema %}
