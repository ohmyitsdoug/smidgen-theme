{%- comment -%}
  Wholesale shop: only for logged-in customers with the wholesale tag
  (Theme settings → Smidgen · Wholesale). Lists a collection with MSRP crossed
  out and the wholesale price, quick quantity ordering, and quietly applies a
  wholesale-only discount code so checkout charges the wholesale price.
  The code must be set up in Shopify (Discounts) limited to wholesale customers.
{%- endcomment -%}
{%- liquid
  assign s = section.settings
  capture is_ws
    render 'sm-is-wholesale'
  endcapture
  assign view = 'guest'
  if is_ws == 'true'
    assign view = 'wholesale'
  elsif customer
    assign view = 'pending'
  endif
  if request.design_mode
    assign view = s.preview_as | default: 'wholesale'
  endif
  assign pct = s.percent | default: 50
  assign keep = 100 | minus: pct
  assign login_url = routes.account_login_url | append: '?return_url=' | append: request.path
-%}
<section id="sm-{{ section.id }}" class="sm-section sm-ws" style="--sm-bg: {{ s.bg }}; --sm-fg: {{ s.fg }};{% render 'sm-btn-vars', s: s %}">
  {% render 'sm-doodle', shape: 'squiggle', color: '#EA5D00', position: 'top-right' %}
  <div class="sm-container" style="--sm-pad-top: {{ s.pad_top }}px; --sm-pad-bottom: {{ s.pad_bottom }}px;">
    {%- if view == 'wholesale' -%}
      <div class="sm-ws__head">
        <div class="sm-ws__intro">
          <span class="sm-sticker">{{ s.eyebrow }}</span>
          <h1 class="sm-display sm-display--xl">{{ s.heading }}</h1>
          {%- if s.text != blank -%}<div class="sm-lede">{{ s.text }}</div>{%- endif -%}
        </div>
        <ul class="sm-ws__perks">
          {%- if s.perk_1 != blank -%}<li>{% render 'sm-icon', name: 'tag', size: 22 %}<span>{{ s.perk_1 }}</span></li>{%- endif -%}
          {%- if s.perk_2 != blank -%}<li>{% render 'sm-icon', name: 'seal-check', size: 22 %}<span>{{ s.perk_2 }}</span></li>{%- endif -%}
          {%- if s.perk_3 != blank -%}<li>{% render 'sm-icon', name: 'storefront', size: 22 %}<span>{{ s.perk_3 }}</span></li>{%- endif -%}
        </ul>
      </div>

      {%- if s.collection != blank or s.extra_products != blank -%}
        <form class="sm-ws__list" data-sm-ws-form action="{{ routes.cart_add_url }}" method="post">
          {%- assign ws_seen = '|' -%}
          {%- assign ws_rows = 0 -%}
          {%- if s.collection != blank -%}
            {%- for product in s.collection.products limit: 100 -%}
              {%- assign ws_seen = ws_seen | append: product.id | append: '|' -%}
              {%- assign ws_rows = ws_rows | plus: 1 -%}
              {% render 'sm-ws-row', product: product, keep: keep, qty_step: s.qty_step, show_sku: s.show_sku, show_stock: s.show_stock %}
            {%- endfor -%}
          {%- endif -%}
          {%- for product in s.extra_products -%}
            {%- assign pid = '|' | append: product.id | append: '|' -%}
            {%- if ws_seen contains pid -%}{%- continue -%}{%- endif -%}
            {%- assign ws_rows = ws_rows | plus: 1 -%}
            {% render 'sm-ws-row', product: product, keep: keep, qty_step: s.qty_step, show_sku: s.show_sku, show_stock: s.show_stock %}
          {%- endfor -%}
          {%- if ws_rows == 0 -%}
            <p class="sm-ws__empty">No products in the wholesale collection yet.</p>
          {%- endif -%}

          <div class="sm-ws__bar">
            <span class="sm-ws__total" aria-live="polite"><span data-sm-ws-count>0</span> items · <strong data-sm-ws-total>{{ 0 | money }}</strong></span>
            {%- if s.min_note != blank -%}<span class="sm-ws__min">{{ s.min_note }}</span>{%- endif -%}
            <button type="submit" class="sm-btn" data-sm-ws-submit disabled>{{ s.button_label }}</button>
          </div>
          <p class="sm-ws__status" data-sm-ws-status role="status"></p>
        </form>
      {%- elsif request.design_mode -%}
        <p class="sm-ws__empty">Pick your wholesale collection in this section's settings.</p>
      {%- endif -%}

      {%- if s.footnote != blank -%}<div class="sm-ws__foot sm-rte">{{ s.footnote }}</div>{%- endif -%}

      <script>
        (function () {
          var root = document.getElementById('sm-{{ section.id }}');
          if (!root) return;
          var code = {% if request.design_mode %}''{% else %}{{ s.discount_code | strip | json }}{% endif %};
          // Quietly apply the wholesale-only discount code once per session.
          try {
            if (code && sessionStorage.getItem('sm-ws-code') !== code) {
              fetch('/discount/' + encodeURIComponent(code) + '?redirect=/cart.js', { credentials: 'same-origin' })
                .then(function () { sessionStorage.setItem('sm-ws-code', code); })
                .catch(function () {});
            }
          } catch (e) {}

          var form = root.querySelector('[data-sm-ws-form]');
          if (!form) return;
          var fmt = {{ shop.money_format | json }};
          function money(cents) {
            var v = (cents / 100).toFixed(2);
            return fmt.replace(/\{\{\s*\w+\s*\}\}/, v.replace(/\B(?=(\d{3})+(?!\d))/g, ','));
          }
          function rowPrice(row) {
            var now = row.querySelector('[data-sm-ws-now]');
            var sel = row.querySelector('select[data-sm-ws-variant]');
            if (sel) {
              var keep = parseInt(row.getAttribute('data-keep'), 10);
              var p = parseInt(sel.options[sel.selectedIndex].getAttribute('data-price'), 10);
              var each = Math.floor(p * keep / 100);
              var st = row.querySelector('[data-sm-ws-stock]');
              var sv = sel.options[sel.selectedIndex].getAttribute('data-stock');
              if (st) {
                if (sv === '' || sv === null) { st.hidden = true; }
                else { var n = parseInt(sv, 10); st.hidden = false; st.textContent = n > 0 ? n + ' available' : 'None in stock'; st.classList.toggle('is-out', n <= 0); }
              }
              var ms = row.querySelector('[data-sm-ws-msrp]');
              if (ms) ms.textContent = 'MSRP ' + money(p);
              now.textContent = money(each);
              now.setAttribute('data-cents', each);
            }
            return parseInt(now.getAttribute('data-cents') || '0', 10);
          }
          function total() {
            var count = 0, sum = 0;
            form.querySelectorAll('[data-sm-ws-row]').forEach(function (row) {
              var q = row.querySelector('[data-sm-ws-qty]');
              var each = rowPrice(row);
              if (!q) return;
              var n = Math.max(0, parseInt(q.value, 10) || 0);
              count += n; sum += n * each;
            });
            form.querySelector('[data-sm-ws-count]').textContent = count;
            form.querySelector('[data-sm-ws-total]').textContent = money(sum);
            form.querySelector('[data-sm-ws-submit]').disabled = count === 0;
          }
          form.addEventListener('click', function (e) {
            var b = e.target.closest('[data-step]');
            if (!b) return;
            var q = b.parentNode.querySelector('[data-sm-ws-qty]');
            q.value = Math.max(0, (parseInt(q.value, 10) || 0) + parseInt(b.getAttribute('data-step'), 10));
            total();
          });
          form.addEventListener('input', total);
          form.addEventListener('change', total);
          form.addEventListener('submit', function (e) {
            e.preventDefault();
            var items = [];
            form.querySelectorAll('[data-sm-ws-row]').forEach(function (row) {
              var q = row.querySelector('[data-sm-ws-qty]');
              var v = row.querySelector('[data-sm-ws-variant]');
              var n = q ? parseInt(q.value, 10) || 0 : 0;
              if (n > 0 && v) items.push({ id: parseInt(v.value, 10), quantity: n });
            });
            if (!items.length) return;
            var status = form.querySelector('[data-sm-ws-status]');
            status.textContent = 'Adding to your order…';
            fetch('/cart/add.js', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
              body: JSON.stringify({ items: items })
            }).then(function (r) { return r.json().then(function (j) { return { ok: r.ok, j: j }; }); })
              .then(function (res) {
                if (!res.ok) { status.textContent = res.j.description || 'Something went wrong. Please try again.'; return; }
                window.location.href = {{ routes.cart_url | json }};
              })
              .catch(function () { status.textContent = 'Something went wrong. Please try again.'; });
          });
          total();
        })();
      </script>

    {%- elsif view == 'pending' -%}
      <div class="sm-ws__gate">
        <h1 class="sm-display">{{ s.not_approved_heading }}</h1>
        {%- if s.not_approved_text != blank -%}<div class="sm-lede">{{ s.not_approved_text }}</div>{%- endif -%}
        {%- if s.apply_link != blank -%}<a class="sm-btn" href="{{ s.apply_link }}">{{ s.apply_label }}</a>{%- endif -%}
      </div>
    {%- else -%}
      <div class="sm-ws__gate">
        <h1 class="sm-display">{{ s.login_heading }}</h1>
        {%- if s.login_text != blank -%}<div class="sm-lede">{{ s.login_text }}</div>{%- endif -%}
        <div class="sm-actions" style="justify-content: center;">
          <a class="sm-btn" href="{{ login_url }}">Log in</a>
          {%- if s.apply_link != blank -%}<a class="sm-btn sm-btn--secondary" href="{{ s.apply_link }}">{{ s.apply_label }}</a>{%- endif -%}
        </div>
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Smidgen · Wholesale shop",
  "tag": "div",
  "settings": [
    {
      "type": "paragraph",
      "content": "Only customers with the wholesale tag (Theme settings → Smidgen · Wholesale) see products and prices. Everyone else sees a log-in or 'not approved' message."
    },
    {
      "type": "select",
      "id": "preview_as",
      "label": "Preview in the editor as",
      "options": [
        {
          "value": "wholesale",
          "label": "Approved retailer"
        },
        {
          "value": "guest",
          "label": "Logged out"
        },
        {
          "value": "pending",
          "label": "Logged in, not approved"
        }
      ],
      "default": "wholesale",
      "info": "Only changes what you see in the theme editor. Shoppers always see their real view."
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Wholesale collection"
    },
    {
      "type": "product_list",
      "id": "extra_products",
      "label": "Retailer-only products",
      "limit": 50,
      "info": "Cases, POP displays and other items set to Unlisted. Unlisted products never appear in collections, so add them here to show them on this page."
    },
    {
      "type": "range",
      "id": "percent",
      "label": "Wholesale discount shown",
      "min": 10,
      "max": 70,
      "step": 5,
      "unit": "%",
      "default": 50
    },
    {
      "type": "text",
      "id": "discount_code",
      "label": "Wholesale discount code",
      "info": "Applied automatically for wholesale customers on this page. Create it in Discounts with Customer eligibility = your wholesale customers so nobody else can use it."
    },
    {
      "type": "range",
      "id": "qty_step",
      "label": "Quantity step",
      "min": 1,
      "max": 24,
      "step": 1,
      "default": 1,
      "info": "e.g. 6 to order in cases of 6"
    },
    {
      "type": "checkbox",
      "id": "show_sku",
      "label": "Show SKUs",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_stock",
      "label": "Show quantity available",
      "default": false,
      "info": "Shows each item's stock count under its name (products with tracked inventory only)."
    },
    {
      "type": "header",
      "content": "Wholesale view"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Sticker",
      "default": "Retailer portal"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Wholesale shop"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text",
      "default": "<p>Pick your quantities and add everything to your order at once. Wholesale pricing is applied at checkout.</p>"
    },
    {
      "type": "text",
      "id": "perk_1",
      "label": "Perk 1",
      "default": "50% off MSRP on every game"
    },
    {
      "type": "text",
      "id": "perk_2",
      "label": "Perk 2",
      "default": "Tax-exempt checkout on approved accounts"
    },
    {
      "type": "text",
      "id": "perk_3",
      "label": "Perk 3",
      "default": "Retailer-only POP displays"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Order button",
      "default": "Add to order"
    },
    {
      "type": "text",
      "id": "min_note",
      "label": "Order note",
      "info": "e.g. $150 opening order minimum"
    },
    {
      "type": "richtext",
      "id": "footnote",
      "label": "Footnote"
    },
    {
      "type": "header",
      "content": "Logged out"
    },
    {
      "type": "text",
      "id": "login_heading",
      "label": "Heading",
      "default": "Retailers, log in to shop"
    },
    {
      "type": "richtext",
      "id": "login_text",
      "label": "Text",
      "default": "<p>Log in with your retailer account to see wholesale pricing and place an order.</p>"
    },
    {
      "type": "header",
      "content": "Logged in, not approved"
    },
    {
      "type": "text",
      "id": "not_approved_heading",
      "label": "Heading",
      "default": "This page is for approved retailers"
    },
    {
      "type": "richtext",
      "id": "not_approved_text",
      "label": "Text",
      "default": "<p>Want to carry Smidgen games? Apply for a wholesale account and we'll get back to you within a few days.</p>"
    },
    {
      "type": "url",
      "id": "apply_link",
      "label": "Apply link"
    },
    {
      "type": "text",
      "id": "apply_label",
      "label": "Apply button",
      "default": "Apply for wholesale"
    },
    {
      "type": "header",
      "content": "Buttons"
    },
    {
      "type": "paragraph",
      "content": "Leave empty for the standard purple button and white second button."
    },
    {
      "type": "color",
      "id": "btn_bg",
      "label": "Button color"
    },
    {
      "type": "color",
      "id": "btn_fg",
      "label": "Button text"
    },
    {
      "type": "color",
      "id": "btn2_bg",
      "label": "Second button color"
    },
    {
      "type": "color",
      "id": "btn2_fg",
      "label": "Second button text"
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "bg",
      "label": "Background",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "fg",
      "label": "Text",
      "default": "#000000"
    },
    {
      "type": "range",
      "id": "pad_top",
      "label": "Top padding",
      "min": 0,
      "max": 120,
      "step": 8,
      "unit": "px",
      "default": 56
    },
    {
      "type": "range",
      "id": "pad_bottom",
      "label": "Bottom padding",
      "min": 0,
      "max": 120,
      "step": 8,
      "unit": "px",
      "default": 96
    }
  ],
  "presets": [
    {
      "name": "Smidgen · Wholesale shop"
    }
  ]
}
{% endschema %}
