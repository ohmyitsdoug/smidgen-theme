{%- assign s = section.settings -%}
<section
  id="sm-{{ section.id }}"
  class="sm-section"
  style="--sm-bg: {{ s.bg }}; --sm-fg: {{ s.fg }};"
  {% if s.heading != blank %}aria-labelledby="sm-{{ section.id }}-title"{% endif %}
>
  <div class="sm-container" style="--sm-pad-top: {{ s.pad_top }}px; --sm-pad-bottom: {{ s.pad_bottom }}px;">
    <div style="display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 32px;">
      <ul style="display: flex; flex-wrap: wrap; gap: 20px; margin: 0; padding: 0; list-style: none;">
        {%- for block in section.blocks -%}
          {%- if block.settings.number != blank -%}
            <li class="sm-stat" {{ block.shopify_attributes }}>
              <span class="sm-stat__num">{{ block.settings.number }}</span>
              <span class="sm-stat__label">{{ block.settings.label }}</span>
            </li>
          {%- endif -%}
        {%- endfor -%}
      </ul>
      {%- if s.heading != blank or s.button_label != blank -%}
        <div style="display: flex; flex-direction: column; align-items: flex-start; gap: 14px;">
          {%- if s.heading != blank -%}
            <h2 id="sm-{{ section.id }}-title" class="sm-display" style="font-size: clamp(2.2rem, 5vw, 3rem);">{{ s.heading }}</h2>
          {%- endif -%}
          <div class="sm-actions">
            {%- if s.button_label != blank -%}
              <a class="sm-btn" href="{{ s.button_link | default: routes.all_products_collection_url }}">{{ s.button_label }}</a>
            {%- endif -%}
            {%- if s.button_2_label != blank -%}
              <a class="sm-btn sm-btn--secondary" href="{{ s.button_2_link | default: '#' }}">{{ s.button_2_label }}</a>
            {%- endif -%}
          </div>
        </div>
      {%- endif -%}
    </div>
  </div>
</section>
{%- if s.divider != 'none' -%}
  {% render 'sm-divider', shape: s.divider, from: s.bg, to: s.divider_to %}
{%- endif -%}

{% schema %}
{
  "name": "Smidgen · Stats",
  "tag": "div",
  "max_blocks": 5,
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Come play with us" },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "See our games" },
    { "type": "url", "id": "button_link", "label": "Button link" },
    { "type": "text", "id": "button_2_label", "label": "Second button label", "default": "Say hello" },
    { "type": "url", "id": "button_2_link", "label": "Second button link" },
    { "type": "header", "content": "Colors" },
    { "type": "color", "id": "bg", "label": "Background", "default": "#20A4F3" },
    { "type": "color", "id": "fg", "label": "Text", "default": "#000000" },
    { "type": "header", "content": "Divider below" },
    {
      "type": "select", "id": "divider", "label": "Shape",
      "options": [
        { "value": "none", "label": "None" }, { "value": "wave", "label": "Wave" },
        { "value": "zigzag", "label": "Zigzag" }, { "value": "scallop", "label": "Scallop" }
      ],
      "default": "none"
    },
    { "type": "color", "id": "divider_to", "label": "Next section color", "default": "#000000", "visible_if": "{{ section.settings.divider != 'none' }}" },
    { "type": "header", "content": "Spacing" },
    { "type": "range", "id": "pad_top", "label": "Top padding", "min": 0, "max": 120, "step": 8, "unit": "px", "default": 48 },
    { "type": "range", "id": "pad_bottom", "label": "Bottom padding", "min": 0, "max": 120, "step": 8, "unit": "px", "default": 88 }
  ],
  "blocks": [
    {
      "type": "stat",
      "name": "Stat",
      "settings": [
        { "type": "text", "id": "number", "label": "Number", "placeholder": "14+" },
        { "type": "text", "id": "label", "label": "Label", "placeholder": "retail stores" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Smidgen · Stats",
      "blocks": [
        { "type": "stat", "settings": { "number": "14+", "label": "retail stores" } },
        { "type": "stat", "settings": { "number": "2,000+", "label": "games shipped" } },
        { "type": "stat", "settings": { "number": "4.9/5", "label": "average rating" } }
      ]
    }
  ]
}
{% endschema %}
