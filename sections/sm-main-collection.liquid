{%- liquid
  assign card_bg = blank
  if section.settings.card_bg_mode == 'custom'
    assign card_bg = section.settings.card_bg
  endif
-%}
{%- liquid
  assign s = section.settings
  assign filter_tags = s.filter_tags | split: ','
  assign base_url = collection.url
  assign coll_title = collection.title
  if collection.handle == 'all' and s.all_title != blank
    assign coll_title = s.all_title
  endif

  comment
    Per-collection tag control (collection fields, set on each collection):
    - show field: only these tags become pills on this collection
    - hide field: these tags never become pills on this collection
  endcomment
  assign show_key = s.show_tags_field | default: 'custom.filter_tags' | strip | split: '.'
  assign hide_key = s.hide_tags_field | default: 'custom.hide_tags' | strip | split: '.'
  assign c_show_mf = collection.metafields[show_key[0]][show_key[1]]
  assign c_hide_mf = collection.metafields[hide_key[0]][hide_key[1]]
  if c_show_mf.type contains 'list.'
    assign c_show = c_show_mf.value
  else
    assign c_show = c_show_mf.value | newline_to_br | replace: '<br />', ',' | split: ','
  endif
  if c_hide_mf.type contains 'list.'
    assign c_hide_arr = c_hide_mf.value
  else
    assign c_hide_arr = c_hide_mf.value | newline_to_br | replace: '<br />', ',' | split: ','
  endif
  assign hidden_str = '|'
  for h in c_hide_arr
    assign h_low = h | strip | downcase
    if h_low != blank
      assign hidden_str = hidden_str | append: h_low | append: '|'
    endif
  endfor
  assign global_ex = s.exclude_tags | downcase | split: ','
  for h in global_ex
    assign h_low = h | strip
    if h_low != blank and s.auto_tags
      assign hidden_str = hidden_str | append: h_low | append: '|'
    endif
  endfor
  assign has_c_show = false
  for t in c_show
    assign t_s = t | strip
    if t_s != blank
      assign has_c_show = true
      break
    endif
  endfor
-%}
<section class="sm-section" style="--sm-bg: {{ s.hero_bg }}; --sm-fg: #000;" aria-labelledby="sm-{{ section.id }}-title">
  {% render 'sm-doodle', shape: 'squiggle', color: '#753189', position: 'top-right', bg: section.settings.bg %}
  {% render 'sm-doodle', shape: 'spiral', color: '#EA5D00', position: 'bottom-right', bg: section.settings.bg %}
  <div class="sm-container" style="--sm-pad-top: 48px; --sm-pad-bottom: 24px; gap: 10px;">
    <nav aria-label="Breadcrumb" style="font-size: 0.95rem;">
      <a href="{{ routes.root_url }}" style="color: inherit;">Home</a> / <span>{{ coll_title }}</span>
    </nav>
    <h1 id="sm-{{ section.id }}-title" class="sm-display sm-display--xl">{{ coll_title }}</h1>
    {%- if collection.description != blank -%}
      <div class="sm-lede sm-rte">{{ collection.description }}</div>
    {%- elsif s.intro != blank -%}
      <div class="sm-lede">{{ s.intro }}</div>
    {%- endif -%}
  </div>
</section>
{% render 'sm-divider', shape: 'wave', from: s.hero_bg, to: '#FFFFFF' %}

<section class="sm-section" style="--sm-bg: #fff;">
  {%- paginate collection.products by s.per_page -%}
    {%- liquid
      assign current_sort = collection.sort_by | default: s.default_sort
      assign list = collection.products
      if collection.sort_by == blank
        case s.default_sort
          when 'title-ascending'
            assign list = collection.products | sort_natural: 'title'
          when 'title-descending'
            assign list = collection.products | sort_natural: 'title' | reverse
          when 'price-ascending'
            assign list = collection.products | sort: 'price'
          when 'price-descending'
            assign list = collection.products | sort: 'price' | reverse
        endcase
      endif
    -%}
    <div class="sm-container" style="--sm-pad-top: 24px; --sm-pad-bottom: 88px;">
      <div class="sm-filter-bar">
        {%- liquid
          assign pill_count = 0
          assign mode = 'list'
          if has_c_show
            assign mode = 'collection'
            for t in c_show
              assign t_s = t | strip
              if t_s != blank
                assign pill_count = pill_count | plus: 1
              endif
            endfor
          else
            for block in section.blocks
              if block.settings.label != blank
                assign bt = '|' | append: block.settings.tag | strip | downcase | append: '|'
                unless block.settings.kind == 'tag' and hidden_str contains bt
                  assign pill_count = pill_count | plus: 1
                endunless
              endif
            endfor
            if section.blocks.size > 0
              assign mode = 'blocks'
            elsif s.auto_tags
              assign mode = 'auto'
              for tag in collection.all_tags
                assign key = '|' | append: tag | downcase | append: '|'
                assign first_char = tag | slice: 0
                unless hidden_str contains key or first_char == '_'
                  assign pill_count = pill_count | plus: 1
                endunless
              endfor
            elsif s.filter_tags != blank
              for raw_tag in filter_tags
                assign tag = raw_tag | strip
                assign key = '|' | append: tag | downcase | append: '|'
                if collection.all_tags contains tag
                  unless hidden_str contains key
                    assign pill_count = pill_count | plus: 1
                  endunless
                endif
              endfor
            endif
          endif
          assign all_url = s.all_link | default: base_url
        -%}
        {%- if request.design_mode -%}
          <p style="flex-basis: 100%; margin: 0; padding: 12px 16px; border: 3px dashed #000; border-radius: 16px; font-size: 0.9rem;">
            <strong>Only you see this:</strong>
            {% if collection.all_tags.size > 0 -%}
              tags used in this collection: {{ collection.all_tags | join: ', ' }}. Add a Filter pill block for any of them, or turn on "Make a pill for every tag". To choose tags for just this collection, fill in its Filter tags / Hidden tags fields.
            {%- else -%}
              no products in this collection have tags yet. Add tags like game, merch or bundle to your products in Shopify admin.
            {%- endif %}
          </p>
        {%- endif -%}
        {%- if pill_count > 0 -%}
          <nav aria-label="Filter">
            <ul class="sm-pills">
              {%- if s.all_label != blank -%}
                <li>
                  <a class="sm-pill" href="{{ all_url }}" {% if current_tags == blank and collection.url == all_url %}aria-current="page"{% endif %}>{{ s.all_label }}</a>
                </li>
              {%- endif -%}
              {%- if mode == 'collection' -%}
                {%- for t in c_show -%}
                  {%- assign tag = t | strip -%}
                  {%- if tag != blank -%}
                    <li>
                      <a class="sm-pill" href="{{ base_url }}/{{ tag | handle }}" {% if current_tags contains tag %}aria-current="page"{% endif %}>
                        {{- tag | replace: '-', ' ' | capitalize -}}
                      </a>
                    </li>
                  {%- endif -%}
                {%- endfor -%}
              {%- elsif mode == 'blocks' -%}
                {%- for block in section.blocks -%}
                  {%- liquid
                    assign b = block.settings
                    if b.label == blank
                      continue
                    endif
                    assign bt = '|' | append: b.tag | strip | downcase | append: '|'
                    if b.kind == 'tag' and hidden_str contains bt
                      continue
                    endif
                    assign active = false
                    if b.kind == 'collection'
                      assign pill_url = b.collection.url
                      if b.collection.id == collection.id and current_tags == blank
                        assign active = true
                      endif
                    elsif b.kind == 'link'
                      assign pill_url = b.link
                    else
                      assign tag = b.tag | strip
                      assign tag_handle = tag | handle
                      assign pill_url = base_url | append: '/' | append: tag_handle
                      if current_tags contains tag
                        assign active = true
                      endif
                    endif
                  -%}
                  <li {{ block.shopify_attributes }}>
                    <a class="sm-pill" href="{{ pill_url | default: '#' }}" {% if active %}aria-current="page"{% endif %}>{{ b.label }}</a>
                  </li>
                {%- endfor -%}
              {%- elsif mode == 'auto' -%}
                {%- for tag in collection.all_tags -%}
                  {%- liquid
                    assign key = '|' | append: tag | downcase | append: '|'
                    assign first_char = tag | slice: 0
                    if hidden_str contains key or first_char == '_'
                      continue
                    endif
                  -%}
                  <li>
                    <a class="sm-pill" href="{{ base_url }}/{{ tag | handle }}" {% if current_tags contains tag %}aria-current="page"{% endif %}>
                      {{- tag | replace: '-', ' ' | capitalize -}}
                    </a>
                  </li>
                {%- endfor -%}
              {%- else -%}
                {%- for raw_tag in filter_tags -%}
                  {%- assign tag = raw_tag | strip -%}
                  {%- assign key = '|' | append: tag | downcase | append: '|' -%}
                  {%- if collection.all_tags contains tag -%}
                    {%- unless hidden_str contains key -%}
                      <li>
                        <a class="sm-pill" href="{{ base_url }}/{{ tag | handle }}" {% if current_tags contains tag %}aria-current="page"{% endif %}>
                          {{- tag | replace: '-', ' ' | capitalize -}}
                        </a>
                      </li>
                    {%- endunless -%}
                  {%- endif -%}
                {%- endfor -%}
              {%- endif -%}
            </ul>
          </nav>
        {%- endif -%}
        <form method="get" style="display: flex; align-items: center; gap: 10px;">
          <span aria-live="polite" style="font-weight: 500;">
            {{ collection.products_count }}
            {{ collection.products_count | pluralize: section.settings.item_word, section.settings.items_word }}
          </span>
          <label for="sm-sort-{{ section.id }}" style="font-weight: 700;">Sort</label>
          <select id="sm-sort-{{ section.id }}" class="sm-select" name="sort_by" onchange="this.form.submit()">
            {%- for option in collection.sort_options -%}
              <option value="{{ option.value }}" {% if option.value == current_sort %}selected{% endif %}>
                {{- option.name -}}
              </option>
            {%- endfor -%}
          </select>
          <noscript><button type="submit" class="sm-btn">Sort</button></noscript>
        </form>
      </div>

      <div class="sm-grid sm-grid--cards" style="--sm-min: 240px; --sm-max: {{ section.settings.card_max }}px;">
        {%- liquid
          comment
            Default order: groups first (e.g. games, then merch), each group in
            the default sort. Skipped as soon as a shopper picks a sort.
          endcomment
          assign groups = s.group_order | downcase | split: ','
          assign use_groups = false
          if collection.sort_by == blank and s.group_order != blank
            assign use_groups = true
          endif
          assign done_ids = '|'
          assign show_pins = false
          if s.pinned != blank and collection.sort_by == blank and current_tags == blank and paginate.current_page == 1
            assign show_pins = true
          endif
        -%}
        {%- if show_pins -%}
          {%- for product in s.pinned -%}
            {%- liquid
              assign in_coll = false
              if collection.handle == 'all'
                assign in_coll = true
              else
                for c in product.collections
                  if c.id == collection.id
                    assign in_coll = true
                    break
                  endif
                endfor
              endif
              unless in_coll
                continue
              endunless
              assign done_ids = done_ids | append: product.id | append: '|'
            -%}
            {% render 'sm-game-card', product: product, image_fit: section.settings.image_fit, bg: card_bg, more_label: section.settings.more_label, soon_label: section.settings.soon_label %}
          {%- endfor -%}
        {%- endif -%}
        {%- if use_groups -%}
          {%- for g in groups -%}
            {%- assign g_s = g | strip -%}
            {%- if g_s == blank -%}{%- continue -%}{%- endif -%}
            {%- for product in list -%}
              {%- liquid
                assign pid = '|' | append: product.id | append: '|'
                if done_ids contains pid
                  continue
                endif
                assign p_type = product.type | downcase | strip
                assign p_tags = product.tags | join: '|' | downcase | prepend: '|' | append: '|'
                assign g_key = '|' | append: g_s | append: '|'
                unless p_type == g_s or p_tags contains g_key
                  continue
                endunless
                assign done_ids = done_ids | append: product.id | append: '|'
              -%}
              {% render 'sm-game-card', product: product, image_fit: section.settings.image_fit, bg: card_bg, more_label: section.settings.more_label, soon_label: section.settings.soon_label %}
            {%- endfor -%}
          {%- endfor -%}
        {%- endif -%}
        {%- for product in list -%}
          {%- assign pid = '|' | append: product.id | append: '|' -%}
          {%- if done_ids contains pid -%}{%- continue -%}{%- endif -%}
          {% render 'sm-game-card', product: product, image_fit: section.settings.image_fit, bg: card_bg, more_label: section.settings.more_label, soon_label: section.settings.soon_label %}
        {%- else -%}
          <p style="grid-column: 1 / -1; padding: 40px; text-align: center; border: 3px dashed #000; border-radius: 26px;">
            {{ section.settings.empty_text }}
          </p>
        {%- endfor -%}
      </div>

      {%- if paginate.pages > 1 -%}
        <nav class="sm-pagination" aria-label="Pages">
          {%- if paginate.previous -%}<a href="{{ paginate.previous.url }}" aria-label="Previous page">←</a>{%- endif -%}
          {%- for part in paginate.parts -%}
            {%- if part.is_link -%}
              <a href="{{ part.url }}">{{ part.title }}</a>
            {%- else -%}
              <span {% if part.title == paginate.current_page %}class="is-current" aria-current="page"{% endif %}>{{ part.title }}</span>
            {%- endif -%}
          {%- endfor -%}
          {%- if paginate.next -%}<a href="{{ paginate.next.url }}" aria-label="Next page">→</a>{%- endif -%}
        </nav>
      {%- endif -%}
    </div>
  {%- endpaginate -%}
</section>

{% schema %}
{
  "name": "Smidgen · Collection",
  "tag": "div",
  "enabled_on": {
    "templates": [
      "collection"
    ]
  },
  "settings": [
    {
      "type": "text",
      "id": "all_title",
      "label": "All products page title",
      "default": "Shop all games",
      "info": "Replaces Shopify's default \"Products\" title on /collections/all."
    },
    {
      "type": "text",
      "id": "intro",
      "label": "Intro (used if the collection has no description)",
      "default": "Every Smidgen game teaches in minutes and fits in a bag. Pick by who's playing tonight."
    },
    {
      "type": "checkbox",
      "id": "auto_tags",
      "label": "Make a pill for every tag",
      "info": "Used when no Filter pill blocks are added. Tags starting with _ are skipped.",
      "default": false
    },
    {
      "type": "text",
      "id": "exclude_tags",
      "label": "Tags to skip",
      "info": "Comma-separated",
      "visible_if": "{{ section.settings.auto_tags }}"
    },
    {
      "type": "text",
      "id": "show_tags_field",
      "label": "Collection field: tags to show",
      "default": "custom.filter_tags",
      "info": "Set on each collection. When filled, only these tags show as pills there."
    },
    {
      "type": "text",
      "id": "hide_tags_field",
      "label": "Collection field: tags to hide",
      "default": "custom.hide_tags",
      "info": "Set on each collection. These tags never show as pills there."
    },
    {
      "type": "text",
      "id": "filter_tags",
      "label": "Pill tags (used when no Filter pill blocks are added)",
      "info": "Comma-separated product tags, e.g. family, 2-player, quick-play, coming-soon. Only tags used in this collection appear.",
      "default": "family, 2-player, quick-play, coming-soon",
      "visible_if": "{{ section.settings.auto_tags == false }}"
    },
    {
      "type": "text",
      "id": "all_label",
      "label": "'All' pill text",
      "default": "All games",
      "info": "Leave empty to hide the All pill."
    },
    {
      "type": "url",
      "id": "all_link",
      "label": "'All' pill link",
      "info": "Defaults to this collection."
    },
    {
      "type": "text",
      "id": "item_word",
      "label": "Item word (one)",
      "default": "item",
      "info": "Used in the count, e.g. 1 game / 1 shirt"
    },
    {
      "type": "text",
      "id": "items_word",
      "label": "Item word (many)",
      "default": "items"
    },
    {
      "type": "text",
      "id": "empty_text",
      "label": "Empty message",
      "default": "Nothing here yet. Check back soon!"
    },
    {
      "type": "select",
      "id": "default_sort",
      "label": "Default sort",
      "info": "Used when the shopper hasn't picked a sort.",
      "options": [
        {
          "value": "title-ascending",
          "label": "Alphabetical, A–Z"
        },
        {
          "value": "title-descending",
          "label": "Alphabetical, Z–A"
        },
        {
          "value": "price-ascending",
          "label": "Price, low to high"
        },
        {
          "value": "price-descending",
          "label": "Price, high to low"
        },
        {
          "value": "collection",
          "label": "Collection's own order"
        }
      ],
      "default": "title-ascending"
    },
    {
      "type": "product_list",
      "id": "pinned",
      "label": "Pin to the top",
      "limit": 12,
      "info": "These show first, in this order, on any collection they belong to. Applies until a shopper picks a sort or filter."
    },
    {
      "type": "text",
      "id": "group_order",
      "label": "Show these first, in order",
      "default": "game, merch",
      "info": "Product types or tags, comma-separated. Applies until a shopper picks a sort. Everything else follows."
    },
    {
      "type": "range",
      "id": "per_page",
      "label": "Items per page",
      "min": 8,
      "max": 48,
      "step": 4,
      "default": 24
    },
    {
      "type": "header",
      "content": "Cards"
    },
    {
      "type": "select",
      "id": "image_fit",
      "label": "Image",
      "options": [
        {
          "value": "fit",
          "label": "Fit (show the whole image)"
        },
        {
          "value": "fill",
          "label": "Fill (crop to fill the card)"
        }
      ],
      "default": "fit"
    },
    {
      "type": "select",
      "id": "card_bg_mode",
      "label": "Image background",
      "options": [
        {
          "value": "game",
          "label": "Each game's own color"
        },
        {
          "value": "custom",
          "label": "One color for all cards"
        }
      ],
      "default": "game"
    },
    {
      "type": "color",
      "id": "card_bg",
      "label": "Background color",
      "default": "#753189",
      "visible_if": "{{ section.settings.card_bg_mode == 'custom' }}"
    },
    {
      "type": "range",
      "id": "card_max",
      "label": "Max card width",
      "min": 240,
      "max": 440,
      "step": 20,
      "unit": "px",
      "default": 320
    },
    {
      "type": "text",
      "id": "more_label",
      "label": "Card link text",
      "default": "View game →"
    },
    {
      "type": "text",
      "id": "soon_label",
      "label": "Card link text (coming soon)",
      "default": "Get notified →"
    },
    {
      "type": "color",
      "id": "hero_bg",
      "label": "Header color",
      "default": "#FFF503"
    }
  ],
  "max_blocks": 20,
  "blocks": [
    {
      "type": "pill",
      "name": "Filter pill",
      "settings": [
        {
          "type": "text",
          "id": "label",
          "label": "Label",
          "placeholder": "Games"
        },
        {
          "type": "select",
          "id": "kind",
          "label": "Filters by",
          "options": [
            {
              "value": "tag",
              "label": "Product tag"
            },
            {
              "value": "collection",
              "label": "Another collection"
            },
            {
              "value": "link",
              "label": "Custom link"
            }
          ],
          "default": "tag"
        },
        {
          "type": "text",
          "id": "tag",
          "label": "Product tag",
          "placeholder": "game",
          "info": "Exactly as it's written on your products.",
          "visible_if": "{{ block.settings.kind == 'tag' }}"
        },
        {
          "type": "collection",
          "id": "collection",
          "label": "Collection",
          "visible_if": "{{ block.settings.kind == 'collection' }}"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link",
          "visible_if": "{{ block.settings.kind == 'link' }}"
        }
      ]
    }
  ]
}
{% endschema %}
