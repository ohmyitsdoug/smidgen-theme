{%- liquid
  assign card_bg = blank
  if section.settings.card_bg_mode == 'custom'
    assign card_bg = section.settings.card_bg
  endif
-%}
{%- liquid
  assign s = section.settings
  assign filter_tags = s.filter_tags | split: ','
  assign base_url = collection.url
-%}
<section class="sm-section" style="--sm-bg: {{ s.hero_bg }}; --sm-fg: #000;" aria-labelledby="sm-{{ section.id }}-title">
  {% render 'sm-doodle', shape: 'squiggle', color: '#753189', position: 'top-right' %}
  {% render 'sm-doodle', shape: 'spiral', color: '#EA5D00', position: 'bottom-right' %}
  <div class="sm-container" style="--sm-pad-top: 48px; --sm-pad-bottom: 24px; gap: 10px;">
    <nav aria-label="Breadcrumb" style="font-size: 0.95rem;">
      <a href="{{ routes.root_url }}" style="color: inherit;">Home</a> / <span>{{ collection.title }}</span>
    </nav>
    <h1 id="sm-{{ section.id }}-title" class="sm-display sm-display--xl">{{ collection.title }}</h1>
    {%- if collection.description != blank -%}
      <div class="sm-lede sm-rte">{{ collection.description }}</div>
    {%- elsif s.intro != blank -%}
      <div class="sm-lede">{{ s.intro }}</div>
    {%- endif -%}
  </div>
</section>
{% render 'sm-divider', shape: 'wave', from: s.hero_bg, to: '#FFFFFF' %}

<section class="sm-section" style="--sm-bg: #fff;">
  {%- paginate collection.products by s.per_page -%}
    {%- liquid
      assign current_sort = collection.sort_by | default: s.default_sort
      assign list = collection.products
      if collection.sort_by == blank
        case s.default_sort
          when 'title-ascending'
            assign list = collection.products | sort_natural: 'title'
          when 'title-descending'
            assign list = collection.products | sort_natural: 'title' | reverse
          when 'price-ascending'
            assign list = collection.products | sort: 'price'
          when 'price-descending'
            assign list = collection.products | sort: 'price' | reverse
        endcase
      endif
    -%}
    <div class="sm-container" style="--sm-pad-top: 24px; --sm-pad-bottom: 88px;">
      <div class="sm-filter-bar">
        {%- liquid
          assign pill_count = 0
          for block in section.blocks
            if block.settings.label != blank
              assign pill_count = pill_count | plus: 1
            endif
          endfor
          assign use_auto = false
          if pill_count == 0 and s.auto_tags
            assign use_auto = true
            assign excluded = s.exclude_tags | downcase | split: ','
            for tag in collection.all_tags
              assign t_low = tag | downcase | strip
              assign first_char = tag | slice: 0
              unless excluded contains t_low or first_char == '_'
                assign pill_count = pill_count | plus: 1
              endunless
            endfor
          elsif pill_count == 0 and s.filter_tags != blank
            for raw_tag in filter_tags
              assign tag = raw_tag | strip
              if collection.all_tags contains tag
                assign pill_count = pill_count | plus: 1
              endif
            endfor
          endif
          assign all_url = s.all_link | default: base_url
        -%}
        {%- if request.design_mode -%}
          <p style="flex-basis: 100%; margin: 0; padding: 12px 16px; border: 3px dashed #000; border-radius: 16px; font-size: 0.9rem;">
            <strong>Only you see this:</strong>
            {% if collection.all_tags.size > 0 -%}
              tags used in this collection: {{ collection.all_tags | join: ', ' }}. Add a Filter pill block for any of them, or turn on "Make a pill for every tag".
            {%- else -%}
              no products in this collection have tags yet. Add tags like game, merch or bundle to your products in Shopify admin.
            {%- endif %}
          </p>
        {%- endif -%}
        {%- if pill_count > 0 -%}
          <nav aria-label="Filter">
            <ul class="sm-pills">
              {%- if s.all_label != blank -%}
                <li>
                  <a class="sm-pill" href="{{ all_url }}" {% if current_tags == blank and collection.url == all_url %}aria-current="page"{% endif %}>{{ s.all_label }}</a>
                </li>
              {%- endif -%}
              {%- if section.blocks.size > 0 -%}
                {%- for block in section.blocks -%}
                  {%- liquid
                    assign b = block.settings
                    if b.label == blank
                      continue
                    endif
                    assign active = false
                    if b.kind == 'collection'
                      assign pill_url = b.collection.url
                      if b.collection.id == collection.id and current_tags == blank
                        assign active = true
                      endif
                    elsif b.kind == 'link'
                      assign pill_url = b.link
                    else
                      assign tag = b.tag | strip
                      assign tag_handle = tag | handle
                      assign pill_url = base_url | append: '/' | append: tag_handle
                      if current_tags contains tag
                        assign active = true
                      endif
                    endif
                  -%}
                  <li {{ block.shopify_attributes }}>
                    <a class="sm-pill" href="{{ pill_url | default: '#' }}" {% if active %}aria-current="page"{% endif %}>{{ b.label }}</a>
                  </li>
                {%- endfor -%}
              {%- elsif use_auto -%}
                {%- for tag in collection.all_tags -%}
                  {%- liquid
                    assign t_low = tag | downcase | strip
                    assign first_char = tag | slice: 0
                    if excluded contains t_low or first_char == '_'
                      continue
                    endif
                  -%}
                  <li>
                    <a class="sm-pill" href="{{ base_url }}/{{ tag | handle }}" {% if current_tags contains tag %}aria-current="page"{% endif %}>
                      {{- tag | replace: '-', ' ' | capitalize -}}
                    </a>
                  </li>
                {%- endfor -%}
              {%- else -%}
                {%- for raw_tag in filter_tags -%}
                  {%- assign tag = raw_tag | strip -%}
                  {%- if collection.all_tags contains tag -%}
                    <li>
                      <a class="sm-pill" href="{{ base_url }}/{{ tag | handle }}" {% if current_tags contains tag %}aria-current="page"{% endif %}>
                        {{- tag | replace: '-', ' ' | capitalize -}}
                      </a>
                    </li>
                  {%- endif -%}
                {%- endfor -%}
              {%- endif -%}
            </ul>
          </nav>
        {%- endif -%}
        <form method="get" style="display: flex; align-items: center; gap: 10px;">
          <span aria-live="polite" style="font-weight: 500;">
            {{ collection.products_count }}
            {{ collection.products_count | pluralize: section.settings.item_word, section.settings.items_word }}
          </span>
          <label for="sm-sort-{{ section.id }}" style="font-weight: 700;">Sort</label>
          <select id="sm-sort-{{ section.id }}" class="sm-select" name="sort_by" onchange="this.form.submit()">
            {%- for option in collection.sort_options -%}
              <option value="{{ option.value }}" {% if option.value == current_sort %}selected{% endif %}>
                {{- option.name -}}
              </option>
            {%- endfor -%}
          </select>
          <noscript><button type="submit" class="sm-btn">Sort</button></noscript>
        </form>
      </div>

      <div class="sm-grid sm-grid--cards" style="--sm-min: 240px; --sm-max: {{ section.settings.card_max }}px;">
        {%- for product in list -%}
          {% render 'sm-game-card', product: product, image_fit: section.settings.image_fit, bg: card_bg, more_label: section.settings.more_label, soon_label: section.settings.soon_label %}
        {%- else -%}
          <p style="grid-column: 1 / -1; padding: 40px; text-align: center; border: 3px dashed #000; border-radius: 26px;">
            {{ section.settings.empty_text }}
          </p>
        {%- endfor -%}
      </div>

      {%- if paginate.pages > 1 -%}
        <nav class="sm-pagination" aria-label="Pages">
          {%- if paginate.previous -%}<a href="{{ paginate.previous.url }}" aria-label="Previous page">←</a>{%- endif -%}
          {%- for part in paginate.parts -%}
            {%- if part.is_link -%}
              <a href="{{ part.url }}">{{ part.title }}</a>
            {%- else -%}
              <span {% if part.title == paginate.current_page %}class="is-current" aria-current="page"{% endif %}>{{ part.title }}</span>
            {%- endif -%}
          {%- endfor -%}
          {%- if paginate.next -%}<a href="{{ paginate.next.url }}" aria-label="Next page">→</a>{%- endif -%}
        </nav>
      {%- endif -%}
    </div>
  {%- endpaginate -%}
</section>

{% schema %}
{
  "name": "Smidgen · Collection",
  "tag": "div",
  "enabled_on": {
    "templates": [
      "collection"
    ]
  },
  "settings": [
    {
      "type": "text",
      "id": "intro",
      "label": "Intro (used if the collection has no description)",
      "default": "Every Smidgen game teaches in minutes and fits in a bag. Pick by who's playing tonight."
    },
    {
      "type": "checkbox",
      "id": "auto_tags",
      "label": "Make a pill for every tag",
      "info": "Used when no Filter pill blocks are added. Tags starting with _ are skipped.",
      "default": false
    },
    {
      "type": "text",
      "id": "exclude_tags",
      "label": "Tags to skip",
      "info": "Comma-separated",
      "visible_if": "{{ section.settings.auto_tags }}"
    },
    {
      "type": "text",
      "id": "filter_tags",
      "label": "Pill tags (used when no Filter pill blocks are added)",
      "info": "Comma-separated product tags, e.g. family, 2-player, quick-play, coming-soon. Only tags used in this collection appear.",
      "default": "family, 2-player, quick-play, coming-soon",
      "visible_if": "{{ section.settings.auto_tags == false }}"
    },
    {
      "type": "text",
      "id": "all_label",
      "label": "'All' pill text",
      "default": "All games",
      "info": "Leave empty to hide the All pill."
    },
    {
      "type": "url",
      "id": "all_link",
      "label": "'All' pill link",
      "info": "Defaults to this collection."
    },
    {
      "type": "text",
      "id": "item_word",
      "label": "Item word (one)",
      "default": "game",
      "info": "Used in the count, e.g. 1 game / 1 shirt"
    },
    {
      "type": "text",
      "id": "items_word",
      "label": "Item word (many)",
      "default": "games"
    },
    {
      "type": "text",
      "id": "empty_text",
      "label": "Empty message",
      "default": "Nothing here yet. Check back soon!"
    },
    {
      "type": "select",
      "id": "default_sort",
      "label": "Default sort",
      "info": "Used when the shopper hasn't picked a sort.",
      "options": [
        {
          "value": "title-ascending",
          "label": "Alphabetical, A–Z"
        },
        {
          "value": "title-descending",
          "label": "Alphabetical, Z–A"
        },
        {
          "value": "price-ascending",
          "label": "Price, low to high"
        },
        {
          "value": "price-descending",
          "label": "Price, high to low"
        },
        {
          "value": "collection",
          "label": "Collection's own order"
        }
      ],
      "default": "title-ascending"
    },
    {
      "type": "range",
      "id": "per_page",
      "label": "Items per page",
      "min": 8,
      "max": 48,
      "step": 4,
      "default": 24
    },
    {
      "type": "header",
      "content": "Cards"
    },
    {
      "type": "select",
      "id": "image_fit",
      "label": "Image",
      "options": [
        {
          "value": "fit",
          "label": "Fit (show the whole image)"
        },
        {
          "value": "fill",
          "label": "Fill (crop to fill the card)"
        }
      ],
      "default": "fit"
    },
    {
      "type": "select",
      "id": "card_bg_mode",
      "label": "Image background",
      "options": [
        {
          "value": "game",
          "label": "Each game's own color"
        },
        {
          "value": "custom",
          "label": "One color for all cards"
        }
      ],
      "default": "game"
    },
    {
      "type": "color",
      "id": "card_bg",
      "label": "Background color",
      "default": "#753189",
      "visible_if": "{{ section.settings.card_bg_mode == 'custom' }}"
    },
    {
      "type": "range",
      "id": "card_max",
      "label": "Max card width",
      "min": 240,
      "max": 440,
      "step": 20,
      "unit": "px",
      "default": 320
    },
    {
      "type": "text",
      "id": "more_label",
      "label": "Card link text",
      "default": "View game →"
    },
    {
      "type": "text",
      "id": "soon_label",
      "label": "Card link text (coming soon)",
      "default": "Get notified →"
    },
    {
      "type": "color",
      "id": "hero_bg",
      "label": "Header color",
      "default": "#FFF503"
    }
  ],
  "max_blocks": 20,
  "blocks": [
    {
      "type": "pill",
      "name": "Filter pill",
      "settings": [
        {
          "type": "text",
          "id": "label",
          "label": "Label",
          "placeholder": "Games"
        },
        {
          "type": "select",
          "id": "kind",
          "label": "Filters by",
          "options": [
            {
              "value": "tag",
              "label": "Product tag"
            },
            {
              "value": "collection",
              "label": "Another collection"
            },
            {
              "value": "link",
              "label": "Custom link"
            }
          ],
          "default": "tag"
        },
        {
          "type": "text",
          "id": "tag",
          "label": "Product tag",
          "placeholder": "game",
          "info": "Exactly as it's written on your products.",
          "visible_if": "{{ block.settings.kind == 'tag' }}"
        },
        {
          "type": "collection",
          "id": "collection",
          "label": "Collection",
          "visible_if": "{{ block.settings.kind == 'collection' }}"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link",
          "visible_if": "{{ block.settings.kind == 'link' }}"
        }
      ]
    }
  ]
}
{% endschema %}
