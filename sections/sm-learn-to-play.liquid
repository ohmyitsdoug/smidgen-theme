{%- comment -%}
  "Learn to play" for product pages. Reads product fields:
  - smidgen.howto_video (URL; YouTube links are embedded)
  - smidgen.howto_steps (list of `smidgen_step` entries: title, description)
  - smidgen.rules_pdf (file)
  Each part renders only when it has data. With no data at all, the section
  and its wave dividers are left out entirely.
{%- endcomment -%}
{%- liquid
  assign s = section.settings
  assign vf = s.video_field | default: 'smidgen.howto_video' | strip | split: '.'
  assign sf = s.steps_field | default: 'smidgen.howto_steps' | strip | split: '.'
  assign rf = s.rules_field | default: 'smidgen.rules_pdf' | strip | split: '.'
  assign video_val = product.metafields[vf[0]][vf[1]].value
  assign steps_mf = product.metafields[sf[0]][sf[1]]
  assign steps = steps_mf.value
  assign steps_single = false
  assign steps_total = steps.size | default: 0
  if steps_mf != blank and steps_mf.type contains 'list.' 
    assign steps_single = false
  elsif steps_mf != blank
    assign steps_single = true
    assign steps_total = 1
  endif
  assign rules = product.metafields[rf[0]][rf[1]].value

  if s.video_link != blank
    assign video_val = s.video_link
  endif
  if video_val == blank
    assign guesses = 'custom.how_to_play_youtube,custom.how_to_play_video,custom.how_to_play,custom.howto_video,custom.video,custom.video_url,custom.youtube' | split: ','
    for g in guesses
      assign gp = g | split: '.'
      assign try = product.metafields[gp[0]][gp[1]].value
      if try != blank
        assign video_val = try
        break
      endif
    endfor
  endif
  assign video_file = blank
  assign video_url = blank
  if video_val.media_type == 'video' or video_val.media_type == 'external_video'
    assign video_file = video_val
  elsif video_val != blank
    assign video_url = video_val
  endif
  assign rules_url = rules.url | default: rules

  assign step_count = 0
  if steps_single
    if steps.title.value != blank
      assign step_count = 1
    endif
  else
    for step in steps
      if step.title.value != blank
        assign step_count = step_count | plus: 1
      endif
    endfor
  endif

  assign yt_id = blank
  if video_url != blank
    assign v = video_url | append: ''
    if v contains 'youtu.be/'
      assign yt_id = v | split: 'youtu.be/' | last | split: '?' | first
    elsif v contains 'shorts/'
      assign yt_id = v | split: 'shorts/' | last | split: '?' | first
    elsif v contains 'v='
      assign yt_id = v | split: 'v=' | last | split: '&' | first
    endif
  endif

  assign has_any = false
  if video_url != blank or video_file != blank or step_count > 0 or rules_url != blank
    assign has_any = true
  endif
  assign num_colors = '#753189,#EA5D00,#20A4F3,#000000' | split: ','
-%}
{%- if has_any -%}
  {% render 'sm-divider', shape: s.divider_shape, from: s.outer_color, to: s.bg %}
  <section
    id="how-to-play"
    class="sm-section"
    style="--sm-bg: {{ s.bg }}; --sm-fg: {{ s.fg }};{% render 'sm-btn-vars', s: s %}"
    aria-labelledby="sm-{{ section.id }}-title"
  >
    {% render 'sm-corner-doodles', section: section %}
    {% render 'sm-doodle-blocks', section: section %}
    <div class="sm-container" style="--sm-pad-top: {{ s.pad_top }}px; --sm-pad-bottom: {{ s.pad_bottom }}px;">
      <h2 id="sm-{{ section.id }}-title" class="sm-display">{{ s.heading }}</h2>

      {%- if video_file != blank -%}
        <div class="sm-video">
          {%- if video_file.media_type == 'external_video' -%}
            {{ video_file | external_video_tag: loading: 'lazy' }}
          {%- else -%}
            {{ video_file | video_tag: controls: true, preload: 'metadata', playsinline: true }}
          {%- endif -%}
        </div>
      {%- elsif video_url != blank -%}
        <div class="sm-video">
          {%- if yt_id != blank -%}
            <iframe
              src="https://www.youtube-nocookie.com/embed/{{ yt_id }}?rel=0"
              title="How to play {{ product.title | escape }}"
              loading="lazy"
              allow="accelerometer; encrypted-media; gyroscope; picture-in-picture"
              allowfullscreen
            ></iframe>
          {%- else -%}
            <a
              class="sm-btn"
              href="{{ video_url }}"
              target="_blank"
              rel="noopener"
              style="position: absolute; inset: 0; margin: auto; width: fit-content; height: fit-content;"
            >
              Watch how to play
            </a>
          {%- endif -%}
        </div>
      {%- endif -%}

      {%- if step_count == 0 and steps_mf != blank and request.design_mode -%}
        <p style="margin: 0; padding: 16px; border: 3px dashed #000; border-radius: 16px; background: #fff;">
          <strong>Steps found but not showing</strong> (only you see this). {{ steps_total }} step(s) in {{ s.steps_field }} ({{ steps_mf.type }}), but no readable title.
          Check Settings → Custom data → Metaobjects → Smidgen Step: turn on <em>Storefronts</em> access, make sure each step entry is <em>Active</em>, and the title field's key is <code>title</code>.
        </p>
      {%- endif -%}
      {%- if step_count > 0 -%}
        <ol class="sm-steps sm-grid" style="--sm-min: 250px;">
          {%- assign n = 0 -%}
          {%- if steps_single -%}
            {%- if steps.title.value != blank -%}
              {% render 'sm-step-card', step: steps, n: 1, num_color: num_colors[0] %}
            {%- endif -%}
          {%- else -%}
            {%- for step in steps -%}
              {%- if step.title.value != blank -%}
                {%- assign color_index = n | modulo: 4 -%}
                {%- assign n = n | plus: 1 -%}
                {% render 'sm-step-card', step: step, n: n, num_color: num_colors[color_index] %}
              {%- endif -%}
            {%- endfor -%}
          {%- endif -%}
        </ol>
      {%- endif -%}

      {%- if rules_url != blank -%}
        <a class="sm-btn" href="{{ rules_url }}" target="_blank" rel="noopener" style="align-self: flex-start;">
          {{- s.rules_label -}}
        </a>
      {%- endif -%}
    </div>
  </section>
  {% render 'sm-divider', shape: s.divider_shape, from: s.bg, to: s.outer_color %}
{%- elsif request.design_mode -%}
  <div class="sm-container sm-container--narrow" style="--sm-pad-top: 24px; --sm-pad-bottom: 24px;">
    <p style="margin: 0; padding: 20px; border: 3px dashed #000; border-radius: 20px; font-family: var(--sm-font-body);">
      <strong>Learn to play is hidden on this product</strong> (only you can see this note).
      Add a how-to video, steps or a rules PDF to this product's fields
      ({{ s.video_field | default: 'smidgen.howto_video' }}, {{ s.steps_field | default: 'smidgen.howto_steps' }}, {{ s.rules_field | default: 'smidgen.rules_pdf' }}),
      or point this section at fields you already use in its settings.
    </p>
  </div>
{%- endif -%}

